{
  "name": "darcy-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4323",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run check:pin && npm run check:records && npm run check:lines-data && npm run check:directline && npm run check:era-ground && npm run atlas && astro build && npm run autolink && npm run sitemap && npm run check:book && npm run check:story && npm run check:living && npm run check:kin && npm run check:living:tree && npm run check:templates && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:sources && npm run check:pages && npm run check:inline && npm run check:rows && npm run check:archive && npm run check:nav && npm run check:prose && npm run check:names && npm run check:standard && npm run check:lines && npm run check:era && npm run check:era-expect && npm run check:era:selftest",
    "preview": "astro preview --port 4323",
    "autolink": "python3 ../tools/autolink_pass.py",
    "check:names": "python3 ../tools/autolink_pass.py --gate",
    "check:standard": "python3 ../tools/standard_pass.py",
    "check:records": "python3 ../tools/check_records.py",
    "check:lines-data": "python3 ../tools/build_lines.py --check",
    "check:lines": "python3 ../tools/build_lines.py --living-slugs && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --lines src/data/lines.json --dist dist --config standard.json --living \"$(python3 ../tools/build_lines.py --living-path)\" && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --selftest",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare --years --config standard.json --strict-allow",
    "check:living:tree": "python3 ../tools/check_living.py --dist dist",
    "check:story": "python3 ../tools/check_story.py",
    "check:directline": "python3 node_modules/@daviddef/archive-kit/kit/tools/directline.py --story src/data/story.json --check src/data/direct-line.json",
    "check:book": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkbook.py --dist dist --book src/data/book.json",
    "check:prose": "python3 ../tools/check_prose.py",
    "check:prose-strict": "python3 ../tools/check_prose.py --require-tree",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "check:sources": "python3 node_modules/@daviddef/archive-kit/kit/tools/checksources.py --root . --max-unreachable 0",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 4",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist dist --strict",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 6",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root .",
    "check:kin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkkin.py --data src/data/ancestors.json --born born --died died --max 0",
    "check:archive": "python3 ../tools/check_archive.py",
    "check:era-ground": "python3 ../tools/build_era.py --check",
    "check:era": "python3 ../tools/build_era.py --living-urls && python3 node_modules/@daviddef/archive-kit/kit/tools/checkera.py --dist dist --snapshot src/data/era-snapshot.json --living-urls \"$(python3 ../tools/build_era.py --living-path)\" --require-tracked",
    "check:era-expect": "python3 ../tools/check_era_expect.py --dist dist",
    "check:era:selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/era_selftest.py"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#d88b11e914e433d9d2c6bd750b8d8e707d1a0b65",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
