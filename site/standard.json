  "patterns": [
   {
    "id": "tna",
    "regex": "\\b(?:WO|IR|PROB|HO|ADM|RG|CP|E)\\s?\\d{1,3}\\b(?:/[\\w.-]+)*"
   },
   {
    "id": "gloucs",
    "regex": "\\b(?:D\\d{3,4}(?:/\\d+)+|DE/M/\\d+|LL/\\d{4}/\\d+)"
   },
   {
    "id": "trove",
    "regex": "\\bnla\\.news-(?:article|page)\\d+"
   },
   {
    "id": "qldreg",
    "flags": "i",
    "regex": "\\b(?:Qld|Queensland) (?:death|marriage|birth) reg(?:istration)?\\.? ?\\d{4}/[A-Z]/\\d+|\\b\\d{4}/[A-Z]/\\d{2,}\\b"
   },
   {
    "id": "dr-itm",
    "regex": "\\b(?:DR|ITM)\\s?\\d{5,}"
   },
   {
    "id": "naa",
    "regex": "\\bNAA\\s+[A-Z]\\d+"
   },
   {
    "id": "localref",
    "flags": "i",
    "regex": "\\b(?:reference|ref\\.?|entry)\\s+(?:[A-Z]{2,4}/)?\\d+(?:/\\d+)+|\\b[A-Z]{3}/\\d{3}/\\d{3}\\b|\\bentry (?:number )?\\d{2,5}\\b"
   },
   {
    "id": "named-source",
    "flags": "i",
    "regex": "\\b(?:FamilySearch|FreeREG|FreeBMD|FreeCEN|FindMyPast|Ancestry|MyHeritage|Internet Archive|archive\\.org|Trove|Discovery|Gloucestershire Archives|Staffordshire Name Indexes|England (?:Births )?(?:and|&) Baptisms|Index to Death Duty Registers|Bishop's Transcripts|parish register|Calendars? of Inquisitions)\\b"
   },
   {
    "id": "courier",
    "regex": "(?P<k>nla\\.news-page1599814)",
    "key": "{k}"
   },
   {
    "id": "inquest",
    "flags": "i",
    "regex": "\\b(?P<k>inquest|coronial|post-mortem certificate|sworn deposition)\\b",
    "key": "{k}"
   }
