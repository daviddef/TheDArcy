---
import { u } from "../lib/url.js";
import prov from "../data/provenance.json";
import { lifeOf } from "../lib/corrections.js";
import PersonTree from "@daviddef/archive-kit/components/PersonTree.astro";
import "@daviddef/archive-kit/styles/persontree.css";

/* The pedigree chart that opens every person page, built the same way as the
   sibling archives' — and now out of literally the same component, which is
   what "the same way" was always supposed to mean.

   The left border of each card says HOW THE RELATIONSHIP IS KNOWN, and nothing
   else. That is the whole design:

     solid accent   the link is written in a record this archive has read, and
                    the card names the record
     dotted         the link comes from the family tree and has not been tested
     dashed, struck the link comes from the family tree AND sits above one of
                    the two grafts this archive has rejected

   Direct-line membership is a different fact and is printed as text, not as a
   border, because conflating the two is how a pedigree starts lying. It is also
   why the line under the name is written out here rather than by the kit: a
   person can be an ancestor in the tree AND sit above a rejected graft, and
   saying only the first would make this card contradict every edge around it.
*/

const { person: p, life, parents = [], spouses = [], kids = [], sibs = [] } = Astro.props;

const me = prov[p.slug] || { rel: {}, graft: null, line: false };

const edge = (slug) => {
  const rec = me.rel && me.rel[slug];
  if (rec && rec.length) return { cls: "via-register", via: rec[0], recorded: true };
  const g = (prov[slug] || {}).graft || me.graft;
  if (g) return { cls: "via-tree gone", via: `tree · above the ${g} graft`, recorded: false };
  return { cls: "via-tree", via: "tree", recorded: false };
};

const node = (o, extra = {}) => {
  const e = edge(o.slug);
  const q = prov[o.slug] || {};
  const via = q.line && !q.graft ? `${e.via} · direct line` : e.via;
  return {
    ...e, ...extra,
    name: o.name,
    href: u(`/people/${o.slug}`),
    dates: lifeOf(o),
    cls: e.cls,
    via,
    mark: extra.mark === false ? undefined : via,
    title: `How this link is known: ${via}`,
  };
};

const P = parents.map((o) => node(o));
const S = spouses.map((o) => node(o));
const K = kids.map((o) => node(o));
const B = sibs.map((o) => node(o, { small: true, mark: false }));

const all = [...P, ...S, ...K, ...B];
const recorded = all.filter((n) => n.recorded).length;
const grafted = all.filter((n) => n.cls.includes("gone")).length;

/* This family reuses forenames without mercy. Where a row shows the same name
   twice, say so rather than letting a reader assume a duplicate — and never
   merge them, which is exactly how a records-matcher invents one person out of
   two. */
const dupes = (list) => {
  const c = {};
  for (const o of list) c[o.name] = (c[o.name] || 0) + 1;
  return Object.keys(c).filter((k) => c[k] > 1);
};
const dupKids = dupes(K), dupSibs = dupes(B);

const standing = me.graft
  ? { note: (me.line ? `generation ${p.gen || "—"} of the tree, ` : "") + `above the ${me.graft} graft` }
  : me.line
    ? { gen: `direct line${p.gen ? ` · generation ${p.gen}` : ""}${me.spine ? " · on the spine" : ""}` }
    : { note: "in the tree" };
---
<PersonTree
  self={{ name: p.name, dates: life || p.life || "dates unknown", ...standing }}
  parents={P}
  spouses={S}
  children={K}
  siblings={B}
  labels={{ siblings: (n) => (n === 1 ? "brother or sister" : "brothers and sisters") }}
  always={true}
  palette={{ tree: "var(--ink-3)", "name-font": "var(--sans)", "name-size": "14px",
             "name-colour": "var(--ink)", via: "var(--ink-3)" }}
>
  <Fragment slot="keys">
    <span class="key"><i class="sw"></i> written in a record this archive has read</span>
    <span class="key"><i class="sw tree"></i> from the family tree, untested</span>
    {grafted > 0 && <span class="key"><i class="sw gone"></i> above a graft this archive rejects</span>}
  </Fragment>
  <Fragment slot="notes">
    <p class="warn" style="margin-top:.6rem">
      {all.length === 0
        ? <>No relationship is published for this person. Either the tree records none, or everyone
          they connect to is alive and withheld from this build.</>
        : recorded === 0
          ? <><strong>None of the {all.length} {all.length === 1 ? "relationship" : "relationships"} shown
            here is written in a record this archive has read.</strong> Every one comes from the family
            tree. That is not a claim that they are wrong — it is a statement about what has been
            checked, and on this site the difference is the point.</>
          : <><strong>{recorded} of the {all.length} relationships shown here</strong>{" "}
            {recorded === 1 ? "is" : "are"} written in a record this archive has read; the
            other {all.length - recorded} come from the family tree and{" "}
            {all.length - recorded === 1 ? "has" : "have"} not been tested.</>}
      {" "}<a href={u("/method/")}>How claims are labelled →</a>
    </p>

    {grafted > 0 && (
      <p class="warn"><strong>{grafted} of these links sit above a graft.</strong> The archive has
      tested the join they hang from and rejected it — the D'Arcys of Hornby Castle are unevidenced,
      the Sneyds of Keele Hall disproved. The people are drawn because the tree carries them, and
      struck through because nothing attaches them to this family.
      {" "}<a href={u("/how-far-back/")}>Both grafts, in full →</a></p>
    )}

    {dupKids.length > 0 && (
      <p class="warn"><strong>More than one child here carries the same name</strong> — {dupKids.join(", ")}.
      A child who died was very often replaced by a later child given the same name, so this is
      usually not an error. <strong>It is also exactly how a records-matcher invents one person out
      of two</strong>, which is why they are kept apart here and you are told.</p>
    )}
    {dupSibs.length > 0 && (
      <p class="warn"><strong>More than one sibling here carries the same name</strong> — {dupSibs.join(", ")}.
      They are drawn separately. This archive does not merge records on a name.
      {" "}<a href={u("/name/")}>Why →</a></p>
    )}
  </Fragment>
</PersonTree>
