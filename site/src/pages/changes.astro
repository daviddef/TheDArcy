---
import Base from "../layouts/Base.astro";
import Changes from "@daviddef/archive-kit/components/Changes.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import { u } from "../lib/url.js";
import c from "../data/changes.json";
const passes = c.days.length;
const items = c.days.reduce((a, d) => a + d.did.length, 0);
---
<Base title={c.title} eyebrow={`${passes} passes · ${items} changes`} dek={c.dek}>
  <section class="blk">
    <p class="lede">{c.lead}</p>
  </section>

  <Changes u={u} days={c.days.map((d) => ({
    when: d.when,
    entries: [{
      title: d.title,
      found: d.found || "",
      did: "<ul>" + d.did.map((x) => `<li>${x}</li>`).join("") + "</ul>",
    }],
  }))} />

  <section class="blk" style="border-bottom:0">
    <p class="dek">{c.close} <a href={u("/searched/")}>What has been read →</a> ·
      <a href={u("/corrections/")}>What was taken back →</a></p>
  </section>
</Base>
