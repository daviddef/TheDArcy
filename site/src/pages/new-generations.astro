---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import d from "../data/new-generations.json";
const total = d.groups.reduce((n, g) => n + g.rows.length, 0);
---
<Base
  title="Not in the tree"
  eyebrow={`${total} documented people · ${d.built}`}
  dek="People this archive can prove and the family tree has never held — three new generations of them, found in a week.">

  <section class="blk">
    <p class="lede">{d.lede}</p>
  </section>

  {d.groups.map((g) => (
    <Blk label={g.line} title={`${g.rows.length} people`}>
      <Scroll>
        <table>
          <thead><tr><th>Who</th><th>On what record</th><th class="m">Standing</th></tr></thead>
          <tbody>
            {g.rows.map(([who, ev, chip, note]) => (
              <tr>
                <td><strong>{who}</strong>{note && <div class="small" style="color:var(--ink-2)">{note}</div>}</td>
                <td class="small">{ev}</td>
                <td><span class={`chip ${chip === "documented" ? "doc" : chip === "inferred" ? "inf" : "lore"}`}>{chip}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </Scroll>
    </Blk>
  ))}

  <section class="blk" style="border-bottom:0">
    <h2>Why they are not on The People</h2>
    <p class="lede">{d.why}</p>
    <Note>
      <strong>{d.next}</strong>
    </Note>
    <p class="small" style="margin-top:1.4rem">
      <a href={u("/register")}>The register →</a> ·
      <a href={u("/saniger-line")}>Six generations at Berkeley →</a> ·
      <a href={u("/jean-ward")}>South Leith →</a> ·
      <a href={u("/who")}>Every person named →</a></p>
  </section>
</Base>
