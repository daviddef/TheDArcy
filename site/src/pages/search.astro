---
/* The box is one component in @daviddef/archive-kit, shared by all seven
   archives. What stays here is what belongs to this archive: how it describes
   itself, and the things worth trying. */
import Base from "../layouts/Base.astro";
import Search from "@daviddef/archive-kit/components/Search.astro";
import { u } from "../lib/url.js";

const hints = [["Saniger", "the archive's oldest claim"], ["Chatham", "the parish the crossing starts in"], ["Hornby", "the claim, and where it stops being evidence"], ["Sneyd", "the disproved graft"], ["General Hewitt", "the voyage out, 1854"], ["inquest", "Miriam's sworn evidence, 1902"]];
---
<Base title="Search" eyebrow={"Everything this archive can point at, in one box"} dek="People, places, register entries, families and every page — searched together.">
  <section class="blk">
    <Search base={u("/")} hints={hints} placeholder="Saniger · Chatham · Parramatta · Hornby · Sneyd · 39th" />
    <p class="dek" style="margin-top:1.4rem">This searches <strong>what the archive says</strong>,
    not the registers themselves. A name that returns nothing here has not been read yet — which is
    itself worth knowing. <a href={u("/searched/")}>What has already been looked for &rarr;</a></p>
  </section>
</Base>
