---
/* One page per place, drawn by the kit.

   This file was 85 lines and four archives held the same 85 lines, byte for
   byte. What is left here is the only part that was ever this archive's:
   where the rows come from, and what the page is called. */
import Base from "../../layouts/Base.astro";
import PlacePage from "@daviddef/archive-kit/components/PlacePage.astro";
import { u } from "../../lib/url.js";
import atlas from "../../../public/atlas-data.json";

export function getStaticPaths() {
  return atlas.places
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const bits = [p.when, p.fix === "approx" ? "coordinate approximate" : null].filter(Boolean);
---
<Base title={p.name}
      eyebrow={bits.join(" · ")}
      dek={p.what || `Everything this archive can put in ${p.name}.`}>
  <PlacePage p={p} u={u} />
</Base>
