---
import Base from "../layouts/Base.astro";
import Errands from "@daviddef/archive-kit/components/Errands.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import { u } from "../lib/url.js";
import { mdp } from "@daviddef/archive-kit/lib/md.js";
import e from "../data/errands.json";

const n = (k) => e.rows.filter((r) => r.state === k).length;

/* 9 October 2026. The eyebrow was a hand-typed tally — "50 open · 8 answered
   and kept" — against 52 and 14 in the data under it. A count that is retyped
   is a claim that can go stale silently, which is the one thing this archive
   grades everything else to avoid. It is computed here instead, so that adding
   a row or answering one cannot leave the heading behind. */
const eyebrow = `${n("open")} open \u00b7 ${n("answered")} answered and kept`;

/* 21 September 2026. The queue moved to the kit. The STATE did not: this
   archive grades a request by where it has got to — answered, open — with a
   colour and a gloss each, which is a different question from Defranceski's
   (what would the answer buy) and Lerena's (has anybody replied yet). The
   component takes the grade, its colour and its wording as given.

   A state the data uses and `states` has no entry for would otherwise print a
   grey rule and no word at all, so it is counted and shown. */
const unlabelled = [...new Set(e.rows.map((r) => r.state).filter((k) => k && !e.states[k]))];

const groups = [{
  rows: e.rows.map((r) => ({
    n: r.n,
    what: r.what,
    who: `<strong>${r.where}</strong> · ${r.cost}`,
    /* `why` in the DATA is this archive's one-line statement of stakes —
       "THE CHEAPEST DECISIVE DOCUMENT ON THIS SITE", "THE QUESTION WAS
       ADDRESSED TO THE WRONG CENTURY" — and until 27 September it was written
       into 46 of the 66 rows and rendered on none of them. The kit's component
       has no slot of its own for it, so it leads the slot that exists. A line
       nobody can read is not published, whatever the repository says. */
    why: mdp([r.why ? `**${r.why}**` : "", r.settles].filter(Boolean).join("\n\n")),
    ref: r.file,
    stateLabel: e.states[r.state] ? e.states[r.state][0] : r.state,
    colour: e.states[r.state] ? e.states[r.state][1] : null,
    links: r.href ? [["Context", r.href]] : [],
  })),
}];
---
<Base title={e.title} eyebrow={eyebrow} dek={e.dek}>
  <section class="blk">
    <p class="lede">{e.lead}</p>
  </section>

  <section class="blk">
    <h2>The queue, in order of what would change most</h2>
    <div style="margin-top:1.1rem;display:flex;flex-wrap:wrap;gap:8px">
      {Object.entries(e.states).map(([k, [label, colour, gloss]]) => (
        <span class="chip" style={`border-color:${colour}`} title={gloss}>
          <strong style={`color:${colour}`}>{label}</strong> {n(k)}
        </span>
      ))}
    </div>
    <Note style="margin-top:1rem">{e.tallyNote}</Note>
    {unlabelled.length > 0 && (
      <p class="small">Filed under a state this page has no entry for: {unlabelled.join(", ")}.</p>
    )}
    <Errands groups={groups} u={u} />
  </section>

  <Blk label="Not a document, and worth more than all of them" title={e.ydna.what}>
    <p class="dek">{e.ydna.settles}</p>
    <Note>{e.ydna.note}
      <a href={u("/dna/")}>What the DNA already says →</a></Note>
  </Blk>

  <section class="blk" style="border-bottom:0">
    <Note>{e.close} <a href={u("/searched/")}>The search register →</a></Note>
  </section>
</Base>
