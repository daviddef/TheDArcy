---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import e from "../data/errands.json";
---
<Base title={e.title} eyebrow={e.eyebrow} dek={e.dek}>
  <section class="blk">
    <p class="lede">{e.lead}</p>
  </section>

  <section class="blk">
    <h2>The queue, in order of what would change most</h2>
    <div style="margin-top:1.3rem;display:flex;flex-direction:column;gap:1.3rem">
      {e.rows.map((r) => (
        <div style="border-left:2px solid var(--rule-strong);padding:2px 0 2px 16px">
          <div>
            <span class="mono small" style="color:var(--ink-3)">{String(r.n).padStart(2, "0")}</span>
            <strong style="margin-left:.5rem">{r.what}</strong>
            {r.why && <span class="chip doc" style="margin-left:.5rem">{r.why}</span>}
          </div>
          <p class="small" style="margin-top:.35rem;color:var(--ink-2)">
            <strong>{r.where}</strong> · {r.cost}</p>
          <p class="small" style="margin-top:.35rem">{r.settles} <a href={u(r.href)}>Context →</a></p>
          <p class="small mono" style="margin-top:.25rem;color:var(--ink-3)">{r.file}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="blk">
    <div class="lab">Not a document, and worth more than all of them</div>
    <h2 style="margin-top:.4rem">{e.ydna.what}</h2>
    <p class="dek">{e.ydna.settles}</p>
    <div class="note" style="margin-top:1.1rem">{e.ydna.note}
      <a href={u("/dna")}>What the DNA already says →</a></div>
  </section>

  <section class="blk" style="border-bottom:0">
    <div class="note">{e.close} <a href={u("/searched")}>The search register →</a></div>
  </section>
</Base>
