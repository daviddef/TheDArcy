---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { mdp } from "@daviddef/archive-kit/lib/md.js";
import d from "../data/spellings.json";

const total = d.rows.reduce((a, r) => a + Number(r[1]), 0);
const productive = d.rows.filter((r) => Number(r[1]) > 0).length;

/* Counted, never typed — the fault this page was correcting when it was written. */
const dd = d.dedupe.counted;
const ddEntries = dd.reduce((a, r) => a + r[1], 0);
const ddEvents = dd.reduce((a, r) => a + r[2], 0);
const ddBaptisms = ddEvents - d.dedupe.cross;
const ddRepeats = ddEntries - ddEvents;
const restEntries = total - ddEntries;
const restForms = d.rows.length - dd.length;

const parts = [
  ["oneHead", "one", "chip1", "doc"],
  ["gapHead", "gap", "chip2", "doc"],
  ["twoHead", "two", "chip3", "inf"],
  ["crossHead", "cross", "chip4", "doc"],
  ["notHead", "not", "chip5", "dis"],
];
---
<Base
  title="Every Spelling of One Name"
  eyebrow={`One record set, every spelling · ${d.found}`}
  dek={`${total} index entries under ${productive} spellings of one surname — and the rarest of them is the one this family used.`}>

  <section class="blk">
    <p class="lede" set:html={mdp(d.lede)}></p>
    <Note style="margin-top:1.2rem"><span set:html={mdp(d.set)} /></Note>
  </section>

  <Blk label="The measurement" title={`${d.rows.length} strings put to one index`}>
    <Scroll>
      <table style="margin-top:1.1rem">
        <thead><tr>{d.cols.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>{d.rows.map(([s, n, w, a, b]) => (
          <tr style={n === "0" ? "opacity:.55" : ""}>
            <td class="mono"><strong>{s}</strong></td>
            <td class="m">{n}</td>
            <td class="small">{w}</td>
            <td class="m small">{a}</td>
            <td class="m small">{b}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <p class="small" style="margin-top:1rem">{productive} spellings returned entries; {d.rows.length - productive} returned none.
    Every entry of every spelling was read. The column counts <strong>index entries</strong>, not children —
    see <em>{d.limitsHead}</em> below for how far the two diverge.</p>
  </Blk>

  <Blk label="Recounted" title={d.completedHead}>
    <p class="dek" set:html={mdp(d.completed)}></p>
    <Note style="margin-top:1.2rem"><strong>{d.excludeHead}.</strong>
      <span set:html={mdp(d.exclude)} /></Note>
  </Blk>

  <Blk label="What the table says" title="Five things, in order of how much they cost">
    <div style="margin-top:1rem;display:flex;flex-direction:column;gap:1.4rem">
      {parts.map(([h, b, c, cls]) => (
        <Note style="border-left-width:3px">
          <strong>{d[h]}.</strong> <span set:html={mdp(d[b])} />
          {" "}<span class={`chip ${cls}`}>{d[c]}</span>
        </Note>
      ))}
    </div>
  </Blk>

  <Blk label={`The second family · ${d.scarp.found}`} title={d.scarp.head}>
    <p class="lede" set:html={mdp(d.scarp.lede)}></p>
    <Scroll>
      <table style="margin-top:1.2rem">
        <thead><tr>{d.scarp.cols.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>{d.scarp.rows.map(([a, b, c, e]) => (
          <tr><td><strong>{a}</strong></td><td class="small">{b}</td>
            <td class="small">{c}</td><td class="mono small">{e}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <p style="margin-top:.8rem"><span class="chip doc">{d.scarp.chip}</span></p>
    <Note style="border-left-width:3px;margin-top:1.3rem"><strong>{d.scarp.whyHead}.</strong>
      <span set:html={mdp(d.scarp.why)} /></Note>
    <Note style="margin-top:1.2rem"><strong>{d.scarp.twoHead}.</strong>
      <span set:html={mdp(d.scarp.two)} />
      {" "}<span class="chip inf">{d.scarp.chipTwo}</span></Note>
    <Note style="margin-top:1.2rem"><strong>{d.scarp.joinHead}.</strong>
      <span set:html={mdp(d.scarp.join)} />
      {" "}<span class="chip lore">{d.scarp.chipJoin}</span></Note>
  </Blk>

  <Blk label="Limits" title={d.limitsHead}>
    <p class="dek" style="margin-top:1rem" set:html={mdp(d.limits)}></p>
    <Scroll>
      <table style="margin-top:1.2rem">
        <thead><tr><th>Spelling</th><th class="m">Index entries</th><th class="m">Baptisms</th><th class="m">Repeats</th></tr></thead>
        <tbody>{dd.map(([sp, e, b]) => (
          <tr><td class="mono"><strong>{sp}</strong></td><td class="m">{e}</td>
            <td class="m">{b}</td><td class="m small">{e - b}</td></tr>))}
          <tr><td><strong>Counted</strong></td><td class="m"><strong>{ddEntries}</strong></td>
            <td class="m"><strong>{ddEvents}</strong></td><td class="m small"><strong>{ddRepeats}</strong></td></tr>
        </tbody>
      </table>
    </Scroll>
    <p class="small" style="margin-top:1rem">{ddEntries} index entries are <strong>{ddBaptisms} baptisms</strong>
    — {ddRepeats} repeats within a spelling, and {d.dedupe.cross} more baptisms that appear under two spellings
    each: Morris son of Morris at Berkeley in 1677, and William son of William at Bristol in 1830.
    That is one entry in {Math.round(ddEntries / (ddEntries - ddBaptisms))}.
    The remaining <strong>{restEntries}</strong> entries across {restForms} smaller forms have not been
    counted this way.</p>
    <Note style="margin-top:1.3rem"><span set:html={mdp(d.dupWhy)} /></Note>
  </Blk>

  <Blk label="The better instrument" title={d.wildHead}>
    <p class="dek" style="margin-top:1rem" set:html={mdp(d.wild)}></p>
    <p style="margin-top:.8rem"><span class="chip doc">{d.chipWild}</span></p>
  </Blk>

  <Blk label="What this table is a table of" title={d.register.head}>
    <div class="dek" style="margin-top:1rem" set:html={mdp(d.register.body)}></div>
    <p style="margin-top:.8rem"><span class="chip dis">{d.register.chip}</span></p>
  </Blk>
</Base>
