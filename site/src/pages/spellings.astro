---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { mdp } from "@daviddef/archive-kit/lib/md.js";
import d from "../data/spellings.json";

const parts = [
  ["oneHead", "one", "chip1", "doc"],
  ["gapHead", "gap", "chip2", "doc"],
  ["twoHead", "two", "chip3", "inf"],
  ["crossHead", "cross", "chip4", "doc"],
  ["notHead", "not", "chip5", "dis"],
];
---
<Base
  title="Fifteen Spellings"
  eyebrow={`One record set, every spelling · ${d.found}`}
  dek="Three hundred and forty baptisms under twelve spellings of one surname — and the rarest of the twelve is the one this family used.">

  <section class="blk">
    <p class="lede" set:html={mdp(d.lede)}></p>
    <Note style="margin-top:1.2rem"><span set:html={mdp(d.set)} /></Note>
  </section>

  <Blk label="The measurement" title="Fifteen strings put to one index">
    <Scroll>
      <table style="margin-top:1.1rem">
        <thead><tr>{d.cols.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>{d.rows.map(([s, n, w, a, b]) => (
          <tr style={n === "0" ? "opacity:.55" : ""}>
            <td class="mono"><strong>{s}</strong></td>
            <td class="m">{n}</td>
            <td class="small">{w}</td>
            <td class="m small">{a}</td>
            <td class="m small">{b}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <p class="small" style="margin-top:1rem">Twelve spellings returned entries; three returned none.
    Every entry of every spelling was read.</p>
  </Blk>

  <Blk label="What the table says" title="Five things, in order of how much they cost">
    <div style="margin-top:1rem;display:flex;flex-direction:column;gap:1.4rem">
      {parts.map(([h, b, c, cls]) => (
        <Note style="border-left-width:3px">
          <strong>{d[h]}.</strong> <span set:html={mdp(d[b])} />
          {" "}<span class={`chip ${cls}`}>{d[c]}</span>
        </Note>
      ))}
    </div>
  </Blk>

  <Blk label={`The second family · ${d.scarp.found}`} title={d.scarp.head}>
    <p class="lede" set:html={mdp(d.scarp.lede)}></p>
    <Scroll>
      <table style="margin-top:1.2rem">
        <thead><tr>{d.scarp.cols.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>{d.scarp.rows.map(([a, b, c, e]) => (
          <tr><td><strong>{a}</strong></td><td class="small">{b}</td>
            <td class="small">{c}</td><td class="mono small">{e}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <p style="margin-top:.8rem"><span class="chip doc">{d.scarp.chip}</span></p>
    <Note style="border-left-width:3px;margin-top:1.3rem"><strong>{d.scarp.whyHead}.</strong>
      <span set:html={mdp(d.scarp.why)} /></Note>
    <Note style="margin-top:1.2rem"><strong>{d.scarp.twoHead}.</strong>
      <span set:html={mdp(d.scarp.two)} />
      {" "}<span class="chip inf">{d.scarp.chipTwo}</span></Note>
    <Note style="margin-top:1.2rem"><strong>{d.scarp.joinHead}.</strong>
      <span set:html={mdp(d.scarp.join)} />
      {" "}<span class="chip lore">{d.scarp.chipJoin}</span></Note>
  </Blk>

  <Blk label="Limits" title={d.limitsHead}>
    <p class="dek" style="margin-top:1rem" set:html={mdp(d.limits)}></p>
  </Blk>
</Base>
