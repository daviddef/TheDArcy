---
/* The 243 ancestors this archive numbers by ahnentafel, drawn. Person n's
   father is 2n and their mother 2n+1, so every link here is arithmetic — there
   is no name-matching anywhere in it. */
import Base from "../layouts/Base.astro";
import Bloodline from "@daviddef/archive-kit/components/Bloodline.astro";
import { graph, components, fromAhnentafel } from "@daviddef/archive-kit/lib/bloodline.js";
import "@daviddef/archive-kit/styles/bloodline.css";
import raw from "../data/ancestors.json";
import { publishableOrNamed, byId } from "../lib/people.js";
import { lifeOf } from "../lib/corrections.js";

const all = Array.isArray(raw) ? raw : Object.values(raw).find((v) => Array.isArray(v)) || [];
/* THE LIVING ARE IN THIS CHART BY NAME, since 16 October 2026. Until then this
   archive published none and the line stopped at the last person it could
   name; David ruled, knowing the tree judges 2,034 people living, that it
   adopts the standard the Defranceschi archive keeps. The chart draws a name
   and a relationship for a living ancestor, and the kit's component gives
   them no dates. `rows` is every ancestor in the file, and the data holds
   nothing for a living one beyond a name and a place (tools/build_site_data.py).
   living.json's `named` is the older consent record — six people named on
   purpose in prose — and is unchanged; it is no longer what lets a living
   person onto a chart. */
/* THE YEARS COME THROUGH THE CORRECTIONS, like every other chart on this site.
   This one is built from ancestors.json rows rather than from lib/people.js, so
   it did not inherit them, and drew the tree's 1838 for a man whose own page,
   correctly, says 1837. There is no test for who is living here, deliberately:
   lifeOf() returns its input for anyone without a correction, and a correction
   is only ever written for the dead, so a living row passes through unchanged
   and this page has no opinion of its own about what living means. */
const rows = publishableOrNamed(all).map((r) => {
  const slug = (byId.get(r.id) || {}).slug;
  return slug ? { ...r, life: lifeOf({ slug, life: r.life, born: r.born, died: r.died }) } : r;
});
const people = graph(fromAhnentafel(rows));
const comps = components(people);
const shape = (s) => {
  const p = people[s];
  return (p.parents.length ? 1000 : 0) + (p.children.length ? 1000 : 0) + p.parents.length + p.children.length;
};
const start = comps[0] ? [...comps[0]].sort((a, b) => shape(b) - shape(a))[0] : null;
---
<Base
  title="Blood relatives"
  eyebrow={`${Object.keys(people).length} ancestors, joined by the numbering itself`}
  dek="Choose a person and the chart is built around them. These links come out of the ahnentafel — the father of number n is number 2n — so not one of them rests on two people sharing a name.">
  <Bloodline people={people} start={start} total={rows.length} />
  <p class="cap" style="margin-top:14px">{rows.filter((r) => r.living).length} of these {rows.length} are living.
    A living person is named here and nothing more: no date, no record, no photograph. Their
    page, where there is one, gives their town and country.</p>
</Base>
