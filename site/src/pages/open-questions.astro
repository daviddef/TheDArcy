---
/* The open questions, generated.

   This page was 405 lines of hand-written prose until 15 September 2026, and
   it had gone a day stale without anything being able to notice it: no mention
   of Biddulph, the 1608 muster, Swonhungre, Porter, the Royal Military
   Calendar or Minorca, all of which the archive had worked on. It is now
   rendered from questions.json, and every question names what would settle it
   and which register holds the attempts. The old prose is in the git history. */
import Base from "../layouts/Base.astro";
import Questions from "@daviddef/archive-kit/components/Questions.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import { u } from "../lib/url.js";
import { md, mdp, plain } from "@daviddef/archive-kit/lib/md.js";
import q from "../data/questions.json";

const link = (h) => h.replace(/\[([^\]]+)\]\((\/[^)]*)\)/g,
  (_, t, href) => `<a href="${u(href)}">${t}</a>`);
const n = (k) => q.rows.filter((r) => r.state === k).length;
const S = (r) => q.states[r.state] || q.states.open;
const DAY = 864e5;
const age = (r) => r.since && r.state !== "answered"
  ? Math.floor((Date.parse("2026-09-15") - Date.parse(r.since)) / DAY) : 0;
---
<Base
  title={q.title}
  eyebrow={`${n("open")} open · ${n("blocked")} waiting on somebody · ${n("answered")} closed and kept`}
  dek={q.dek}>

  <section class="blk">
    <div class="prose" set:html={link(mdp(q.lead))}></div>
    <div style="margin-top:1.3rem;display:flex;flex-wrap:wrap;gap:8px">
      {Object.entries(q.states).map(([k, [label, colour, gloss]]) => (
        <span class="chip" style={`border-color:${colour}`} title={gloss}>
          <strong style={`color:${colour}`}>{label}</strong> {n(k)}
        </span>
      ))}
    </div>
  </section>

  <Questions u={u} rows={q.rows.map((r) => ({
    n: r.n,
    q: r.q,
    state: S(r)[0],
    rank: r.rank,
    settles: plain(r.settles),
    tried: r.tried.map(([what, outcome]) =>
      `<div style="margin-bottom:.55rem"><strong class="small">${md(what)}</strong>` +
      `<div class="small" style="color:var(--ink-2)">${md(outcome)}</div></div>`).join(""),
    since: age(r) > 30 ? `${r.since} — ${age(r)} days` : r.since,
    href: r.register + "/",
    hrefLabel: "attempts are in this register →",
    known: plain(r.note || ""),
  }))} />

  <section class="blk" style="border-bottom:0">
    <div class="prose" set:html={link(mdp(q.close))}></div>
    <p class="small" style="margin-top:1.6rem;color:var(--ink-3)">
      The other registers: <a href={u("/worklist/")}>what is being done</a> ·
      <a href={u("/searched/")}>what has been read</a> ·
      <a href={u("/coverage/")}>what the indexes hold</a> ·
      <a href={u("/errands/")}>what has to be asked for</a> ·
      <a href={u("/corrections/")}>what this archive got wrong</a>.
    </p>
  </section>
</Base>
