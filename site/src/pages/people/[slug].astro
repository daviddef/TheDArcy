---
import Base from "../../layouts/Base.astro";
import Note from "../../components/Note.astro";
import Scroll from "../../components/Scroll.astro";
import { u } from "../../lib/url.js";
import { nameIfPublishable, lifeLine, isLiving } from "../../lib/people.js";
import { people, byId, duplicateOf, kebab } from "../../lib/people.js";
import { lineOf } from "../../lib/familyLines.js";
import mentions from "../../data/mentions.json";
import prov from "../../data/provenance.json";
import Evidence from "@daviddef/archive-kit/components/Evidence.astro";
import AlsoIn from "@daviddef/archive-kit/components/AlsoIn.astro";
import { grade } from "../../lib/grade.js";
import PersonPage from "@daviddef/archive-kit/components/PersonPage.astro";
import PersonSection from "@daviddef/archive-kit/components/PersonSection.astro";
import "@daviddef/archive-kit/styles/persontree.css";
import "@daviddef/archive-kit/styles/personpage.css";
import PS from "@daviddef/archive-kit/data/public-sources.json";
import { isLiving as isLivingKit } from "@daviddef/archive-kit/lib/person.js";
import { CORRECTIONS, yearOf as correctedYear } from "../../lib/corrections.js";
import personRecords from "../../data/person-records.json";
import EraNote from "@daviddef/archive-kit/components/EraNote.astro";
/* STORY MODE (people pages v2, PERSON-PAGE-SPEC.md section 2a): a person whose family or notes give the page something to tell is told as a story, not drawn as a chart */
import FamilyLinkNotes from "../../components/FamilyLinkNotes.astro";
import PersonStory from "@daviddef/archive-kit/components/PersonStory.astro";
import PersonRootsViews from "@daviddef/archive-kit/components/PersonRootsViews.astro";
import { familyOf, famNode, storyOf, hasStory, chaptersOf, GRADE_SAY } from "@daviddef/archive-kit/lib/personstory.js";
import { TREE_BY } from "../../lib/storyTree.js";
import rootsLinks from "../../../public/roots-links.json";
/* "On our direct line · generation n": the kit's band, for the people of src/data/direct-line.json (made from the story) and nobody else */
import OursBand from "@daviddef/archive-kit/components/OursBand.astro";
import directLine from "../../data/direct-line.json";
import { oursOf } from "@daviddef/archive-kit/lib/directline.js";
import { eraFor } from "../../lib/eraYear.js";
import eraSnapshot from "../../data/era-snapshot.json";

export async function getStaticPaths() {
  const { people } = await import("../../lib/people.js");
  return people.map((p) => ({ params: { slug: p.slug }, props: { person: p } }));
}
const { person: p } = Astro.props;

/* A LIVING PERSON'S PAGE IS A NAME, A RELATIONSHIP, A TOWN AND A COUNTRY, AND
   NOTHING ELSE (David's ruling, 16 October 2026; see src/lib/people.js).
   The data behind it holds nothing more — tools/build_site_data.py builds them
   from those four things and no others — so this page cannot print what it was
   never given. What it still has to decide is what to SAY: «born», «died»,
   «buried», a grade of evidence, a list of sources and a note from the family
   would each be a claim about somebody who is alive, so none of them is drawn
   for them. The page is noindex, which takes it out of the sitemap and the
   search index; Base omits its structured data too. */
const alive = isLiving(p);

/* A DECLARED COPY: the same person entered twice in the family tree (data/same-person.json).
   Never a living person. The page keeps its address and says what it is; its canonical names
   the primary, which is what stops a search engine indexing both and what the kit's sitemap
   reads to leave it out. The primary is untouched. */
const dup = alive ? null : duplicateOf(p);
const dupHref = dup ? u(`/people/${dup.slug}/`) : "";
const dupCanonical = dup && Astro.site ? new URL(dupHref, Astro.site).href : undefined;
/* What stands beside a relative's name in a list. On a living person's page no
   relative carries a year (see PersonTree); a living relative carries their
   town and country wherever they appear. */
const shownLife = (o) => (alive && !isLiving(o) ? "" : lifeLine(o));

/* The whole record, not a three-field summary: the pedigree chart needs born
   and died separately so it can apply a correction to one without losing the
   other. */
const link = (id) => byId.get(id) || null;

// children, gathered off the spouse records
const kids = [];
for (const s of p.spouses || []) {
  for (const c of s.children || []) {
    const o = link(c);
    if (o && !kids.some((k) => k.slug === o.slug)) kids.push(o);
  }
}
/* Spouses as chart nodes. A spouse who is alive is absent from the build
   entirely, so there is nothing to draw and nothing to say. */
const wed = (p.spouses || [])
  .filter((s) => nameIfPublishable(s))
  .map((s) => ({ ...(link(s.id) || { name: s.name, slug: "", life: "" }), married: s.married, marriedPlace: s.marriedPlace }))
  .filter((o) => o.slug);

/* Others carrying exactly this name. They are different people, kept apart on
   purpose: this family reuses forenames relentlessly and merging on a name is
   how one man becomes two, or two become one. */
const sameName = alive ? [] : people.filter((o) => !isLiving(o) && o.name === p.name && o.slug !== p.slug);

const me = prov[p.slug] || { rel: {}, graft: null, line: false };
const recCount = Object.keys(me.rel || {}).length;
const g = alive ? null : grade(p.slug);

/* Parents and brothers and sisters come from the record itself (each carries the
   id of the page it has), so the link is the same from both ends: a parent
   named on this page names this person back. They used to be worked out by
   walking the other way, from whichever parents had a marriage listing this
   person as a child, which finds nobody for a person whose parents have no page. */
const parents = (p.parents || []).map((r) => link(r.id)).filter(Boolean);
const sibs = (p.siblings || []).map((r) => link(r.id)).filter(Boolean);

// Surname pages that exist. Everyone else goes to the families index.
const FAMILY_PAGE = { Sneyd: "/sneyd", Atkinson: "/atkinson", Murdoch: "/murdoch" };
/* The family page of the NAME this person carries, when the name has one: one of the thirteen
   (p.family), or a line (src/data/family-lines.json). A line is a name the direct line carries
   whose page lists only people the archive already names. */
const ln = lineOf(p);
const famHref = (f) => FAMILY_PAGE[f] || `/families/${kebab(f)}`;

/* Where a person is actually written about. Keyed by slug because slugs are
   deterministic; a name here that stops matching simply stops linking, which is
   the safe failure. */
/* Keyed by slug. hannah-saniger was in here TWICE until 20 September 2026 —
   two entries, four links and two, and in a JavaScript object literal the
   second silently wins. She is the direct line, and she had quietly lost her
   voyage on the General Hewitt and the page about the Sanigers she is not
   among. Nothing could see it: the map is hand-kept, the loss was legal
   JavaScript, and no build could tell an overwrite from an edit. check_links.py
   now refuses a duplicate key here. */
const APPEARS_IN = {
  "hannah-saniger": [["/drivers-fields", "Her household, 1841"], ["/general-hewitt", "Her voyage, 1854"], ["/sanigers", "The Sanigers she is not among"], ["/berkeley", "The claim that rests on her"], ["/hannah-baptism", "One vowel — her baptism"]],
  "samuel-charles-sneyd-1810": [["/sneyds", "His baptism at Hanley, and the weaver above him"], ["/sergeant-sneyd", "Soldier, constable, gaol governor"], ["/how-far-back", "The Keele graft, disproved"]],
  "robert-d-arcy": [["/chatham", "His burial, aged 76"], ["/hornby", "The Hornby claim"], ["/direct-line", "The spine"]],
  "jean-ward": [["/chatham", "Her burial, aged 66"], ["/the-women", "The women"], ["/hornby", "The Hornby claim"]],
  "frederick-robert-d-arcy": [["/chatham", "His baptism, 1811"], ["/australia", "The surveyor, and the half-brother"]],
  "miriam-wakefield": [["/general-hewitt", "The voyage out, 1854"], ["/drivers-fields", "Her household, 1841"], ["/the-women", "The women"], ["/inquest-1902", "Her sworn evidence, 1902"], ["/sneyd", "The Sneyds"]],
  "james-wakefield": [["/general-hewitt", "The voyage out, 1854"], ["/drivers-fields", "His household, 1841"], ["/berkeley", "The Saniger claim"]],
  "hiram-wakefield": [["/general-hewitt", "The voyage out, 1854"], ["/drivers-fields", "The household, 1841"]],
  "aaron-wakefield": [["/general-hewitt", "The voyage out, 1854"], ["/drivers-fields", "The household, 1841"]],
  "jabez-wakefield": [["/general-hewitt", "The voyage out, 1854"], ["/drivers-fields", "The household, and the street he was born in"]],
  "zillah-wakefield": [["/general-hewitt", "The voyage out, 1854"], ["/drivers-fields", "The household, 1841"]],
  "martha-wakefield": [["/drivers-fields", "The household, 1841"]],
  "eliza-wakefield": [["/drivers-fields", "The household, 1841"]],
  "ellen-wakefield": [["/drivers-fields", "The household, 1841"]],
  "kenneth-lindsay-d-arcy": [["/documents", "His eulogy, in full"], ["/brisbane", "Brisbane"], ["/direct-line", "The spine"]],
  "lindesay-atkinson-d-arcy": [["/great-war", "His war service"], ["/papers", "His obituary, 1936"], ["/brisbane", "Brisbane"]],
  "ivy-miriam-sneyd": [["/great-war", "Her husband and her brothers"], ["/sneyd", "The Sneyds"], ["/brisbane", "Brisbane"]],
  "arthur-hartley-sneyd": [["/finding-arthur", "The search for him, 1916–17"], ["/great-war", "His service record"], ["/sneyd", "The Sneyds"]],
  "vivian-claude-sneyd": [["/great-war", "His Military Medal and Bar"], ["/finding-arthur", "His brother"]],
  "vivian-ernest-william-sneyd": [["/great-war", "His service, in full"]],
  "thomas-george-sneyd": [["/great-war", "His son's service"]],
  "arthur-william-hartley-sneyd": [["/sneyd", "The Sneyds"], ["/great-war", "His sons"]],
  "william-hartley-sneyd": [["/inquest-1902", "The inquest into his death"], ["/sneyd", "The Sneyds"]],
  "george-pitt-d-arcy-1783": [["/australia", "Orthes, and the convict ship England"], ["/direct-line", "The spine"]],
  "george-pitt-d-arcy-1864": [["/brisbane", "Brisbane"], ["/papers", "What the papers said"]],
  "george-lindsay-d-arcy": [["/australia", "Born Parramatta, 1829"], ["/brisbane", "Brisbane"]],
  "paul-cole-atkinson": [["/atkinson", "The organ at All Saints', 1864"]],
  "ida-kathleen-atkinson": [["/atkinson", "The Atkinsons"], ["/brisbane", "Brisbane"]],
  "william-murdoch": [["/murdoch", "The Murdochs"]],
  "martha-blum": [["/sneyd", "Muttaburra, 1891"]],
};
const appears = alive ? [] : (APPEARS_IN[p.slug] || []);

/* Dates this archive has since checked against the Queensland civil register.
   A tree date that turns out to be right is a finding too, and saying which
   dates are backed by a registration number is the difference between an
   archive and a list. */
const VERIFIED = {
  "william-hartley-sneyd":      ["died", "1902/B/2776", "and it gives his date of birth as 30 September 1837"],
  "samuel-charles-sneyd-1810":  ["died", "1885/C/4045", "the gaol governor, 4 July 1885"],
  "miriam-wakefield":           ["died", "1909/C/1054", "naming her parents as James Wakefield and Hannah Saniger"],
  "thomas-george-sneyd":        ["died", "1927/B/2729", "naming his parents as William Hartley Sneyd and Miriam Wakefield"],
  "arthur-william-hartley-sneyd":["died", "1922/B/37152", "naming the same parents"],
  "vivian-claude-sneyd":        ["died", "1949/B/20695", "naming his parents as Arthur and Martha Blum"],
  "vivian-ernest-william-sneyd":["died", "1920/B/31382", "naming his parents as Thomas George Sneyd and Annie Spalding"],
  "kenneth-seigfried-sneyd":    ["died", "1935/B/26753", "naming his parents as Arthur William Hartley and Martha Blum"],
  "ernest-ephraim-sneyd":       ["died", "1946/B/8931", "naming his parents as William Hartley and Miriam Wakefield"],
  "martha-blum":                ["died", "1904/C/1454", "naming her parents as John Blum and Mary Ann O'Brien"],
  "joseph-samuel1-sneyd":       ["died", "1905/B/5838", "naming his parents as Samuel Sneyd and Catherine Mulcahy"],
  "gladys-beryl-sneyd":         ["died", "1897/C/1623", "naming her parents as Thomas George Sneyd and Annie Spalding"],
  "beryl-marie-sneyd":          ["died", "1905/C/3798", "naming her parents as Arthur Sneyd and Martha Blume"],
};
const verified = alive ? null : VERIFIED[p.slug];

/* One photograph, so far. */
const PORTRAITS = {
  "vivian-claude-sneyd": {
    src: "/img/vivian-claude-sneyd-1919.jpg", w: 620, h: 1159,
    alt: "Newspaper halftone portrait of a young man in a peaked military cap and tunic, head and shoulders, looking slightly to his left.",
    cap: "The Brisbane Courier, Saturday 18 January 1919, page 5, under \u201cOn Honour's Roll\u201d. Captioned in the paper: \u201cLance-corporal Vivian Sneyd, 3rd Field Ambulance, A.I.F., M.M. and Bar.\u201d",
    note: "As far as this archive knows, the only photograph of anyone in his generation of the family.",
  },
};
const portrait = alive ? null : PORTRAITS[p.slug];

/* The records this archive has read that name this person. They live in
   register.json as `record` rows keyed by NAME, and until 17 September 2026
   nothing carried them here: build_dossiers.py drops every record row whose
   name the tree also carries, on the assumption that the tree page shows it,
   and the tree page had never read them. See tools/build_person_records.py. */
const rec = alive ? null : (personRecords[p.slug] || null);

const corr = alive ? {} : (CORRECTIONS[p.slug] || {});
const val = (k, fallback) => (corr[k] ? corr[k][0] : fallback);

/* AN «AT THE TIME» NOTE beside a dated place (kit/docs/era-notes.md; David, 18 October 2026): who held that ground in that year, from the
   Record Atlas's REGION eras, as this archive committed them (src/data/era-snapshot.json, rebuilt deliberately by tools/build_era.py
   --snapshot; the place -> region table is data/era-ground.tsv). Context about the ground, never a claim about the family. Three places print
   a date and a place together: the Born row, the Died row and a marriage. NEVER on a living person's page (rule c, which is the PAGE's: a
   living person has no event here at all, and the guard is repeated below; the build gate check:era fails any note on a living or noindex
   page). The year is read off the date the page prints (lib/eraYear.js): «MAR 1600» and «27 OCT 1406» count, «AFT 1268», «BET 1799 AND 1801»,
   «ABT 1776» and the archive's own prose («1781 — baptised at Madeley») do not, and a date before 1752 gives a note only where the year either
   side of it lies in the same era (a British year then began in March). eraAt also gives none for a year within max(5, the Atlas's margin) years of
   an era's start or end, for an era contested about its regime, for one the Atlas labels as shorthand, or for a place no region covers. */
const noNotes = alive;
const eraOn = (place, date) => (noNotes || !place || !date) ? null : eraFor(eraSnapshot, place, date);
const bornPlace = val("bornPlace", p.bornPlace), diedPlace = val("diedPlace", p.diedPlace);
const facts = [
  ["Born", val("born", p.born), bornPlace, eraOn(bornPlace, val("born", p.born))],
  ["Died", val("died", p.died), diedPlace, eraOn(diedPlace, val("died", p.died))],
  ["Cause", p.cause, ""],
  ["Buried", "", val("burial", p.burial)],
  ["Trade", val("occupation", p.occupation), ""],
].filter(([, a, b]) => a || b);
const corrections = Object.entries(corr);

/* The eyebrow shows a lifespan; if a date has been corrected the eyebrow has to
   move with it, or the top of the page contradicts the table below it. */
const yr = (v) => (String(v || "").match(/\d{4}/) || [""])[0];
const bY = yr(val("born", p.born)), dY = yr(val("died", p.died));
const life = alive ? "living" : (bY || dY) ? `${bY || "?"}–${dY || ""}`.replace(/–$/, "") : (p.life || "dates unknown");

/* Notes come out of MyHeritage as broken HTML. Not merely tagged — *truncated*:
   opening tags are cut off mid-attribute, leaving orphaned CSS tails with no "<"
   to match, and whole words are missing from the prose itself. Clean what can be
   cleaned, drop the debris, and tell the reader when the source is damaged
   rather than passing off a mangled sentence as the family's words. */
const ENT = { "&nbsp;": " ", "&amp;": "&", "&lt;": "<", "&gt;": ">", "&quot;": '"', "&#39;": "'", "&apos;": "'" };
function clean(s) {
  let t = String(s)
    .replace(/<\s*(br|\/p|\/div|\/li|\/tr|\/h\d)\s*[^>]*>/gi, "\n")
    .replace(/<[^>]*>/g, " ")
    // orphaned attribute tails: junk ending in "> with no opening bracket
    .replace(/[^\s<>][^<>]{0,400}?"\s*>/g, " ")
    // bare CSS declarations left behind by the truncation
    .replace(/(?:[a-z-]+\s*:\s*[^;\n]{1,80};\s*)+/gi, " ")
    .replace(/&nbsp;?/gi, " ")
    .replace(/&[a-z#0-9]+;/gi, (m) => ENT[m.toLowerCase()] ?? " ")
    // MyHeritage notes use "** " as a bullet and "**x**" as emphasis. Neither
    // is rendered here, so both would reach a reader as literal asterisks —
    // the fault the shared kit documents in three other archives in this
    // estate. Strip the markers; this is quoted testimony, not markup.
    .replace(/\*\*\s*(.+?)\s*\*\*/gs, "$1")
    .replace(/^\s*\*\*\s*/gm, "");
  const lines = t.split("\n").map((l) => l.replace(/[ \t]{2,}/g, " ").trim()).filter((l) => {
    if (l.length < 12) return false;                       // stray fragments
    if (/SmartCopy|myheritage\.com\/research\/record/i.test(l)) return false; // citation boilerplate
    if (/^-{3,}$/.test(l)) return false;
    if (!/\s/.test(l)) return false;                       // a lone URL crumb
    return true;
  });
  return lines.join("\n").replace(/\n{3,}/g, "\n\n").trim();
}
const isDamaged = (s) => /box-sizing|font-family\s*:|style="/i.test(String(s));

/* What to say under the name, in order of what is actually known.

   These fields were typed by hand into a family tree over decades, so they
   arrive with doubled spaces, a leading "of", a trailing comma and the odd
   "(about)". Rendering them raw produced "Of of Aller, Som., Eng..", which is
   the sort of thing a reader notices and an archive should not ship. */
const tidy = (v) =>
  String(v || "")
    .replace(/\s+/g, " ")
    .replace(/^\s*of[,]?\s+/i, "")
    .replace(/[.,;\s]+$/, "")
    .trim();
const _placeRaw = String(val("bornPlace", p.bornPlace) || "");
/* "(about)" in a birthplace marks the place as uncertain, not approximate in
   the way a date is — "Of about Limerick City" is not English. */
const _vague = /^\s*\(about\)/i.test(_placeRaw);
const _place = tidy(_placeRaw.replace(/^\s*\(about\)\s*/i, ""));
const _spouse = (p.spouses || []).find((s) => nameIfPublishable(s));
const dek = alive
  ? "A living person (80 or younger, with no death recorded) is named with their relationships and their town and country, and nothing more."
  : tidy(val("occupation", p.occupation)) ||
  (_place ? `${_vague ? "Probably of" : "Of"} ${_place}.` : "") ||
  (_spouse ? `Married ${tidy(_spouse.name)}.` : "") ||
  "On the family tree, with no occupation, birthplace or marriage recorded here.";

const notes = alive ? [] : (p.notes || [])
  .map((n) => ({ text: clean(n), damaged: isDamaged(n) }))
  .filter((n) => n.text.length > 20);
const anyDamaged = notes.some((n) => n.damaged);

/* THE STORY. The family is the kit's familyOf over lib/storyTree.js (the people this page draws, the living by name and relationship only, through the kit's
   own living rule); the chapters are this person's own notes from the family tree, cleaned as they always were and moved, never reworded (chaptersOf cuts at a
   bold lead, and clean() has taken those out of a MyHeritage note, so each note is one chapter, graded «Family tree»). A page with nothing to tell (no parent,
   brother, sister, child or note) stays a chart. A declared copy of another person stays a chart and says so. A living person's page is never a story. */
const RULE = { now: new Date().getFullYear(), sources: PS, heldIds: [] };
const FAM = alive || dup ? null : familyOf(TREE_BY, p.id, RULE);
/* familyOf finds brothers and sisters through a shared parent; the record also lists them by id (p.siblings), and one person (the tree's first Joseph Samuel Sneyd) has
   eight of them and no parent recorded. The chart drew them, so the story does: a listed sibling the kit did not find is added, through the kit's own famNode (the
   living rule, held-out and all). */
if (FAM) {
  const have = new Set(FAM.siblings.map((n) => n.id));
  for (const r of p.siblings || []) if (TREE_BY[r.id] && r.id !== p.id && !have.has(r.id)) { const n = famNode(TREE_BY, r.id, "Brother or sister", "", RULE); if (n) { FAM.siblings.push(n); have.add(r.id); } }
}
/* the mark on each relative's card is what the link rests on (the chart's own: «read» in a record this archive has read, else the family tree), and a link
   above one of the two rejected grafts says so in its label, where the chart struck it through */
if (FAM) {
  const mark = (n) => {
    if (!n || n.unknown || !n.id || n.living) return;
    const o = byId.get(n.id); if (!o) return;
    const rec = me.rel && me.rel[o.slug], q = prov[o.slug] || {}, gr = q.graft || me.graft;
    const read = !!(rec && rec.length);
    n.link = { grade: read ? "doc" : "tree" };
    if (!read && gr) n.rel = `${n.rel} · above a graft`;
  };
  for (const list of [FAM.parents, FAM.grand, FAM.siblings, FAM.children, FAM.spouses]) list.forEach(mark);
}
const CHAPTERS = alive || dup ? [] : notes.flatMap((n) => chaptersOf(n.text).map((c) => ({ ...c, grade: c.grade || "tree" })));
const STORY = FAM ? storyOf(CHAPTERS, FAM, [], { b: bY, d: dY }, [], { metaRx: /(?!)/ }) : [];
/* The kit's story has a stop for a person's birth family, brothers and sisters, children and notes, and none for a wife or husband; the page's rule is that every relative
   in the record is a link (tools/check_living_standard.py, named-page), so the marriage is a stop here, in the order of a life: after the life and before the death. */
if (FAM && FAM.spouses.some((n) => !n.unknown)) {
  const stop = { key: "marriage", label: "Married", when: "", people: FAM.spouses.filter((n) => !n.unknown), cards: [] };
  const at = STORY.findIndex((st) => ["death", "legacy", "about"].includes(st.key));
  STORY.splice(at < 0 ? STORY.length : at, 0, stop);
}
const STORYMODE = !alive && !dup && hasStory(STORY);
const rootsId = String(p.id).replace(/@/g, "");
const inRoots = STORYMODE && (rootsLinks.people || []).includes(rootsId);
const esc = (x) => String(x).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const mdPlain = (x) => String(x).split(/\n+/).filter((l) => l.trim()).map((l) => `<p>${esc(l)}</p>`).join("");
/* THE PAGE IS THE KIT'S PersonPage (4 November 2026, people pages v2): the header, the family chart, "What the record says", "Where this comes from",
   "Others of the same name", "Photographs and papers" and "Notes and corrections" are the estate's one set of sections, in the estate's order and with the
   estate's anchors; what this archive adds goes in the slots, or after them as a titled "more" section. The archive decides who is living (people.js,
   from tools/build_site_data.py); the kit's rule is asked as well, and a page is a living person's if EITHER says so. */

/* THE CHART'S DATES. The tree writes «27 OCT 1406», «MAR 1600», «ABT 1776», «AFT 1268», «BET 1799 AND 1801»; the chart draws a day or a year, and «c.» for an
   estimate. A month with no day is kept to the year; a phrase is not a date the chart can draw (the record table says it in words) but the year it holds
   still goes to the living rule. Where research has overturned the tree (lib/corrections.js) the chart draws the archive's year, as it always did. */
const MONS = { JAN: "Jan", FEB: "Feb", MAR: "Mar", APR: "Apr", MAY: "May", JUN: "Jun", JUL: "Jul", AUG: "Aug", SEP: "Sep", OCT: "Oct", NOV: "Nov", DEC: "Dec" };
const monthName = (m) => ({ JAN: "January", FEB: "February", MAR: "March", APR: "April", MAY: "May", JUN: "June", JUL: "July", AUG: "August", SEP: "September", OCT: "October", NOV: "November", DEC: "December" })[m] || m;
const gedYear = (v) => { const m = /\b(1[0-9]\d\d|20\d\d|[5-9]\d\d)\b/.exec(String(v ?? "")); return m ? Number(m[1]) : null; };
const canonDate = (v) => {
  if (v == null || v === "") return undefined;
  const t = String(v).trim().replace(/\s+/g, " ");
  let m;
  if (typeof v === "number" || /^\d{4}$/.test(t)) return String(v);
  if ((m = /^(?:(ABT|EST|CAL)\.? )?(?:(\d{1,2}) )?(?:([A-Za-z]{3,9}) )?(\d{4})$/i.exec(t))) {
    const [, c, d, mon, y] = m, mm = mon && MONS[mon.slice(0, 3).toUpperCase()];
    if (mon && !mm) return undefined;
    return (c ? "c. " : "") + (d && mm ? `${+d} ${mm} ` : "") + y;
  }
  return undefined;
};
const saidDate = (v) => {
  if (v == null || v === "") return v;
  const t = String(v).trim();
  const nice = (x) => x.replace(/\b(\d{1,2}) ([A-Z]{3}) (\d{4})\b/g, (_, d, mo, y) => `${+d} ${monthName(mo)} ${y}`).replace(/\b([A-Z]{3}) (\d{4})\b/g, (_, mo, y) => `${monthName(mo)} ${y}`);
  let m;
  if ((m = /^(BEF|AFT|TO|FROM|ABT|EST|CAL)\.? (.+)$/.exec(t))) return ({ BEF: "before", AFT: "after", TO: "to", FROM: "from", ABT: "about", EST: "about", CAL: "about" })[m[1]] + " " + nice(m[2]);
  if ((m = /^BET (.+) AND (.+)$/.exec(t))) return `between ${nice(m[1])} and ${nice(m[2])}`;
  return nice(t);
};
/* a person's chart date for one field: the archive's corrected year where it has one, else the tree's date read as above */
const chartDate = (o, field) => {
  const c = CORRECTIONS[o.slug] && CORRECTIONS[o.slug][field];
  if (c) { const y = correctedYear(o.slug, field, o[field]); return y ? (/^(about|by|probably)\b/i.test(c[0]) ? "c. " : "") + y : undefined; }
  return canonDate(o[field]);
};
const yearOfRaw = (o, field) => { const c = CORRECTIONS[o.slug] && CORRECTIONS[o.slug][field]; return gedYear(c ? c[0] : o[field]) ?? undefined; };
const diedRecorded = (o) => !!(CORRECTIONS[o.slug]?.died || o.died || o.diedPlace || o.burial) || undefined;
const KLIVE = !alive && isLivingKit({ id: p.id, born: chartDate(p, "born"), died: chartDate(p, "died"), birthYear: yearOfRaw(p, "born"), deathRecorded: diedRecorded(p), citations: [] }, { now: new Date().getFullYear(), sources: PS });
if (KLIVE) throw new Error(`people/${p.slug}: the kit's living rule says this person is living but people.js does not; decide it in tools/build_site_data.py, not here`);

/* THE CHART'S ROWS. This archive marks the LINK: «read» is a record this archive has read (provenance.json), «tree» the family tree, untested; a link
   that sits above one of the two rejected grafts is drawn struck through (the kit's «superseded»), and the notes under the chart say why. The direct
   line is the kit's tint and bar. */
const relRow = (o, extra = {}) => {
  const rec = me.rel && me.rel[o.slug];
  const q = prov[o.slug] || {};
  const g = q.graft || me.graft;
  const read = !!(rec && rec.length);
  return {
    id: o.id, slug: o.slug, name: o.name, href: u(`/people/${o.slug}`),
    ...(isLiving(o) ? { saidLiving: true } : { born: chartDate(o, "born"), died: chartDate(o, "died"), birthYear: yearOfRaw(o, "born"), deathRecorded: diedRecorded(o) }),
    source: isLiving(o) ? "" : read ? "read" : "tree",
    superseded: !isLiving(o) && !read && g ? true : undefined,
    line: !isLiving(o) && q.line && !q.graft ? true : undefined,
    ...extra };
};
const RELATIONS = {
  parents: parents.map((o) => relRow(o)),
  spouses: wed.map((o) => relRow(o, { mar: "married" })),
  children: kids.map((o) => relRow(o)),
  siblings: sibs.map((o) => relRow(o)),
};
const KPERSON = alive
  ? { id: p.id, slug: p.slug, name: p.name, saidLiving: true, place: p.place || "", relations: RELATIONS }
  : { id: p.id, slug: p.slug, name: p.name, born: chartDate(p, "born"), died: chartDate(p, "died"), birthYear: yearOfRaw(p, "born"), deathRecorded: diedRecorded(p),
      buried: val("burial", p.burial) || undefined, deathPlace: diedPlace || undefined, relations: RELATIONS, citations: [] };

/* what the notes under the chart say, from this person's own relatives (kept from the archive's old PersonTree) */
const allRel = [...RELATIONS.parents, ...RELATIONS.spouses, ...RELATIONS.children, ...RELATIONS.siblings];
const recorded = allRel.filter((n) => n.source === "read").length;
const grafted = allRel.filter((n) => n.superseded).length;
const dupes = (list) => { const c = {}; for (const o of list) c[o.name] = (c[o.name] || 0) + 1; return Object.keys(c).filter((k) => c[k] > 1); };
const dupKids = dupes(RELATIONS.children), dupSibs = dupes(RELATIONS.siblings);

---
{/* THE LIVING GET THE KIT'S PAGE: a name, a relationship, a town and a country, and nothing else (the slots are not rendered at all). */}
{alive ? (
<Base title={p.name} ownHeader dek={dek} livingPage={alive}>
  <PersonPage person={KPERSON} peopleHref={u("/people/")} plainFamilyOfLiving directLine={directLine} storyHref={u("/story/")} />
</Base>
) : (
<Base title={p.name} ownHeader dek={dek} livingPage={alive} canonical={dupCanonical}>

  {dup && (
  <section class="blk" style="padding-top:0" data-same-person={dup.slug}>
    <Note style="border-left-width:3px">
      <strong>This page and <a href={dupHref}>{dup.name}</a> are the same person.</strong>
      {" "}The family tree this archive was built from holds {p.name} twice, and this is the second entry.
      It keeps its address because an address that has been published may have been linked or written
      down, but <a href={dupHref}>the other page</a> is the one to read and the one a search engine is
      told about. Anything only this entry knows is still printed below.
    </Note>
  </section>
  )}

  <PersonPage person={KPERSON} lede={dek} peopleHref={u("/people/")} registerHref={u(`/register/?q=${encodeURIComponent(p.name)}`)}
              directLine={directLine} storyHref={u("/story/")} stubNote="the family tree">

    {STORYMODE && <Fragment slot="story"><PersonStory stages={STORY} md={mdPlain} gradeSay={GRADE_SAY} u={u} /></Fragment>}
    {inRoots && <Fragment slot="where"><PersonRootsViews pid={rootsId} u={u} /></Fragment>}

    {/* THE CHART'S OWN NOTES: what the marks mean here, the two rejected grafts, and the same name twice in one row */}
    <Fragment slot="chart-notes">
      <FamilyLinkNotes {allRel} {recorded} {grafted} {dupKids} {dupSibs} {u} />
    </Fragment>

    {/* WHAT THE RECORD SAYS */}
    <Fragment slot="record">
      <p class="small" style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap">
        <Evidence level={g.level}>{g.label ?? undefined}</Evidence>
        <span class="dim">{g.why}{" "}
          {g.href
            ? <a href={u(g.href)}>What was tested &rarr;</a>
            : <a href={u("/method/#ladder")}>How this archive grades a claim &rarr;</a>}</span>
      </p>
      {/* «Also documented in the Falco archive»: one person held by two archives is two pages by design, and they can disagree about what is known.
          The kit draws this ONLY for a pair marked CONFIRMED in kit/data/cross-archive.json, and this sits inside the not-living branch. */}
      <AlsoIn archive="darcy" path={`/people/${p.slug}/`} />
      <Scroll>
        <table>
          <tbody>
            {facts.map(([k, a, b, e]) => (
              <tr>
                <td style="white-space:nowrap">{k}</td>
                <td class="m">{CORRECTIONS[p.slug]?.[k.toLowerCase()] ? a : (saidDate(a) || "—")}</td>
                <td>{b || ""}{e ? <EraNote era={e} /> : null}</td>
              </tr>
            ))}
            {wed.map((o) => {
              const s = (p.spouses || []).find((x) => x.id === o.id) || {};
              return (s.married || s.marriedPlace || s.divorced) && !o.living ? (
                <tr>
                  <td style="white-space:nowrap">Married</td>
                  <td class="m">{saidDate(s.married) || "—"}</td>
                  <td>{o.name}{s.marriedPlace ? `, ${s.marriedPlace}` : ""}{s.married && s.marriedPlace ? <EraNote era={eraOn(s.marriedPlace, s.married)} /> : null}{s.divorced ? ` · divorced ${s.divorced}` : ""}</td>
                </tr>) : null;
            })}
          </tbody>
        </table>
      </Scroll>
      {verified && (
        <p class="small" style="margin-top:.9rem"><span class="chip doc">registered</span>{" "}
          The <strong>{verified[0]}</strong> date above is confirmed by the Queensland civil
          register — registration <span class="mono">{verified[1]}</span>, {verified[2]}.
          <a href={u("/sources/")}> Sources →</a></p>
      )}
      {corrections.length > 0 && (
        <Note tight>
          <strong>Corrected against the family tree.</strong> The rows above carry this archive's
          finding. What the exported tree says is printed here, because hiding it would conceal the
          one thing this site is for.
          <ul class="small" style="margin:.6rem 0 0;padding-left:1.1rem">
            {corrections.map(([k, [now, why, href]]) => (
              <li style="margin-top:.35rem"><strong>{k}</strong>: {now} — {why}.{" "}
                <a href={u(href)}>Set out in full →</a></li>
            ))}
          </ul>
        </Note>
      )}
      {p.ancestor && (
        <p style="margin-top:1rem"><span class="chip doc">direct line</span>
        {p.gen && <span class="small"> · generation {p.gen} counting back from the present day</span>}</p>
      )}
      {p.family && (
        <p class="small" style="margin-top:.8rem">Counted here with the
          <strong> {p.family}</strong> family ·
          <a href={u(famHref(p.family))}> that family →</a></p>
      )}
      {!p.family && ln && (
        <p class="small" style="margin-top:.8rem">Of the
          <strong> {ln.surname}</strong> name ·
          <a href={u(`/families/${ln.slug}`)}> that family →</a></p>
      )}
    </Fragment>

    {/* WHERE THIS COMES FROM */}
    <Fragment slot="sources">
      {me.graft
        ? <p class="small"><span class="chip sup">above a graft</span> This person reaches the
          family only through the <strong>{me.graft}</strong> join, which this archive has tested
          and rejected. They are published because the tree carries them and deleting a claim is
          not the same as testing it. <a href={u("/how-far-back/")}>The graft →</a></p>
        : recCount > 0
          ? <p class="small"><strong>{recCount}</strong> of the relationships drawn above{" "}
            {recCount === 1 ? "is" : "are"} written in a record this archive has read.{" "}
            {[...new Set(Object.values(me.rel || {}).map((v) => v[0]))].join("; ")}.</p>
          : <p class="small">No relationship on this page has been checked against a record —
            the parents, marriages and children drawn above are what the family tree says.
            {rec
              ? <> But <strong>{rec.rows.length} record{rec.rows.length === 1 ? "" : "s"}</strong>{" "}
                naming {p.name}{" "}{rec.rows.length === 1 ? "has" : "have"} been read, and{" "}
                {rec.rows.length === 1 ? "it is" : "they are"} set out below.</>
              : <> Nothing else has been found for them either way.</>}
            {" "}<a href={u("/method/")}>How claims are labelled →</a></p>}

      {p.relative && (
      <p class="small" style="margin-top:.7rem">This person has a page because the tree names them beside
        someone this archive follows. Nothing has been researched for them here, and records that
        carry their name are filed in the register under the name and not assigned to them: a
        name is not a person.</p>
      )}
      <p class="small" style="margin-top:.7rem">
        <a href={u(`/register/?q=${encodeURIComponent(p.name)}`)}>Every entry naming {p.name} in the register →</a></p>
      {p.ancestor && (
        <p class="small" style="margin-top:.5rem">
          <a href={u("/direct-line/")}>See this generation on the spine →</a></p>
      )}
      {(p.sources || []).length > 0 && (
        <>
          <h3 style="margin-top:1.2rem">Sources attached in the tree</h3>
          <ul class="dek">
            {p.sources.map((s) => <li>{s}</li>)}
          </ul>
          <p class="small">These are the citations the family tree carries. Where this archive has
          checked one against the original, it says so on the relevant page.
          <a href={u("/method/")}> Method →</a></p>
        </>
      )}
    </Fragment>

    {sameName.length > 0 && (
      <Fragment slot="namesakes">
        <p class="small">This family reuses forenames relentlessly. <strong>These are different
        people, kept apart on purpose rather than merged into one.</strong>
        <a href={u("/name/")}> Why →</a></p>
        <ul style="margin:.6rem 0 0">
          {sameName.map((o) => (
            <li class="small" style="margin-top:.3rem">
              <a href={u(`/people/${o.slug}`)}>{o.name}</a>
              <span> — {o.life || "dates unknown"}</span>
              {prov[o.slug]?.graft && <span> · above the {prov[o.slug].graft} graft</span>}
            </li>
          ))}
        </ul>
      </Fragment>
    )}

    {portrait && (
      <Fragment slot="media">
        <figure style="margin:0;max-width:320px">
          <img src={u(portrait.src)} width={portrait.w} height={portrait.h}
            loading="eager" decoding="async" alt={portrait.alt}
            style="display:block;width:100%;height:auto;border:1px solid var(--rule)" />
          <figcaption class="cap" style="margin-top:.6rem">{portrait.cap}
            {portrait.note && <> <strong>{portrait.note}</strong></>}</figcaption>
        </figure>
      </Fragment>
    )}

    {notes.length > 0 && (
      <Fragment slot="notes">
        <h3>What is written about {p.name.split(" ")[0]}</h3>
        <p class="small">Carried across from the family tree, with its markup stripped. Family
        testimony, not an independent record — valuable, and labelled.{STORYMODE ? " The notes are in The story, above." : ""}</p>
        {anyDamaged && (
          <Note tight>
            <strong>This note reached the archive damaged.</strong> The export it came from stores rich
            text, and the transfer truncated it — opening tags cut off mid-attribute, and words missing
            from the middle of sentences. What follows has had the wreckage stripped, but
            <strong> sentences will still break off</strong>. That is the source, not the transcription,
            and nothing has been invented to bridge the gaps.
          </Note>
        )}
        {!STORYMODE && notes.map((n) => (
          <Note tight style="white-space:pre-wrap">{n.text}</Note>
        ))}
      </Fragment>
    )}

    {STORYMODE && (
      <PersonSection kind="more" title="How the family links on this page are known">
        <FamilyLinkNotes {allRel} {recorded} {grafted} {dupKids} {dupSibs} {u} />
      </PersonSection>
    )}

    {rec && (
      <PersonSection kind="more" title="What the records say">
        {rec.settled && rec.alsoNamed.length > 0
          ? <p class="small"><strong>{rec.alsoNamed.length + 1} people in this family tree carry the
            name {rec.name}</strong>, and these records have been assigned to this one on the dates
            they give. Which record belongs to whom is set out in <span class="mono">tools/record-owners.json</span>,
            rule by rule. The others: {rec.alsoNamed.map((o, i) => (
              <>{i > 0 && " · "}<a href={u(`/people/${o}`)}>{o}</a></>))}.
            <a href={u("/name/")}> Why they are kept apart →</a></p>
          : rec.shared
          ? <Note tight>
              <strong>Filed under the name, not assigned to this person.</strong> This archive's
              register keys a record to the name on the document, and <strong>{rec.name}</strong> is
              carried by {rec.alsoNamed.length + 1} people in this tree. At least one line below
              belongs to somebody else, and which is which is not settled. They are shown rather than
              dropped, and they are not merged: <a href={u("/name/")}>a shared name is not a
              person</a>. Also of this name: {rec.alsoNamed.map((o, i) => (
                <>{i > 0 && " · "}<a href={u(`/people/${o}`)}>{o}</a></>))}.
            </Note>
          : <p class="small">Every record this archive has read that names {p.name}. The name is
            unique in this tree, so these are his or hers.
            <a href={u("/register/")}> The whole register →</a></p>}
        <div style="margin-top:1.1rem;display:flex;flex-direction:column;gap:1.1rem">
          {rec.rows.map((r) => (
            <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
              <p>{r.says}</p>
              <p class="small" style="margin-top:.4rem;color:var(--ink-2)">
                <span class={rec.shared ? "chip lore" : "chip doc"}>record</span> {r.source}
                {r.link && r.link.startsWith("http") && <> · <a href={r.link}>the source ↗</a></>}
              </p>
            </div>
          ))}
        </div>
      </PersonSection>
    )}

    {(mentions[p.slug] || []).length > 0 && (
      <PersonSection kind="more" title={`Everywhere ${p.name.split(" ")[0]} appears in this archive`}>
        {/* A mention is a page of this site that writes about someone in prose. build_mentions.py deliberately skips the directory pages
            (/register, /graves, /households, /families, /who) because a name in a card grid is not a mention. A MENTION COUNT MEASURES PROSE, NOT EVIDENCE. */}
        <p class="small">Every page of this site that <em>writes about</em> {p.name} in prose,
        gathered automatically — {(mentions[p.slug] || []).length} in total. This counts pages, not
        records: the lists and registers are skipped on purpose, so a person can be well documented
        and appear here once or not at all.
        {" "}<a href={u("/method/")}>How claims are labelled →</a></p>
        <div style="margin-top:1.1rem;display:flex;flex-direction:column;gap:.85rem">
          {(mentions[p.slug] || []).map((h) => (
            <div style="border-left:2px solid var(--rule-strong);padding:2px 0 2px 16px">
              <a href={u(h.path)}><strong>{h.title}</strong></a>
              <p class="small noauto" data-no-autolink style="margin-top:.3rem;color:var(--ink-2)">{h.snippet}</p>
            </div>
          ))}
        </div>
      </PersonSection>
    )}

    {appears.length > 0 && (
      <PersonSection kind="more" title="Written about here">
        <p class="small">Pages of this archive where {p.name.split(" ")[0]} is part of the argument,
        not just a name in a list.</p>
        <div class="grid three" style="margin-top:1rem">
          {appears.map(([href, label]) => (
            <a class="cardlink" href={u(href)}><div class="nm">{label}</div></a>
          ))}
        </div>
      </PersonSection>
    )}
  </PersonPage>
</Base>
)}
