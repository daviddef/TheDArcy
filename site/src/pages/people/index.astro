---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import FilterTable from "@daviddef/archive-kit/components/FilterTable.astro";
import { people } from "../../lib/people.js";
import ancestors from "../../data/ancestors.json";
import familyData from "../../data/families.json";

// Everyone this page could have shown but does not, counted once each.
const withheld = new Set([
  ...ancestors.filter((a) => a.living).map((a) => a.id),
  ...familyData.flatMap((f) => f.members.filter((m) => m.living).map((m) => m.id)),
]).size;
const inLine = people.filter((p) => p.ancestor).length;

const surnames = [...new Set(people.map((p) => p.family).filter(Boolean))].sort();

/* THE CHIP ROW HELD TWO QUESTIONS AT ONCE. "Direct line" sat in the same row as
   the surnames, so choosing one cleared the other and a reader could not ask
   for the Sneyds who are ancestors. They are separate facets now and narrow
   together. The century headings go: one table with a search beats scrolling
   to the 1800s, and the shared script reads each row's own text instead of the
   hay attribute this page was writing beside every card. */
const esc = (t) => String(t ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;");
const bySur = surnames.map((sn) => [sn, people.filter((p) => p.family === sn).length]);
const listed = [...people].sort((a, b) => {
  const y = (p) => +((p.born || p.died || "").match(/\d{4}/) || [9999])[0];
  return y(a) - y(b) || a.name.localeCompare(b.name);
});
---
<Base
  title="The People"
  eyebrow={`${people.length} named`}
  dek="Everybody this archive can name and publish, in one list — searchable by name, year, place, trade or family.">

  <section class="blk">
    <p class="lede">There are <strong>{people.length}</strong> people here.
    Of those, <strong>{inLine}</strong> are direct ancestors and the rest are their brothers,
    sisters, spouses and cousins — the people a pedigree throws away.</p>
    <p class="dek" style="margin-top:.9rem">A further <strong>{withheld}</strong> people who would
    otherwise be listed here are living, and do not appear in this build at all: not hidden, not
    gated, not present in the output. Across the whole family tree the rule withholds
    <strong>2,034</strong>. <a href={u("/method/")}>The rule, and how to invoke it →</a></p>
    <p class="dek" style="margin-top:.9rem">This page is the <em>tree's</em> people. For every named
    individual this archive has met anywhere — including people who are not relatives at all, and
    with the source printed beside each one — see <a href={u("/register/")}>the register</a>.</p>
    <p class="dek" style="margin-top:.9rem">Every one of these pages now opens with a
    <strong>pedigree chart</strong>, and the border down the left of each card says how that
    relationship is known: solid where a record this archive has read writes it down, dotted where
    only the family tree asserts it, struck through where it hangs above a graft the archive has
    rejected. <strong>Of the 473 charts, 19 contain a single solid edge.</strong> That is not a
    defect in the drawing. <a href={u("/method/")}>How claims are labelled →</a></p>
  </section>

  <section class="blk" style="border-bottom:0">
    <FilterTable
      unit="people"
      note="Filter by name, year, place or trade. Spelling in this family moves about &mdash; try <em>Darcy</em> as well as <em>D&rsquo;Arcy</em>, or <em>Snead</em> as well as <em>Sneyd</em>."
      columns={[{ label: "Name" }, { label: "Life", cls: "mono" }, { label: "Where" },
                { label: "Trade", cls: "small" }]}
      facets={[
        { key: "fam", label: "Family", all: `All ${people.length}`,
          options: bySur.map(([sn, c]) => ({ v: sn, label: `${sn} (${c})` })) },
        { key: "line", label: "On the line", all: "Everyone",
          options: [{ v: "1", label: `Direct ancestors (${inLine})` },
                    { v: "0", label: `Everyone else (${people.length - inLine})` }] },
      ]}
      rows={listed.map((p) => ({
        facets: { fam: p.family || "", line: p.ancestor ? "1" : "0" },
        cells: [
          `<a href="${u(`/people/${p.slug}`)}"><strong>${esc(p.name)}</strong></a>` +
            (p.ancestor ? `<span class="chip doc" style="margin-left:6px">direct line</span>` : ""),
          esc(p.life || "dates unknown"),
          esc([p.bornPlace, p.diedPlace].filter(Boolean).map((x) => x.split(",")[0]).join(" \u2192 ")),
          esc(p.occupation || ""),
        ],
      }))} />
  </section>


</Base>
