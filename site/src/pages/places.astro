---
import Base from "../layouts/Base.astro";
import Places from "@daviddef/archive-kit/components/Places.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import places from "../data/places.json";

const country = (p) => {
  const t = p.place.toLowerCase();
  if (/australia|queensland|new south wales|nsw|qld|victoria|brisbane|sydney/.test(t)) return "Australia";
  if (/ireland|limerick|monaghan|cork|dublin/.test(t)) return "Ireland";
  if (/scotland|ayr|lanark|glasgow|quivox/.test(t)) return "Scotland";
  if (/england|yorkshire|hampshire|somerset|london|bristol|kent|middlesex|dorset|portsmouth|surrey|devon/.test(t)) return "England";
  if (/germany|prussia|bavaria/.test(t)) return "Germany";
  if (/barbados|caribbean|west indies|jamaica/.test(t)) return "The Caribbean";
  if (/italy|italia|campania|caserta|benevento/.test(t)) return "Italy";
  return "Elsewhere";
};
const order = ["Australia", "England", "Ireland", "Scotland", "Germany",
               "The Caribbean", "Italy", "Elsewhere"];
const groups = {};
for (const p of places) (groups[country(p)] ||= []).push(p);
import atlas from "../../public/atlas-data.json";
---
<Base
  title="Places"
  eyebrow={`${places.length} named places`}
  dek="Where this family was born and where it died — counted, not asserted. The shape of the list is the shape of the migration.">

  <section class="blk">
    <p class="lede">Every place named in a birth or death record among the ancestors, with the number
    of times it appears and <strong>the earliest year it appears</strong>. Each group is ordered by
    that year rather than by frequency — so the Australian list, read from the top, is the migration
    itself: Parramatta in 1829, Kempsey in 1838, Brisbane from 1856, and then out along the Queensland
    railway to Rockhampton, Boulia, Gympie and Toowoomba.</p>

    <Note>
      <strong>The counts are of places, not of spellings.</strong> The exported tree writes the same
      city four ways — <em>Brisbane, Brisbane, Queensland, Australia</em>; <em>Brisbane, QLD,
      Australia</em>; and so on — which would split one place into four and make every figure here
      meaningless. Repeated parts are collapsed and state abbreviations expanded before counting.
      Nothing is merged that is not literally the same place, and where a spelling was folded in it is
      shown beneath the entry. <a href={u("/method/")}>Method →</a>
    </Note>
  </section>


  <Places u={u} countLabel="Events" rows={order.filter((k) => groups[k]).flatMap((k) =>
    groups[k].slice().sort((a, b) => (a.first || 9999) - (b.first || 9999)).map((p) => ({
      name: p.place,
      n: p.n,
      where: k,
      span: p.first ? String(p.first) : "",
      variants: p.variants || [],
    })))} />
  {/* WHAT STOOD HERE, AND WHY IT IS GONE.

      A search box, a live count, a table of every place, the script that
      drove them and a content-visibility rule for the groups it drew. When
      this page moved onto the kit's Places component the table went and
      NONE OF THE REST DID.

      So the page shipped TWO search boxes. The one under the heading
      "Search", with the placeholder about Boulia and Staffordshire, was the
      prominent one, and it did nothing at all: its script queried .prow and
      .plgroup, of which the page rendered none. The count beside it read
      "167 places" and could never read anything else. Below them both sat
      the component's own filter, which worked.

      Found by `astro check` on 20 September, which flagged the four orphan
      closing tags left where the table had been. Nothing else had ever
      mentioned it: the page built, and a dead control looks exactly like a
      live one until somebody types in it. */}


<section class="blk" id="every-place">
  <h2>Every place with a page of its own</h2>
  <p class="dek">One page per place the atlas can put a person in, listing who was born, married or
    buried there and what the archive read to know it. These were reachable only by clicking a marker
    on the map, which meant a reader without JavaScript — and a search engine — could not get to any
    of them.</p>
  <p class="placelist">{atlas.places.filter((p) => p.slug).sort((a, b) =>
      (a.place || a.name || "").localeCompare(b.place || b.name || "")).map((p, i) => (
    <>{i > 0 && <span class="sep"> · </span>}<a href={u(`/places/${p.slug}/`)}>{p.place || p.name}</a></>
  ))}</p>
</section>
</Base>
