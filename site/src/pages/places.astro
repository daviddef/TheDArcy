---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import places from "../data/places.json";

const country = (p) => {
  const t = p.place.toLowerCase();
  if (/australia|queensland|new south wales|nsw|qld|victoria|brisbane|sydney/.test(t)) return "Australia";
  if (/ireland|limerick|monaghan|cork|dublin/.test(t)) return "Ireland";
  if (/scotland|ayr|lanark|glasgow|quivox/.test(t)) return "Scotland";
  if (/england|yorkshire|hampshire|somerset|london|bristol|kent|middlesex|dorset|portsmouth|surrey|devon/.test(t)) return "England";
  if (/germany|prussia|bavaria/.test(t)) return "Germany";
  if (/barbados|caribbean|west indies|jamaica/.test(t)) return "The Caribbean";
  if (/italy|italia|campania|caserta|benevento/.test(t)) return "Italy";
  return "Elsewhere";
};
const order = ["Australia", "England", "Ireland", "Scotland", "Germany",
               "The Caribbean", "Italy", "Elsewhere"];
const groups = {};
for (const p of places) (groups[country(p)] ||= []).push(p);
---
<Base
  title="Places"
  eyebrow={`${places.length} named places`}
  dek="Where this family was born and where it died — counted, not asserted. The shape of the list is the shape of the migration.">

  <section class="blk">
    <p class="lede">Every place named in a birth or death record among the ancestors, with the number
    of times it appears and <strong>the earliest year it appears</strong>. Each group is ordered by
    that year rather than by frequency — so the Australian list, read from the top, is the migration
    itself: Parramatta in 1829, Kempsey in 1838, Brisbane from 1856, and then out along the Queensland
    railway to Rockhampton, Boulia, Gympie and Toowoomba.</p>

    <div class="note" style="margin-top:1.2rem">
      <strong>The counts are of places, not of spellings.</strong> The exported tree writes the same
      city four ways — <em>Brisbane, Brisbane, Queensland, Australia</em>; <em>Brisbane, QLD,
      Australia</em>; and so on — which would split one place into four and make every figure here
      meaningless. Repeated parts are collapsed and state abbreviations expanded before counting.
      Nothing is merged that is not literally the same place, and where a spelling was folded in it is
      shown beneath the entry. <a href={u("/method")}>Method →</a>
    </div>
  </section>

  {order.filter((k) => groups[k]).map((k) => (
    <section class="blk">
      <h2>{k}</h2>
      <p class="small">{groups[k].length} places · {groups[k].reduce((a, p) => a + p.n, 0)} recorded events</p>
      <div class="scroll" style="margin-top:.8rem">
        <table>
          <thead><tr><th class="m">From</th><th>Place</th><th class="m">Events</th></tr></thead>
          <tbody>
            {groups[k].sort((a, b) => (a.first || 9999) - (b.first || 9999)).map((p) => (
              <tr>
                <td class="m">{p.first || "—"}</td>
                <td>
                  {p.place}
                  {p.variants && p.variants.length > 0 && (
                    <div class="small">also written: {p.variants.join(" · ")}</div>
                  )}
                </td>
                <td class="m">{p.n}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Base>
