---
import Base from "../layouts/Base.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import places from "../data/places.json";

const country = (p) => {
  const t = p.place.toLowerCase();
  if (/australia|queensland|new south wales|nsw|qld|victoria|brisbane|sydney/.test(t)) return "Australia";
  if (/ireland|limerick|monaghan|cork|dublin/.test(t)) return "Ireland";
  if (/scotland|ayr|lanark|glasgow|quivox/.test(t)) return "Scotland";
  if (/england|yorkshire|hampshire|somerset|london|bristol|kent|middlesex|dorset|portsmouth|surrey|devon/.test(t)) return "England";
  if (/germany|prussia|bavaria/.test(t)) return "Germany";
  if (/barbados|caribbean|west indies|jamaica/.test(t)) return "The Caribbean";
  if (/italy|italia|campania|caserta|benevento/.test(t)) return "Italy";
  return "Elsewhere";
};
const order = ["Australia", "England", "Ireland", "Scotland", "Germany",
               "The Caribbean", "Italy", "Elsewhere"];
const groups = {};
for (const p of places) (groups[country(p)] ||= []).push(p);
import atlas from "../../public/atlas-data.json";
---
<Base
  title="Places"
  eyebrow={`${places.length} named places`}
  dek="Where this family was born and where it died — counted, not asserted. The shape of the list is the shape of the migration.">

  <section class="blk">
    <p class="lede">Every place named in a birth or death record among the ancestors, with the number
    of times it appears and <strong>the earliest year it appears</strong>. Each group is ordered by
    that year rather than by frequency — so the Australian list, read from the top, is the migration
    itself: Parramatta in 1829, Kempsey in 1838, Brisbane from 1856, and then out along the Queensland
    railway to Rockhampton, Boulia, Gympie and Toowoomba.</p>

    <Note>
      <strong>The counts are of places, not of spellings.</strong> The exported tree writes the same
      city four ways — <em>Brisbane, Brisbane, Queensland, Australia</em>; <em>Brisbane, QLD,
      Australia</em>; and so on — which would split one place into four and make every figure here
      meaningless. Repeated parts are collapsed and state abbreviations expanded before counting.
      Nothing is merged that is not literally the same place, and where a spelling was folded in it is
      shown beneath the entry. <a href={u("/method/")}>Method →</a>
    </Note>
  </section>

  <section class="blk" id="finder">
    <div class="lab">Search</div>
    <label for="q" class="vh">Search the places</label>
    <input id="q" type="search" autocomplete="off"
      placeholder="Try a town, a county, a year — Boulia, Staffordshire, 1826…"
      style="width:100%;max-width:56ch;margin-top:.55rem;padding:.65rem .8rem;font:inherit;font-size:1rem;
             border:1px solid var(--rule-strong);border-radius:3px;background:var(--paper);color:var(--ink)" />
    <p class="small" id="pcount" style="margin-top:.8rem" aria-live="polite">{places.length} places</p>
  </section>

  {order.filter((k) => groups[k]).map((k) => (
    <section class="blk plgroup">
      <h2>{k}</h2>
      <p class="small gcount">{groups[k].length} places · {groups[k].reduce((a, p) => a + p.n, 0)} recorded events</p>
      <Scroll>
        <table>
          <thead><tr><th class="m">From</th><th>Place</th><th class="m">Events</th></tr></thead>
          <tbody>
            {groups[k].sort((a, b) => (a.first || 9999) - (b.first || 9999)).map((p) => (
              <tr class="prow" data-s={`${p.place} ${(p.variants || []).join(" ")} ${p.first || ""} ${k}`.toLowerCase()}>
                <td class="m">{p.first || "—"}</td>
                <td>
                  {p.place}
                  {p.variants && p.variants.length > 0 && (
                    <div class="small">also written: {p.variants.join(" · ")}</div>
                  )}
                </td>
                <td class="m">{p.n}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </Scroll>
    </section>
  ))}
  <script is:inline>
    (function () {
      var q = document.getElementById("q");
      if (!q) return;
      var rows = [].slice.call(document.querySelectorAll(".prow"));
      var groups = [].slice.call(document.querySelectorAll(".plgroup"));
      // Haystack per row and group per row, resolved once. The group loop
      // below used to ask the DOM to collect every unhidden row again, per
      // group, per keystroke — the tally the row loop already has.
      var hay = rows.map(function (r) { return r.getAttribute("data-s"); });
      var at = new Map();
      groups.forEach(function (g, i) { at.set(g, i); });
      var owner = rows.map(function (r) { return at.get(r.closest(".plgroup")); });
      var count = document.getElementById("pcount");
      function apply() {
        var terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
        var shown = 0;
        var live = groups.map(function () { return 0; });
        rows.forEach(function (r, i) {
          var h = hay[i];
          var ok = terms.every(function (t) { return h.indexOf(t) !== -1; });
          r.hidden = !ok;
          if (ok) { shown++; live[owner[i]]++; }
        });
        groups.forEach(function (g, i) {
          var any = live[i];
          g.hidden = any === 0;
          var gc = g.querySelector(".gcount");
          if (gc) gc.textContent = any + (any === 1 ? " place" : " places");
        });
        count.textContent = shown + (shown === 1 ? " place" : " places") + (terms.length ? " matching" : "");
      }
      q.addEventListener("input", apply);
      var pre = new URLSearchParams(location.search).get("q");
      if (pre) { q.value = pre; apply(); }
    })();
  </script>
<style is:global>
  /* is:global, deliberately. A scoped <style> makes Astro stamp
     data-astro-cid-… onto every element the page renders, and on a register
     of 11,765 rows that added 218 bytes a row — 2.5MB onto the very page
     whose size was the problem. The selector below is specific to this page
     anyway. */
  /* Only the groups on screen need laying out; every row stays in the HTML. */
  .plgroup {
    content-visibility: auto;
    /* Plain length first: browsers from Chrome 85 to 110 support
       content-visibility but cannot parse the "auto" keyword here, and
       without a usable estimate they collapse every off-screen section
       to nothing and the scrollbar jumps as you scroll. */
    contain-intrinsic-size: 420px;
    contain-intrinsic-size: auto 420px;
  }
</style>

<section class="blk" id="every-place">
  <h2>Every place with a page of its own</h2>
  <p class="dek">One page per place the atlas can put a person in, listing who was born, married or
    buried there and what the archive read to know it. These were reachable only by clicking a marker
    on the map, which meant a reader without JavaScript — and a search engine — could not get to any
    of them.</p>
  <p class="placelist">{atlas.places.filter((p) => p.slug).sort((a, b) =>
      (a.place || a.name || "").localeCompare(b.place || b.name || "")).map((p, i) => (
    <>{i > 0 && <span class="sep"> · </span>}<a href={u(`/places/${p.slug}/`)}>{p.place || p.name}</a></>
  ))}</p>
</section>
</Base>
