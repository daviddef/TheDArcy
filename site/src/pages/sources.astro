---
import Base from "../layouts/Base.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import { people } from "../lib/people.js";
import printed from "../data/printed.json";
import src from "../data/sources.json";
import { mdp } from "@daviddef/archive-kit/lib/md.js";

/* The two prose lists below used to be hand-written <ul>s in this file — about
   a hundred lines of markup with the evidence inside it. They are data now, so
   they can be counted, gated and re-ordered without touching a page. The
   `mono` spans became backticks and the inline links became a links array;
   nothing else was changed. */
const mono = (h) => h.replace(/`([^`]+)`/g, '<span class="mono">$1</span>');

const withSrc = people.filter((p) => (p.sources || []).length > 0).length;
const counts = {};
for (const p of people) for (const s of p.sources || []) {
  const k = s.split("—")[0].trim();
  counts[k] = (counts[k] || 0) + 1;
}
const ranked = Object.entries(counts).sort((a, b) => b[1] - a[1]);
---
<Base
  title="Sources"
  eyebrow="Where the evidence comes from"
  dek="Every citation the archive carries, counted — and, more usefully, a plain statement of which of them are records and which are other people's family trees.">

  <section class="blk">
    <p class="lede">Of the {people.length} published people here, <strong>{withSrc}</strong> carry at
    least one citation. That number flatters the archive, and this page exists to say why.</p>

    <Note>
      <strong>A family tree is not a source.</strong> Several of the most frequent citations below are
      other people's online trees — Geni, FamilySearch Family Tree, and named MyHeritage sites. Those
      record what somebody believed. They are shown because concealing them would be worse, but they
      carry no evidential weight in this archive, and a claim resting only on them is marked
      <span class="chip lore">family lore</span> or <span class="chip dis">disputed</span> however
      many trees repeat it. <a href={u("/method/")}>Method →</a>
    </Note>
  </section>

  <section class="blk">
    <h2>{printed.head}</h2>
    <p class="lede" style="margin-top:.8rem">{printed.lede}</p>
    <Scroll>
      <table style="margin-top:1.2rem">
        <thead><tr>{printed.cols.map((c) => (<th>{c}</th>))}</tr></thead>
        <tbody>
          {printed.rows.map(([src, ed, where, gave, href]) => (
            <tr>
              <td><strong>{src}</strong></td>
              <td class="m small" style="white-space:nowrap">{ed}</td>
              <td class="small">{where}</td>
              <td class="small">{gave} <a href={u(href + "/")}>→</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </Scroll>
    <Note style="margin-top:1.2rem">
      <strong>{printed.rows.length} sources, and not one of them cost anything.</strong>
      {printed.note}
    </Note>
  </section>

  <section class="blk">
    <h2>{src.recordSetsHead}</h2>
    <p class="small" style="margin-top:.5rem">{src.recordSetsNote}</p>
    <div style="margin-top:1.3rem;display:flex;flex-direction:column;gap:1.3rem">
      {src.recordSets.map((r) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div><strong set:html={mono(mdp(r.name))}></strong>
            {r.chip && <> <span class="chip inf">{r.chip}</span></>}</div>
          <p class="small" style="margin-top:.4rem" set:html={mono(mdp(r.body))}></p>
          {r.links.length > 0 && (
            <p class="small" style="margin-top:.35rem">{r.links.map(([label, href], i) => (
              <>{i > 0 && " · "}<a href={u(href + "/")}>{label} →</a></>))}</p>)}
        </div>
      ))}
    </div>
    <p class="small" style="margin-top:1.1rem">{src.recordSets.length} record sets.</p>
  </section>

  <section class="blk">
    <h2>{src.privateHead}</h2>
    <div style="margin-top:1.1rem;display:flex;flex-direction:column;gap:1.1rem">
      {src.private.map((r) => (
        <div style="border-left:2px solid var(--rule-strong);padding:2px 0 2px 16px">
          <div><strong set:html={mono(mdp(r.name))}></strong></div>
          <p class="small" style="margin-top:.4rem" set:html={mono(mdp(r.body))}></p>
          {r.links.length > 0 && (
            <p class="small" style="margin-top:.35rem">{r.links.map(([label, href]) => (
              <a href={u(href + "/")}>{label} →</a>))}</p>)}
        </div>
      ))}
    </div>
  </section>

  <section class="blk" style="border-bottom:0">
    <h2>Every citation string in the tree, counted</h2>
    <p class="small">Exactly as carried in the exported GEDCOM, so that the balance between records
    and trees is visible rather than asserted.</p>
    <Scroll>
      <table>
        <thead><tr><th>Citation</th><th class="m">People</th></tr></thead>
        <tbody>
          {ranked.map(([k, n]) => (<tr><td>{k}</td><td class="m">{n}</td></tr>))}
        </tbody>
      </table>
    </Scroll>
  </section>
</Base>
