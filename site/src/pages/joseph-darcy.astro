---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import d from "../data/joseph-darcy.json";
---
<Base
  title="Lieutenant-Colonel Joseph D'Arcy"
  eyebrow={`Portsea 1780 – Lymington 1848 · found ${d.found}`}
  dek="The first person in this archive's English line, and the one it knew least about. Saint-Domingue, Sicily, Walcheren, and five years in Persia in the service of the Shah's son.">

  <section class="blk"><p class="lede">{d.lede}</p></section>

  <section class="blk">
    <div class="lab">{d.death.notice}</div>
    <h2 style="margin-top:.4rem">The death</h2>
    <div class="note" style="border-left-width:3px;margin-top:1rem">
      <strong style="font-size:1.1em">{d.death.text}</strong>
      <span class="chip doc">documented</span>
    </div>
    <p class="small" style="margin-top:1rem">{d.death.reg}</p>
  </section>

  <section class="blk">
    <div class="lab">{d.will.notice}</div>
    <h2 style="margin-top:.4rem">And a will</h2>
    <p class="lede">{d.will.text}</p>
    <div class="note" style="margin-top:1.2rem">{d.will.cut}
      <a href={u("/errands")}>On the queue →</a></div>
  </section>

  <section class="blk">
    <div class="lab">{d.obit.papers}</div>
    <h2 style="margin-top:.4rem">The obituary</h2>
    <div class="note" style="border-left-width:3px;margin-top:1rem">
      {d.obit.text}
      <span class="chip doc">documented</span>
    </div>
    <p class="small" style="margin-top:1rem">{d.obit.note}</p>
  </section>

  <section class="blk">
    <div class="lab">The Royal Military Calendar, 1820</div>
    <h2 style="margin-top:.4rem">{d.rmc.head}</h2>
    <p class="lede">{d.rmc.lede}</p>
    <div class="note" style="border-left-width:3px;margin-top:1.1rem">
      <strong>{d.rmc.quote}</strong> <span class="chip doc">{d.rmc.chip}</span>
    </div>
    <div class="scroll" style="margin-top:1.2rem">
      <table>
        <thead><tr><th class="m">Date</th><th>Rank</th><th></th></tr></thead>
        <tbody>{d.rmc.rows.map(([when, what, note]) => (
          <tr><td class="m" style="white-space:nowrap">{when}</td>
              <td><strong>{what}</strong></td><td class="small">{note}</td></tr>))}</tbody>
      </table>
    </div>

    <h3 style="margin-top:1.8rem">{d.rmc.persiaHead}</h3>
    <div class="note" style="border-left-width:3px;margin-top:.8rem">
      <strong style="font-size:1.05em">{d.rmc.persia}</strong>
      <span class="chip doc">{d.rmc.chipPersia}</span>
    </div>
    <p style="margin-top:1.1rem">{d.rmc.persiaMeans}</p>
    <div class="note" style="margin-top:1.2rem">
      <strong>And what it still does not give.</strong> {d.rmc.careful}
    </div>
    <p class="small" style="margin-top:1rem;color:var(--ink-3)">{d.rmc.where}</p>
  </section>

  <section class="blk">
    <div class="lab">Prince Abbas Mirza</div>
    <h2 style="margin-top:.4rem">{d.persia.head}</h2>
    <p class="lede">{d.persia.body}</p>
    <div class="note" style="margin-top:1.2rem">{d.persia.careful}
      <span class="chip doc">the service, from the army's own record of 1820</span></div>
  </section>

  <section class="blk">
    <div class="lab">Lady's Newspaper, 8 April 1848</div>
    <h2 style="margin-top:.4rem">{d.katherine.head}</h2>
    <p class="lede">{d.katherine.body}</p>
    <div class="note" style="margin-top:1.2rem">{d.katherine.means}
      <a href={u("/new-generations")}>People the tree never had →</a></div>
  </section>

  <section class="blk">
    <div class="lab">K.L.S.</div>
    <h2 style="margin-top:.4rem">{d.kls.head}</h2>
    <p class="lede">{d.kls.body}</p>
    <div class="note" style="border-left-width:3px;margin-top:1.2rem">
      <strong>{d.kls.gazetted.head}.</strong>
      <br /><br />
      <strong style="font-size:1.08em">{d.kls.gazetted.text}</strong>
      <br /><br />
      <span class="small">{d.kls.gazetted.src}</span>
      <span class="chip doc">{d.kls.gazetted.chip}</span>
    </div>
    <div class="note" style="margin-top:1.2rem">{d.kls.gazetted.means}</div>
    <p class="small" style="margin-top:1rem;color:var(--ink-3)">What this page said until
      15 September 2026: {d.kls.careful}</p>
  </section>

  <section class="blk">
    <div class="lab">{d.census.ref}</div>
    <h2 style="margin-top:.4rem">Priestlands, 1841</h2>
    <p>{d.census.note}</p>
    <div class="scroll" style="margin-top:1.1rem">
      <table>
        <thead><tr><th>Name</th><th class="m">Age</th><th class="m">Born</th><th>Birth county</th><th></th></tr></thead>
        <tbody>
          {d.census.rows.map(([fn, sn, sx, age, by, cty, note]) => (
            <tr style={sn === "PITT" || fn === "Richard" ? "background:var(--tint)" : ""}>
              <td><strong>{fn}</strong> <span class="small" style="color:var(--ink-3)">{sn}</span></td>
              <td class="m">{age}</td><td class="m">{by}</td>
              <td class="small">{cty}</td><td class="small">{note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small" style="margin-top:.9rem">{d.census.servants}</p>

    <div class="note" style="margin-top:1.3rem">
      <strong>{d.hampshire.head}.</strong> {d.hampshire.body}
      <span class="chip doc">{d.hampshire.chip}</span>
    </div>
  </section>

  <section class="blk">
    <div class="lab">Where the name came from?</div>
    <h2 style="margin-top:.4rem">{d.pitt.head}</h2>
    <p class="lede">{d.pitt.body}</p>
    <div class="note" style="margin-top:1.2rem">
      <strong>Carefully.</strong> {d.pitt.careful}
      <span class="chip inf">{d.pitt.chip}</span>
      <a href={u("/george-pitt")}>George Pitt D'Arcy →</a>
      <br /><br />
      <strong>{d.pitt.tested}</strong>
    </div>
    <p class="dek" style="margin-top:1.2rem">{d.richard}
      <a href={u("/portsea")}>Why his baptism would never have been found →</a></p>
  </section>

  <section class="blk">
    <div class="lab">Sixty-eight years</div>
    <h2 style="margin-top:.4rem">What is on record</h2>
    <div class="scroll" style="margin-top:1.1rem">
      <table>
        <tbody>
          {d.career.map(([when, what]) => (
            <tr><td class="m" style="white-space:nowrap"><strong>{when}</strong></td><td>{what}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="dek" style="margin-top:1.2rem">{d.son}</p>
    <div class="note" style="margin-top:1.2rem">{d.age}</div>
  </section>

  <section class="blk">
    <div class="lab">1848–1852</div>
    <h2 style="margin-top:.4rem">{d.after.head}</h2>
    <div style="margin-top:1.1rem;display:flex;flex-direction:column;gap:1rem">
      {d.after.rows.map(([when, what]) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div><span class="mono small" style="color:var(--ink-3)">{when}</span></div>
          <p class="small" style="margin-top:.3rem">{what}</p>
        </div>
      ))}
    </div>
    <p class="small" style="margin-top:1rem">{d.after.note}</p>
  </section>

  <section class="blk">
    <div class="lab">Bath, November 1817</div>
    <h2 style="margin-top:.4rem">{d.ladycatherine.head}</h2>
    <p class="lede">{d.ladycatherine.lede}</p>

    <div style="margin-top:1.3rem;display:flex;flex-direction:column;gap:1.2rem">
      {d.ladycatherine.notices.map(([paper, text]) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div class="small" style="color:var(--ink-3)">{paper}</div>
          <p style="margin-top:.4rem"><strong>{text}</strong></p>
        </div>
      ))}
    </div>

    <p style="margin-top:1.3rem">{d.ladycatherine.who}</p>

    <div class="scroll" style="margin-top:1.3rem">
      <table>
        <tbody>{d.ladycatherine.sons.map(([who, what, note]) => (
          <tr><td><strong>{who}</strong><div class="small" style="color:var(--ink-3)">{what}</div></td>
              <td class="small">{note}</td></tr>))}</tbody>
      </table>
    </div>

    <div class="note" style="border-left-width:3px;margin-top:1.3rem">
      {d.ladycatherine.means} <span class="chip doc">documented</span>
    </div>
    <div class="lab" style="margin-top:1.8rem">{d.ladycatherine.death.src}</div>
    <h3 style="margin-top:.4rem">{d.ladycatherine.death.head}</h3>
    <div class="note" style="border-left-width:3px;margin-top:.8rem">
      <strong style="font-size:1.1em">{d.ladycatherine.death.text}</strong>
      <span class="chip doc">{d.ladycatherine.death.chip}</span>
    </div>
    <p style="margin-top:1.1rem">{d.ladycatherine.death.means}</p>
    <div class="note" style="margin-top:1.2rem">
      <strong>One inference, and two things unexplained.</strong> {d.ladycatherine.death.careful}
    </div>

    <div class="note" style="margin-top:1.2rem">
      <strong>And what is not claimed here.</strong> {d.ladycatherine.careful}
      {" "}<span class="chip inf">{d.ladycatherine.chip}</span>
    </div>
  </section>

  <section class="blk">
    <div class="lab">Milford House, and after</div>
    <h2 style="margin-top:.4rem">{d.forward.head}</h2>
    <p class="lede">{d.forward.body}</p>
    <p class="dek" style="margin-top:.8rem">These are the children of his SECOND marriage,
      to KATHERINE LUCY ELIZA HYDE in November 1830.</p>

    <div style="margin-top:1.3rem;display:flex;flex-direction:column;gap:1.2rem">
      {d.forward.kids.map(([who, bapt, what]) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div><strong>{who}</strong></div>
          <p class="small" style="margin-top:.3rem;color:var(--ink-3)">{bapt}</p>
          <p class="small" style="margin-top:.3rem">{what}</p>
        </div>
      ))}
    </div>

    <div class="note" style="margin-top:1.3rem"><strong>Madeira.</strong> {d.forward.madeira}</div>

    <h3 style="margin-top:1.8rem">{d.forward.grandson.head}</h3>
    <p class="lede">{d.forward.grandson.body}</p>
    <div class="note" style="margin-top:1.1rem">{d.forward.grandson.means}
      {" "}<span class="chip doc">{d.forward.grandson.chip}</span></div>

    <div class="scroll" style="margin-top:1.4rem">
      <table>
        <tbody>{d.forward.rows.map(([when, what]) => (
          <tr><td class="m" style="white-space:nowrap">{when}</td><td class="small">{what}</td></tr>))}
        </tbody>
      </table>
    </div>
    <div class="note" style="margin-top:1.2rem">{d.forward.means}
      {" "}<span class="chip doc">{d.forward.chip}</span>
      {" "}<a href={u("/new-generations")}>The new generations →</a></div>
  </section>

  <section class="blk">
    <div class="lab">The National Archives IR 27/284</div>
    <h2 style="margin-top:.4rem">{d.duty.head}</h2>
    <p>{d.duty.body}</p>
    <p class="small" style="margin-top:1rem"><a href={u("/errands")}>What it would cost to read →</a></p>
  </section>

  <section class="blk" style="border-bottom:0">
    <h2>Why it matters</h2>
    <p class="lede">{d.matters}</p>
    <p class="small" style="margin-top:1.4rem">
      <a href={u("/portsea")}>The baptism →</a> ·
      <a href={u("/the-corps")}>His father's career →</a> ·
      <a href={u("/george-pitt")}>His brother →</a> ·
      <a href={u("/obituary")}>His father's death →</a></p>
  </section>
</Base>
