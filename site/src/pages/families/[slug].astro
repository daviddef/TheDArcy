---
/* One surname, and every person of it this archive holds.
 *
 * /families/ has listed thirteen since it was written, each with a grid of
 * its people — because this archive can name them, and several reached
 * Queensland before the D'Arcys did. What it could not do was show a
 * household: a reader saw a hundred and sixteen Sneyds as a list of names
 * and not one marriage among them.
 *
 * Each family now has a page drawn with the same `Descent` row as the front
 * page — the couple in two equal columns, brothers and sisters under
 * whichever of the two they belong to, shut until opened.
 *
 * NO CHILDREN STRIP, ANYWHERE. This archive records siblings in two places
 * and children in none, in any file. The row shows what is there.
 *
 * SIBLINGS CARRY THE ID OF THE PAGE THEY HAVE, and the card links to it. The id
 * is the join and the name never is: people.js disambiguates its slugs because
 * «there are two George Pitt D'Arcys and three Conyers», and a card linked by
 * name is the merge those slugs exist to prevent.
 */
import Base from "../../layouts/Base.astro";
import Blk from "../../components/Blk.astro";
import Note from "../../components/Note.astro";
import Scroll from "../../components/Scroll.astro";
import Descent from "@daviddef/archive-kit/components/Descent.astro";
import FamilyLine from "../../components/FamilyLine.astro";
import { u } from "../../lib/url.js";
import famData from "../../data/families.json";
import ancestorRows from "../../data/ancestors.json";
import { people, duplicateOf } from "../../lib/people.js";
import { lineData, lineSlugs, clusterMembers, groupsFor } from "../../lib/familyLines.js";
import { CORRECTIONS, lifeOf, yearOf } from "../../lib/corrections.js";

/* TWO KINDS OF FAMILY PAGE, ONE ADDRESS SPACE. The thirteen in families.json
   (every bearer of the name in the tree is published) and the lines in
   family-lines.json (only people the archive already names; see
   src/lib/familyLines.js). A slug belongs to exactly one of them: the build
   stops if a line reuses a cluster's address. */
export function getStaticPaths() {
  const slug = (s) =>
    String(s).toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  const own = famData.map((f) => ({ params: { slug: slug(f.surname) }, props: { fam: f } }));
  const taken = new Set(own.map((x) => x.params.slug));
  const lines = lineSlugs.map((s) => {
    if (taken.has(s)) throw new Error(`family-lines.json: /families/${s}/ is already a cluster in families.json`);
    return { params: { slug: s }, props: { lineSlug: s } };
  });
  return [...own, ...lines];
}
const { fam: famProp, lineSlug } = Astro.props;
const line = lineSlug ? lineData(lineSlug) : null;
/* A cluster page and a line page draw their rows the same way. The members are
   the cluster's own records, or the line's published people. A declared copy
   (same-person.json) is one person entered twice and is listed once. */
const allMembers = famProp ? clusterMembers(famProp) : line.members;
const copies = allMembers.filter((m) => duplicateOf(m));
/* A NEW OBJECT, never the imported one: families.json is shared by every page that imports it, and
   writing the filtered list back changed what /sneyd/ drew later in the same build. */
const fam = { ...(famProp || { surname: line.surname, blurb: "" }), members: allMembers.filter((m) => !duplicateOf(m)) };

const SLUG_BY_ID = new Map(people.map((q) => [q.id, q.slug]));
const KIN_BY_ID = new Map();
for (const a of ancestorRows) KIN_BY_ID.set(a.id, a);
for (const f of famData) for (const m of (f.members || [])) if (!KIN_BY_ID.has(m.id)) KIN_BY_ID.set(m.id, m);
/* A line's people include relatives named beside someone, and a spouse who is
   one has her own brothers and sisters on her page: look her up among everybody
   with a page. (The thirteen clusters keep the narrower lookup they always had.) */
if (line) for (const q of people) if (!KIN_BY_ID.has(q.id)) KIN_BY_ID.set(q.id, q);

/* A card with no name is not a card. The export carries sibling and spouse
   records that hold a marriage, an id or a list of children and NO NAME —
   the tree knows the relationship and not the person. Dropping the empty
   ones here is why `String(x)` is nowhere below: the moment a fallback
   coerces a record to a string it renders «[object Object]», which is
   exactly what two of these thirteen pages were doing. */
const named = (x) => (typeof x === "string" ? x : (x && x.name) || "");
const nameCards = (xs) => (xs || [])
  .filter((x) => named(x))
  .map((x) => (typeof x === "string" ? { name: x } : {
    name: x.name,
    /* through the corrections, like every other page that prints a lifespan */
    dates: lifeOf({ slug: x.id ? SLUG_BY_ID.get(x.id) : "", life: x.life || "" }),
    href: x.id && SLUG_BY_ID.get(x.id) ? `/people/${SLUG_BY_ID.get(x.id)}/` : undefined }));

const yr = (x) => (String(x || "").match(/\b(1[4-9]\d\d|20\d\d)\b/) || [])[1];
/* the corrected year where the archive has overturned the tree for this field, else the tree's own value untouched */
const cy = (slug, field, raw) => (slug && CORRECTIONS[slug] && CORRECTIONS[slug][field] ? yearOf(slug, field, raw) : (raw || ""));

/* A LIVING PERSON IS A NAME, A RELATIONSHIP, A TOWN AND A COUNTRY. The first
   version of this page published forty-four of them under the rule that then
   was — nobody living at all — because it rendered every member and suppressed
   only their dates. check:living caught it before it left the machine. The rule
   is different now (src/lib/people.js, David's ruling of 16 October 2026) and
   this page is where it is honest rather than lucky: a living member's row
   carries a name, a spouse by name, brothers and sisters by name, and the town
   and country in the place column. The data holds no date for them to leak —
   tools/build_site_data.py builds them from nothing else — and the row below
   passes none: no era, no born, no died, no trade, no marriage date, no
   confidence. */
const makeRows = (members) => (members || [])
  .map((p) => {
    const spRaw = (p.spouses || [])[0] || null;
    /* AND A MARRIAGE WITHOUT A NAME IS STILL A MARRIAGE. Walter Sneyd,
       Ralph Sneyd and Francis Murdoch each have a spouse record with an id,
       a `children` list and an empty `name`: the tree holds the marriage and
       has never held the person. Those three rows rendered «[object
       Object]», because the row wrote `sp.name || sp` and the fallback
       reached the record itself. The marriage is kept and the name is not
       invented — `spouse` stays empty and the row says why. */
    const sp = spRaw && named(spRaw) ? spRaw : null;
    const unnamedMarriage = !!(spRaw && !named(spRaw));
    const herRec = sp && sp.id ? KIN_BY_ID.get(sp.id) : null;
    const slug = SLUG_BY_ID.get(p.id);
    const herSlug = sp && sp.id ? SLUG_BY_ID.get(sp.id) : null;
    const alive = !!p.living;
    return {
      name: p.name,
      href: slug ? `/people/${slug}/` : "",
      living: alive,
      /* THE YEARS COME THROUGH THE CORRECTIONS (lib/corrections.js). This page built each card from the
         tree's raw born and died, so it printed «b. 1769 d. 20 sep 1856» for a man the archive had found
         baptised in 1781 and buried in 1855. Where a field is corrected the card shows the corrected YEAR;
         everywhere else it shows what the tree says, exactly as before. */
      era: alive ? undefined : ([cy(slug, "born", p.born), cy(slug, "died", p.died)].map(yr).filter(Boolean).join(" → ") || undefined),
      born: alive ? "" : cy(slug, "born", p.born),
      died: alive ? "" : cy(slug, "died", p.died),
      trade: alive ? "" : (p.occupation || ""),
      place: alive ? (p.place || "") : (p.bornPlace || p.diedPlace || ""),
      married: alive || (sp && sp.living) ? "" : ((sp && sp.married) || (unnamedMarriage && spRaw.married) || ""),
      spouse: sp ? sp.name : "",
      spouseHref: sp && herSlug ? `/people/${herSlug}/` : null,
      spouseAlt: sp
        ? (herRec ? "" : "no record of her own family here")
        : unnamedMarriage
          ? "the tree records the marriage and has never held her name"
          : "no marriage recorded for them here",
      children: [],
      hisNone: line ? "No brothers or sisters are recorded for them here." : undefined,
      herNone: line ? (sp ? `No brothers or sisters are recorded for ${sp.name} here.`
                          : "No marriage is recorded for them here, so there is no second family to show.") : undefined,
      hisSiblings: nameCards(p.siblings),
      herSiblings: herRec ? nameCards(herRec.siblings) : [],
      hisLabel: String(p.name).split(" ")[0] + "’s",
      herLabel: sp ? sp.name.split(" ")[0] + "’s" : "Theirs",
      confidence: alive ? "" : ((p.sources || []).length ? "a record has been read" : ""),
    };
  });
/* A cluster is shown oldest first by its recorded birth; a line arrives already
   ordered (birth, then the years of life) by src/lib/familyLines.js. */
const ordered = line ? fam.members
  : fam.members.slice().sort((a, b) => (Number(yr(a.born)) || 9999) - (Number(yr(b.born)) || 9999));
const rows = makeRows(ordered);
/* THE GROUP TEST, ON A CLUSTER AS ON A LINE (lib/familyLines.js, groupsFor). A surname is not a family: a
   cluster whose published people the archive does not tie together says so, and draws them as separate
   groups. A cluster that is one group is drawn exactly as it always was. */
const cgroups = famProp ? groupsFor(ordered) : [];
/* A name the tree writes more than one way: the spellings as written (cut at a comma or bracket), and what
   the people it spells exactly like the cluster's name come to on their own. */
const cWritten = (() => {
  if (!famProp) return null;
  const ex = new Map();
  for (const m of ordered) {
    const w = String(m.surname || "").split(/[,(\[]/)[0].trim();
    /* capitals alone are not a spelling: D'Arcy, d'Arcy and D'ARCY are one */
    if (w) { const e = ex.get(w.toLowerCase()) || { n: 0, forms: new Map() }; e.n += 1; e.forms.set(w, (e.forms.get(w) || 0) + 1); ex.set(w.toLowerCase(), e); }
  }
  const base = (famProp.members || []).filter((m) => !duplicateOf(m));
  const baseGroups = groupsFor(base);
  const graft = cgroups.reduce((a, g) => { for (const [k, n] of Object.entries(g.grafts)) a[k] = (a[k] || 0) + n; return a; }, {});
  const spellings = [...ex.values()].map((e) => [[...e.forms.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))[0][0], e.n])
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  return { spellings, also: (famProp.alsoWritten || []).length,
           baseN: base.length, baseGroups, graft };
})();
const cfmt = (g) => [g.span && `${g.span[0]}\u2013${g.span[1]}`, g.places.length > 0 && `born at ${g.places.join(" \u00b7 ")}`,
  g.direct > 0 && `${g.direct} on the direct line`,
  ...Object.entries(g.grafts).map(([n, k]) => `${k} above the ${n} graft`)].filter(Boolean).join(" \u00b7 ") || "no dates or places recorded";

/* The line's one-sentence description, worked out from its data: how many, how
   many on the direct line, when, where. 200 characters is the ceiling the
   audit holds descriptions to. */
const lineDek = line ? (() => {
  const n = rows.length;
  const parts = [`${n} ${n === 1 ? "person" : "people"} named ${fam.surname} that this archive publishes`];
  if (line.direct.length) parts.push(`${line.direct.length} on the direct line`);
  if (line.span) parts.push(`${line.span[0]}\u2013${line.span[1]}`);
  let t = parts.join(", ") + ".";
  if (t.length > 190) t = t.slice(0, 187).replace(/[\s,;]+\S*$/, "") + "\u2026";
  return t;
})() : "";

---
<Base
  title={fam.surname}
  eyebrow={line ? `${rows.length} published${line.direct.length ? " · carried by the direct line" : ""}` : (copies.length ? `${rows.length} published · ${copies.length} declared ${copies.length === 1 ? "copy" : "copies"} not listed` : `${fam.published ?? rows.length} published of ${fam.total ?? rows.length}`)}
  dek={line ? lineDek : (fam.blurb || `Everyone this archive holds under the name ${fam.surname}.`)}>

  <section class="blk">
    <p class="cap"><a href={u("/families/")}>&larr; The families</a></p>
  </section>

  {/* the family's own generations and how our line connects (src/components/FamilyLine.astro; 27 October 2026) */}
  <FamilyLine id={Astro.params.slug} />

  {line && (
    <Fragment>
      <section class="blk">
        <p class="lede"><strong>{rows.length}</strong> {rows.length === 1 ? "person" : "people"} named
        <strong> {fam.surname}</strong> {rows.length === 1 ? "is" : "are"} published in this archive:
        {" "}{line.dead.length} dead{line.living.length > 0 && <>, and {line.living.length} living, named
        with their town and country only</>}.
        {line.direct.length > 0
          ? <> <strong>{line.direct.length}</strong> {line.direct.length === 1 ? "is" : "are"} on the
            direct line, the spine this archive is built on.</>
          : <> None is on the direct line.</>}
        {line.span && <> The dead lived between {line.span[0]} and {line.span[1]}.</>}
        {line.places.length > 0 && <> Where the tree says they were born: {line.places.slice(0, 6).map((x, i) => (
          <Fragment>{i > 0 && " \u00b7 "}{x.name}{x.n > 1 && ` (${x.n})`}</Fragment>))}.</>}</p>
        {line.spellings.length > 1 && (
          <p class="dek" style="margin-top:.8rem">The tree writes the name
          {" "}{line.spellings.map((x, i) => (
            <Fragment>{i > 0 && (i === line.spellings.length - 1 ? " and " : ", ")}<strong>{x.written}</strong> ({x.n})</Fragment>))}.
          {line.titled.length > 0
            ? <> {line.titled.map((x) => x.written).join(" and ")} is a title the tree writes where the surname
              should be, for people whose own names are {fam.surname}.</>
            : <> This page shows them together as one name.</>}
          {line.shifts.length > 0 && <> The direct line itself changes spelling inside it, as set out below.</>}</p>
        )}
        {line.twice.length > 0 && (
          <Note>
            <strong>Entered twice.</strong> The tree enters
            {line.twice.map((v, i) => (
              <Fragment>{i > 0 && (i === line.twice.length - 1 ? " and " : ", ")} <strong>{v[0].name}</strong> ({v[0].life}){" "}
                <span class="small">(<a href={u(`/people/${v[0].slug}/`)}>entry 1</a>, <a href={u(`/people/${v[1].slug}/`)}>entry 2</a>)</span></Fragment>))}
            {" "}twice, with the same name, the same years and the same {line.twice.some((v) => (v[0].parents || []).length) ? "parents or birthplace" : "birthplace"}.
            This archive has not declared either entry a copy of the other,
            so both are listed as the tree lists them, and the count above counts both.
          </Note>
        )}
        <Note>
          <strong>What this page lists.</strong> Only people this archive already names: the direct line and
          the relatives named beside them. It is not everyone of the name in the family tree, and it
          adds no one. A name is not a family: where the people below are not tied together by
          anyone the archive publishes, they are shown as separate groups, and the page does not say
          they are one family.
        </Note>
      </section>

      <Blk label="How we know" title="What stands behind these people">
        <p class="dek">This archive grades each person by what it has established about them, and
        nothing else. For the {line.dead.length} {line.dead.length === 1 ? "person" : "people"} of this name who
        {line.dead.length === 1 ? " is" : " are"} dead:</p>
        <ul class="small" style="margin:.6rem 0 0;padding-left:1.1rem">
          {line.tally.documented > 0 && <li style="margin-top:.35rem"><span class="chip doc">documented</span>
            {" "}<strong>{line.tally.documented}</strong> &mdash; a record this archive has read writes down a
            relationship for them.</li>}
          {line.tally.disputed > 0 && <li style="margin-top:.35rem"><span class="chip sup">above a graft</span>
            {" "}<strong>{line.tally.disputed}</strong> &mdash; reached only through
            {Object.entries(line.grafts).map(([g, n], i) => (
              <Fragment>{i > 0 && " and through"} the <strong>{g}</strong> join ({n}){g === "Hornby"
                ? <>, a single unevidenced link that this archive has looked for and not found (<a href={u("/hornby/")}>the Hornby claim</a>)</>
                : g === "Keele"
                  ? <>, a link this archive has looked for in the right registers and found to be wrong (<a href={u("/how-far-back/")}>how far back</a>)</>
                  : null}</Fragment>))}.</li>}
          {line.tally.family > 0 && <li style="margin-top:.35rem"><span class="chip lore">family tree only</span>
            {" "}<strong>{line.tally.family}</strong> &mdash; asserted by the family tree, with nothing
            found for them either way.</li>}
        </ul>
        <p class="small" style="margin-top:.8rem">{line.records > 0
          ? <><strong>{line.records}</strong> {line.records === 1 ? "record that names" : "records that name"} someone of
            this name {line.records === 1 ? "has" : "have"} been read; {line.records === 1 ? "it is" : "they are"} set out
            on the people&rsquo;s own pages. </>
          : <>No record naming anyone of this name has been read. </>}
        A family tree is a witness and not a source, and that is why the grade is printed here and
        not left to be assumed. <a href={u("/method/")}>How claims are labelled &rarr;</a></p>
      </Blk>

      {line.direct.length > 0 && (
        <Blk label="The direct line" title={`Where ${fam.surname} meets the spine`}>
          <Scroll>
            <table>
              <thead><tr><th>Number</th><th>Generation</th><th>Person</th><th>Parent of</th></tr></thead>
              <tbody>
                {line.direct.map((d) => (
                  <tr>
                    <td class="m">{d.ahn}</td>
                    <td class="m">{d.gen}</td>
                    <td>{d.slug ? <a href={u(`/people/${d.slug}/`)}>{d.name}</a> : "a living person"}</td>
                    <td>{d.childName
                      ? <Fragment><a href={u(`/people/${d.childSlug}/`)}>{d.childName}</a> <span class="small">(number {d.childAhn})</span></Fragment>
                      : <span class="small">the next generation of the direct line</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </Scroll>
          {line.shifts.length > 0 && (
            <Fragment>
              <p class="small" style="margin-top:.8rem">The spelling changes inside the direct line:</p>
              <ul class="small" style="margin:.3rem 0 0;padding-left:1.1rem">
                {line.shifts.filter((d) => d.name && d.childName).map((d) => (
                  <li style="margin-top:.3rem">{d.name} (number {d.ahn}), written &ldquo;{d.spelledAs}&rdquo; in the tree, is the
                  {d.sex === "F" ? " mother" : " father"} of {d.childName} (number {d.childAhn}), written &ldquo;{d.childSpelledAs}&rdquo;.</li>))}
              </ul>
            </Fragment>
          )}
          <p class="small" style="margin-top:.6rem"><a href={u("/direct-line/")}>The spine, generation by generation &rarr;</a></p>
        </Blk>
      )}

      {line.joined.length > 0 && (
        <Blk label="Connections" title="The families it is joined to">
          <p class="dek">Worked out from the marriages and the parents of the people below, where the
          other person has a different surname. A name that links has a page of its own here.</p>
          <ul class="small" style="margin:.6rem 0 0;padding-left:1.1rem">
            {line.joined.slice(0, 14).map((j) => (
              <li style="margin-top:.35rem">
                {j.href ? <a href={u(j.href)}>{j.label}</a> : <strong>{j.label}</strong>}
                {" "}&mdash; {[j.spouses > 0 && `${j.spouses} ${j.spouses === 1 ? "marriage" : "marriages"}`,
                  j.parents > 0 && `${j.parents} ${j.parents === 1 ? "parent" : "parents"}`].filter(Boolean).join(", ")}
              </li>
            ))}
          </ul>
          {line.joined.length > 14 && <p class="small" style="margin-top:.6rem">&hellip; and {line.joined.length - 14} other names, none with a page here.</p>}
        </Blk>
      )}

      <Blk label="The people" title={`Everyone of the name, as far as the archive names them`}>
        {line.groups.length > 1 && (
          <p class="dek">These {rows.length} people fall into <strong>{line.groups.length} groups</strong> that
          the published people do not tie to one another &mdash; no shared parent, brother or sister, spouse or
          child among the people this archive names. The tree may tie them in ways it does not publish, and
          nothing this archive holds says they are one family.</p>
        )}
        {line.groups.map((g, i) => (
          <Fragment>
            {line.groups.length > 1 && (
              <Fragment>
                <h3 style="margin-top:1.6rem">Group {i + 1} &mdash; {g.n} {g.n === 1 ? "person" : "people"}</h3>
                <p class="small">{[g.span && `${g.span[0]}\u2013${g.span[1]}`, g.places.length > 0 && `born at ${g.places.join(" \u00b7 ")}`,
                  g.direct > 0 && `${g.direct} on the direct line`].filter(Boolean).join(" \u00b7 ") || "no dates or places recorded"}</p>
              </Fragment>
            )}
            <Descent rows={makeRows(g.members)} u={u} archiveKey="darcy" idPrefix={`g${i + 1}-`} />
          </Fragment>
        ))}
        <p class="small" style="margin-top:1rem">There is no children strip on these rows: this archive records
        siblings and records no children, and the row shows what is there.
        {line.living.length > 0 && <> A living person is named here with their relationships and their town
        and country, and nothing more.</>}</p>
      </Blk>
    </Fragment>
  )}

  {!line && (
  <section class="blk">
    <h2>Everyone of the name</h2>
    {rows.length === 0 ? (
      <p class="dek">This archive holds <strong>no published people</strong> under
      <strong>{fam.surname}</strong> yet.</p>
    ) : (
      <Fragment>
        <p class="dek">{cgroups.length > 1 ? "" : "All "}<strong>{rows.length}</strong> people this archive publishes under
        <strong>{fam.surname}</strong>, oldest first{cgroups.length > 1 ? " within each group" : ""}, in the shape the front page uses &mdash; the
        couple in two equal columns, brothers and sisters under whichever of the two they belong to.
        Everything is shut until you open it. <strong>There is no children strip</strong> on any of
        these rows: this archive records siblings and records no children, anywhere, and the row
        shows what is there.</p>
        {cgroups.length > 1 && (
          <p class="dek">These {rows.length} people fall into <strong>{cgroups.length} groups</strong> that
          the published people do not tie to one another &mdash; no shared parent, brother or sister, spouse or
          child among the people this archive names. The tree may tie them in ways it does not publish, and
          nothing this archive holds says they are one family under this name.</p>
        )}
        {cWritten && cWritten.spellings.length > 1 && (
          <Note>
            <strong>The name, written other ways.</strong> The tree writes this name
            {" "}{cWritten.spellings.map(([w, n], i) => (
              <Fragment>{i > 0 && (i === cWritten.spellings.length - 1 ? " and " : ", ")}<strong>{w}</strong> ({n})</Fragment>))}.
            This page shows them together as one name, and lists only people this archive already publishes.
            {cWritten.baseGroups.length > 1 && cgroups.length < cWritten.baseGroups.length && <>
              {" "}Counting only the {cWritten.baseN} people the tree spells {fam.surname}, whatever the capitals, they fall into
              <strong> {cWritten.baseGroups.length} groups</strong> ({cWritten.baseGroups.map((g) => g.n).join(" and ")} people)
              that the published people do not tie to one another; the {cWritten.also} written another way are what tie
              {cgroups.length === 1 ? " them into one group" : " some of them together"} here.</>}
          </Note>
        )}
        {cWritten && Object.keys(cWritten.graft).length > 0 && (
          <Note>
            <strong>Above a graft.</strong>
            {Object.entries(cWritten.graft).map(([g, n]) => (
              <Fragment> {n} of these {n === 1 ? "person is" : "people are"} reached only through the <strong>{g}</strong> join{g === "Hornby"
                ? <>, a single unevidenced link that this archive has looked for and not found (<a href={u("/hornby/")}>the Hornby claim</a>)</>
                : g === "Keele"
                  ? <>, a link this archive has looked for in the right registers and found to be wrong (<a href={u("/how-far-back/")}>how far back</a>)</>
                  : null}.</Fragment>))}
          </Note>
        )}
        {copies.length > 0 && (
          <p class="small">{copies.length} {copies.length === 1 ? "person the tree enters" : "people the tree enters"} twice
          {copies.length === 1 ? " is" : " are"} listed once: the archive has declared the second entry a copy of the
          first (<a href={u("/method/")}>how</a>), and its page is still there.</p>
        )}
        {cgroups.length > 1
          ? cgroups.map((g, i) => (
              <Fragment>
                <h3 style="margin-top:1.6rem">Group {i + 1} &mdash; {g.n} {g.n === 1 ? "person" : "people"}</h3>
                <p class="small">{cfmt(g)}</p>
                <Descent rows={makeRows(g.members)} u={u} archiveKey="darcy" idPrefix={`g${i + 1}-`} />
              </Fragment>))
          : <Descent rows={rows} u={u} archiveKey="darcy" />}
      </Fragment>
    )}
  </section>
  )}
</Base>
