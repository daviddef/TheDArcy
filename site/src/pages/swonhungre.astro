---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import d from "../data/swonhungre.json";
---
<Base
  title="The name in its own century"
  eyebrow={`Berkeley, 1272–1741 · 195 records · found ${d.found}`}
  dek="Smyth's pedigree of the Swonhungers, checked against the deeds Smyth was reading — and one generation he did not print.">

  <section class="blk">
    <p class="lede">{d.lede}</p>
  </section>

  <Blk label="Method" title={d.how.head}>
    <p class="lede">{d.how.body}</p>
    <Scroll>
      <table>
        <thead><tr><th>Spelling searched</th><th class="m">Records</th><th>What it is</th></tr></thead>
        <tbody>{d.how.rows.map(([s, n, w]) => (
          <tr><td><strong class="mono">{s}</strong></td><td class="m">{n}</td><td class="small">{w}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="margin-top:1.2rem">{d.how.means} <span class="chip doc">{d.how.chip}</span></Note>
  </Blk>

  <Blk label={d.formation.ref} title={d.formation.head}>
    <Note style="border-left-width:3px">
      <strong style="font-size:1.15em">{d.formation.quote}</strong>
      <span class="chip doc">{d.formation.chip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.formation.body}</p>
    <Note style="margin-top:1.2rem">{d.formation.means}</Note>

    <h3 style="margin-top:1.8rem">{d.formation.ashHead}</h3>
    <Note style="border-left-width:3px;margin-top:.8rem">
      <strong>{d.formation.ash}</strong> <span class="chip inf">{d.formation.ashChip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.formation.ashMeans}</p>
    <Note style="margin-top:1.1rem"><strong>And what it is not.</strong> {d.formation.ashCare}</Note>
  </Blk>

  <Blk label={d.identity.ref} title={d.identity.head}>
    <p class="lede">{d.identity.body}</p>
    <Note style="margin-top:1.2rem">{d.identity.means}
      {" "}<span class="chip doc">{d.identity.chip}</span></Note>
  </Blk>

  <Blk label="The Berkeley deeds" title={d.pedigree.head}>
    <p class="lede">{d.pedigree.lede}</p>
    <Scroll>
      <table>
        <thead><tr><th>Reference</th><th class="m">Date</th><th>What it says</th><th>Effect</th></tr></thead>
        <tbody>{d.pedigree.rows.map(([r, dt, t, e]) => (
          <tr><td class="small mono" style="white-space:nowrap">{r}</td>
              <td class="m" style="white-space:nowrap">{dt}</td>
              <td class="small">{t}</td>
              <td class="small"><strong>{e}</strong></td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      <strong>The generation that was not there.</strong> {d.pedigree.gain}
    </Note>
    <p style="margin-top:1.1rem">{d.pedigree.means}
      {" "}<span class="chip doc">{d.pedigree.chip}</span></p>
    <Note style="margin-top:1.2rem"><strong>And what has not been seen.</strong> {d.pedigree.caveat}</Note>
    <p class="small" style="margin-top:1rem"><a href={u("/saniger-place/")}>Smyth's pedigree, as this archive had it →</a></p>
  </Blk>

  <Blk label={d.alice.ref} title={d.alice.head}>
    <Note style="border-left-width:3px">
      <strong style="font-size:1.1em">{d.alice.body}</strong>
      <span class="chip doc">{d.alice.chip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.alice.means}</p>
    <Note style="margin-top:1.2rem"><strong>{d.alice.wykeHead}.</strong> {d.alice.wyke}</Note>
    <Note style="margin-top:1.2rem"><strong>{d.alice.whereHead}.</strong> {d.alice.where}</Note>
    <p class="small" style="margin-top:1rem"><a href={u("/the-women/")}>The women this archive can name →</a></p>
  </Blk>

  <Blk label={d.fish.ref} title={d.fish.head}>
    <p class="lede">{d.fish.body}</p>
    <Note style="margin-top:1.2rem">{d.fish.means}
      {" "}<span class="chip doc">{d.fish.chip}</span></Note>
  </Blk>

  <Blk label="After 1401" title={d.later.head}>
    <p class="lede">{d.later.lede}</p>
    <Scroll>
      <table>
        <thead><tr><th>Reference</th><th class="m">Date</th><th>What it is</th></tr></thead>
        <tbody>{d.later.rows.map(([r, dt, t]) => (
          <tr><td class="small mono" style="white-space:nowrap">{r}</td>
              <td class="m" style="white-space:nowrap">{dt}</td>
              <td class="small">{t}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="margin-top:1.2rem">{d.later.means}
      {" "}<span class="chip doc">{d.later.chip}</span></Note>
  </Blk>

  <Blk label="The National Archives" title={d.kew.head}>
    <Scroll>
      <table>
        <thead><tr><th>Reference</th><th class="m">Date</th><th>What it is</th></tr></thead>
        <tbody>{d.kew.rows.map(([r, dt, t]) => (
          <tr><td class="small mono" style="white-space:nowrap">{r}</td>
              <td class="m" style="white-space:nowrap">{dt}</td>
              <td class="small">{t}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="margin-top:1.2rem">{d.kew.means}
      {" "}<span class="chip doc">{d.kew.chip}</span></Note>
  </Blk>

  <Blk label={d.wardship.ref} title={d.wardship.head}>
    <Note style="border-left-width:3px">
      <strong style="font-size:1.1em">{d.wardship.quote}</strong>
      <span class="chip doc">{d.wardship.chip}</span>
    </Note>
    <p style="margin-top:1.2rem">{d.wardship.means}</p>
    <Note style="margin-top:1.2rem">
      <strong>{d.wardship.whyHead}.</strong> {d.wardship.why}
    </Note>
  </Blk>

  <Blk label="Drawn, not described" title={d.chart.head}>
    <p class="lede">{d.chart.lede}</p>

    <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:1rem">
      {d.chart.legend.map(([c, style, what]) => (
        <span class="small" style="display:inline-flex;align-items:center;gap:7px">
          <svg width="30" height="8" aria-hidden="true"><line x1="0" y1="4" x2="30" y2="4"
            stroke={c} stroke-width="2" stroke-dasharray={style === "dashed" ? "5 4" : "0"} /></svg>
          {what}</span>))}
    </div>

    <Scroll>
      <svg viewBox="0 0 700 620" role="img" width="700"
           aria-label="The descent of the Swonhungre family from the 1260s to 1402, with the Stone line it married into"
           style="margin-top:1.3rem;max-width:100%;height:auto">
        <title>The Swonhungre descent, 1260s to 1402</title>
        {d.chart.links.map(([a, b, g]) => {
          const A = d.chart.rows[a], B = d.chart.rows[b];
          const x1 = 20 + A.col * 232 + 96, y1 = 24 + A.y * 56 + 34;
          const x2 = 20 + B.col * 232 + 96, y2 = 24 + B.y * 56;
          return <path d={`M${x1} ${y1} V${(y1 + y2) / 2} H${x2} V${y2}`} fill="none"
                       stroke={g === "doc" ? "#1E5F8C" : "#B04A16"} stroke-width="2"
                       stroke-dasharray={g === "doc" ? "0" : "5 4"} />;
        })}
        {d.chart.rows.map((r) => (
          <g transform={`translate(${20 + r.col * 232}, ${24 + r.y * 56})`}>
            <rect width="192" height="34" rx="3" fill="var(--panel)" stroke="var(--rule)" />
            <text x="8" y="14" font-size="11.5" font-weight="600" fill="var(--ink)">{r.t}</text>
            <text x="8" y="27" font-size="9" fill="var(--ink-3)">{r.s.length > 46 ? r.s.slice(0, 45) + "…" : r.s}</text>
          </g>
        ))}
      </svg>
    </Scroll>

    <Note style="margin-top:1.3rem"><strong>Who is not on it, and why.</strong> {d.chart.note}</Note>
    <Note style="margin-top:1.2rem">{d.chart.disagree}</Note>
  </Blk>

  <Blk label="All 200 Berkeley records" title={d.deeds.head}>
    <p class="lede">{d.deeds.lede}</p>
    <Scroll>
      <table>
        <thead><tr><th>Reference</th><th class="m">Date</th><th>What it says</th><th>What it adds</th></tr></thead>
        <tbody>{d.deeds.rows.map(([r, dt, t, e]) => (
          <tr><td class="small mono" style="white-space:nowrap">{r}</td>
              <td class="m" style="white-space:nowrap">{dt}</td>
              <td class="small">{t}</td>
              <td class="small"><strong>{e}</strong></td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      {d.deeds.means} <span class="chip doc">{d.deeds.chip}</span>
    </Note>
    <Note style="margin-top:1.2rem">
      <strong>{d.deeds.careHead}.</strong> {d.deeds.care}
    </Note>
  </Blk>

  <Blk label="The roads and the fields" title={d.ways.head}>
    <p class="lede">{d.ways.lede}</p>
    <Scroll>
      <table>
        <thead><tr><th class="m">Date</th><th>Reference</th><th>What it describes</th></tr></thead>
        <tbody>{d.ways.rows.map(([dt, r, t]) => (
          <tr><td class="m" style="white-space:nowrap">{dt}</td>
              <td class="small mono" style="white-space:nowrap">{r}</td>
              <td class="small">{t}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <h3 style="margin-top:1.7rem">{d.ways.fieldHead}</h3>
    <Note style="border-left-width:3px;margin-top:.8rem">
      <strong>{d.ways.field}</strong> <span class="chip inf">{d.ways.fieldChip}</span>
    </Note>
    <Note style="margin-top:1.1rem"><strong>And what it is not.</strong> {d.ways.fieldCare}</Note>
  </Blk>

  <Blk label="Smyth of Nibley, about 1639" title={d.smyth3.head}>
    <p class="lede">{d.smyth3.lede}</p>
    <Scroll>
      <table>
        <tbody>{d.smyth3.rows.map(([k, v]) => (
          <tr><td style="white-space:nowrap;vertical-align:top;max-width:15rem"><strong class="small">{k}</strong></td>
              <td class="small">{v}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="margin-top:1.3rem">{d.smyth3.means}
      {" "}<span class="chip doc">{d.smyth3.chip}</span></Note>
  </Blk>

  <Blk label="TBGAS vol. VI, read entire" title={d.cookefull.head}>
    <p class="lede">{d.cookefull.lede}</p>

    <h3 style="margin-top:1.7rem">{d.cookefull.srcHead}</h3>
    <Note style="border-left-width:3px;margin-top:.8rem">
      <strong>{d.cookefull.src}</strong> <span class="chip doc">{d.cookefull.srcChip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.cookefull.srcMeans}</p>

    <h3 style="margin-top:1.9rem">{d.cookefull.estateHead}</h3>
    <Scroll>
      <table style="margin-top:.8rem">
        <tbody>{d.cookefull.estate.map(([w, t]) => (
          <tr><td class="m" style="white-space:nowrap;vertical-align:top"><strong>{w}</strong></td>
              <td class="small">{t}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      {d.cookefull.estateMeans} <span class="chip doc">{d.cookefull.estateChip}</span>
    </Note>

    <Note style="margin-top:1.2rem"><strong>{d.cookefull.leadHead}.</strong> {d.cookefull.lead}</Note>
    <Note style="margin-top:1.2rem"><strong>{d.cookefull.careHead}.</strong> {d.cookefull.care}</Note>
  </Blk>

  <Blk label="BCM/A/1/24/189–190" title={d.stones.head}>
    <p class="lede">{d.stones.lede}</p>
    <div style="margin-top:1.1rem;display:flex;flex-direction:column;gap:1rem">
      {d.stones.rows.map(([r, dt, txt]) => (
        <div style="border-left:2px solid var(--rule);padding-left:14px">
          <strong class="small mono">{r}</strong>
          <span class="small" style="margin-left:.5rem;color:var(--ink-3)">{dt}</span>
          <p class="small" style="margin:.3rem 0 0;color:var(--ink-2)">{txt}</p>
        </div>))}
    </div>
    <Note style="border-left-width:3px;margin-top:1.3rem">
      {d.stones.means} <span class="chip doc">{d.stones.chip}</span>
    </Note>

    <h3 style="margin-top:1.8rem">{d.stones.lineHead}</h3>
    <Scroll>
      <table style="margin-top:.8rem">
        <tbody>{d.stones.line.map(([who, what]) => (
          <tr><td style="white-space:nowrap;vertical-align:top"><strong class="small">{who}</strong></td>
              <td class="small">{what}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="margin-top:1.2rem"><strong>{d.stones.fieldHead}.</strong> {d.stones.field}</Note>
  </Blk>

  <Blk label="TBGAS vol. VI, 1881–82" title={d.cooke.head}>
    <p class="lede">{d.cooke.lede}</p>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      <strong style="font-size:1.15em">{d.cooke.quote}</strong>
      <span class="chip inf">{d.cooke.chip}</span>
    </Note>
    <p class="small" style="margin-top:.8rem;color:var(--ink-3)">{d.cooke.src}</p>
    <p style="margin-top:1.2rem">{d.cooke.means}</p>
    <Note style="margin-top:1.2rem">
      <strong>{d.cooke.careHead}.</strong> {d.cooke.care}
      {" "}<a href={u("/errands/")}>What would settle it →</a>
    </Note>

    <h3 style="margin-top:1.9rem">{d.cooke.descHead}</h3>
    <div style="margin-top:.9rem;display:flex;flex-direction:column;gap:.9rem">
      {d.cooke.desc.map(([who, what]) => (
        <div style="border-left:2px solid var(--rule);padding-left:14px">
          <strong class="small">{who}</strong>
          <p class="small" style="margin:.3rem 0 0;color:var(--ink-2)">{what}</p>
        </div>))}
    </div>
    <Note style="margin-top:1.2rem"><strong>Where the two printed accounts disagree.</strong> {d.cooke.descNote}</Note>

    <Note style="margin-top:1.3rem">
      <strong>{d.cooke.towerHead}.</strong> {d.cooke.tower}
      {" "}<span class="chip doc">{d.cooke.towerChip}</span>
    </Note>
  </Blk>

  <Blk label="TBGAS, 67 volumes swept" title={d.tbgas.head}>
    <p class="lede">{d.tbgas.lede}</p>

    <h3 style="margin-top:1.8rem">{d.tbgas.v22Head}</h3>
    <p style="margin-top:.6rem">{d.tbgas.v22Lede}</p>
    <div style="margin-top:1.1rem;display:flex;flex-direction:column;gap:1rem">
      {d.tbgas.v22.map(([h, txt]) => (
        <div style="border-left:2px solid var(--rule);padding-left:14px">
          <strong class="small">{h}</strong>
          <p class="small" style="margin:.3rem 0 0;color:var(--ink-2)">{txt}</p>
        </div>))}
    </div>
    <Note style="border-left-width:3px;margin-top:1.3rem">
      {d.tbgas.v22Means} <span class="chip doc">{d.tbgas.v22Chip}</span>
    </Note>

    <h3 style="margin-top:2rem">{d.tbgas.v10Head}</h3>
    <p style="margin-top:.6rem">{d.tbgas.v10Lede}</p>
    <Scroll>
      <table style="margin-top:1rem">
        <thead><tr><th>Person</th><th class="m">Dates given</th><th>Marriage or note</th></tr></thead>
        <tbody>{d.tbgas.v10.map(([who, dt, note]) => (
          <tr><td><strong>{who}</strong></td>
              <td class="m small" style="white-space:nowrap">{dt}</td>
              <td class="small">{note}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <p class="small" style="margin-top:.9rem;color:var(--ink-3)">{d.tbgas.v10Src}</p>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      {d.tbgas.v10Means} <span class="chip doc">{d.tbgas.v10Chip}</span>
    </Note>

    <Note style="margin-top:1.3rem">
      <strong>{d.tbgas.twistHead}.</strong> {d.tbgas.twist}
      {" "}<span class="chip doc">{d.tbgas.twistChip}</span>
    </Note>
    <h3 style="margin-top:2rem">{d.tbgas.chantryHead}</h3>
    <Note style="border-left-width:3px;margin-top:.8rem">
      <strong>{d.tbgas.chantry}</strong> <span class="chip doc">{d.tbgas.chantryChip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.tbgas.chantryMeans}</p>
    <Note style="margin-top:1.2rem"><strong>{d.tbgas.careHead}.</strong> {d.tbgas.care}</Note>

    <Note style="margin-top:1.2rem"><strong>{d.tbgas.minorHead}.</strong> {d.tbgas.minor}</Note>
  </Blk>

  <Blk label="Library of Birmingham, MS 3549" title={d.smythsown.head}>
    <p class="lede">{d.smythsown.lede}</p>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      <strong style="font-size:1.05em">{d.smythsown.quote}</strong>
      <span class="chip doc">{d.smythsown.chip}</span>
    </Note>
    <p class="small" style="margin-top:.8rem;color:var(--ink-3)">{d.smythsown.src}</p>
    <p style="margin-top:1.2rem">{d.smythsown.means}</p>

    <h3 style="margin-top:1.8rem">{d.smythsown.leadHead}</h3>
    <Scroll>
      <table style="margin-top:.8rem">
        <thead><tr><th>Reference</th><th class="m">Date</th><th>What it is</th></tr></thead>
        <tbody>{d.smythsown.lead.map(([r, dt, t]) => (
          <tr><td class="small mono" style="white-space:nowrap">{r}</td>
              <td class="m" style="white-space:nowrap">{dt}</td>
              <td class="small">{t}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="margin-top:1.2rem">{d.smythsown.leadMeans}
      {" "}<span class="chip doc">{d.smythsown.leadChip}</span></Note>
    <p class="small" style="margin-top:1rem"><a href={u("/errands/")}>What it would take to read it →</a></p>
  </Blk>

  <Blk label="Rudder 1779 · Bigland 1791" title={d.histories.head}>
    <p class="lede">{d.histories.lede}</p>
    <Scroll>
      <table>
        <thead><tr><th>Authority</th><th class="m">Verdict</th><th>What it says</th></tr></thead>
        <tbody>{d.histories.rows.map(([who, v, what]) => (
          <tr><td style="white-space:nowrap"><strong>{who}</strong></td>
              <td class="m"><strong>{v}</strong></td>
              <td class="small">{what}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="border-left-width:3px;margin-top:1.3rem">
      {d.histories.means} <span class="chip doc">{d.histories.chip}</span>
    </Note>
    <h3 style="margin-top:1.8rem">{d.histories.thorpHead}</h3>
    <Note style="margin-top:.8rem"><strong>{d.histories.thorp}</strong>
      {" "}<span class="chip doc">{d.histories.thorpChip}</span></Note>
    <p style="margin-top:1.1rem">{d.histories.thorpMeans}</p>
  </Blk>

  <section class="blk" style="border-bottom:0">
    <h2>{d.limits.head}</h2>
    <p class="lede" style="margin-top:1rem">{d.limits.body}</p>
    <Note style="margin-top:1.3rem"><strong>The join still missing.</strong> {d.limits.gap}
      {" "}<span class="chip lore">{d.limits.chip}</span></Note>
    <p class="small" style="margin-top:1.4rem">
      <a href={u("/saniger-place/")}>Saniger, the place →</a> ·
      <a href={u("/saniger-1608/")}>The muster of 1608 →</a> ·
      <a href={u("/sanigers/")}>The Sanigers →</a> ·
      <a href={u("/worklist/")}>What is being done →</a></p>
  </section>
</Base>
