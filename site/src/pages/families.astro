---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Scroll from "../components/Scroll.astro";
import Families from "@daviddef/archive-kit/components/Families.astro";
import { u } from "../lib/url.js";
import { publishable, countLiving, isLiving, duplicateOf } from "../lib/people.js";
import families from "../data/families.json";
import { byId } from "../lib/people.js";
import { allLines, lineCfg, clusterMembers, groupsFor, unplacedData } from "../lib/familyLines.js";
import falcoFamilies from "../data/falco-families.json";

/* A declared copy (same-person.json) is one person entered twice: counted and
   listed once, here as on the family's own page. */
/* A cluster's people include those whose surname is the same name written another way (alsoWritten,
   built by tools/build_site_data.py); where there are any, the whole list is put back in order of birth. */
const yr0 = (x) => +((String(x || "").match(/\b(1[4-9]\d\d|20\d\d)\b/) || [])[1]) || 9999;
const fams = families
  .map((f) => ({ ...f, members: (f.alsoWritten && f.alsoWritten.length
    ? clusterMembers(f).slice().sort((a, b) => yr0(a.born) - yr0(b.born)) : f.members).filter((m) => !duplicateOf(m)) }))
  .map((f) => ({ ...f, published: f.members.length, living: countLiving(f.members) }))
  .filter((f) => f.published > 0);
const total = fams.reduce((a, f) => a + f.published, 0);
const lines = allLines();
const un = unplacedData();
const placed = un.cluster + un.line;
const nOther = un.otherNames.length;
const nf = (n) => n.toLocaleString("en-GB");

/* 22 September 2026. The card is the kit's. What this archive puts behind
   the claim is not: it can NAME the people, which Blazevic cannot and Falco
   does not try to — Falco draws the marriages instead, because that is what
   its joins rest on. Three archives, one argument, three kinds of evidence,
   and the component requires none of them. */
const famSlug = (x) =>
  String(x).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const groups = [{
  rows: fams.map((f) => {
    const places = [...new Set(f.members.filter((m) => m.bornPlace)
      .map((m) => m.bornPlace.split(",").slice(-2).join(",").trim()))].slice(0, 4);
    const shown = publishable(f.members).slice(0, 12);
    return {
      label: f.surname,
      gloss: f.blurb,
      count: f.published,
      countLabel: "published" + (countLiving(f.members) > 0
        ? ` · ${countLiving(f.members)} living, named with town and country only` : "")
        + (groupsFor(f.members).length > 1 ? ` · ${groupsFor(f.members).length} separate groups` : ""),
      facts: places.length ? [["Recorded in", places.join(" · ")]] : [],
      people: shown.map((m) => {
        const o = byId.get(m.id);
        return { name: m.name, href: o ? `/people/${o.slug}` : null,
                 life: isLiving(m) ? "" : ((o && o.life) || m.life),
                 place: isLiving(m) ? (m.place || null)
                        : (m.bornPlace ? m.bornPlace.split(",")[0] : null) };
      }),
      /* Each family now has a page of its own listing every person of the
         name as a Descent row, so "and N more" points there rather than at
         the whole register. */
      more: f.published > 12
        /* A PLAIN PATH HERE, NOT u(). The Families component rewrites
           href="/… onto the archive's base itself, so calling u() as well
           produced /TheDArcy/TheDArcy/families/… — the double-basing this
           estate has met twice before. `href` below stays plain for the
           same reason: the component passes it through u(). */
        ? `and ${f.published - 12} more — <a href="/families/${famSlug(f.surname)}/">all ${f.published} of the name</a>` : null,
      href: `/families/${famSlug(f.surname)}/`,
      hrefLabel: "Everyone of the name",
    };
  }),
},
/* THE LINES (src/data/family-lines.json). Names the direct line carries that
   have no cluster above. Their people are only those the archive already names,
   so the card says "published", never "of the name". Every figure is counted. */
{
  label: "More names on the line",
  note: "names carried by the direct line, drawn only from the people this archive already names",
  rows: lines.map((l) => {
    const fam = l.surname;
    const shown = publishable(l.members).slice(0, 8);
    return {
      label: fam,
      gloss: [l.direct.length ? `${l.direct.length} on the direct line` : "",
              l.span ? `${l.span[0]}\u2013${l.span[1]}` : ""].filter(Boolean).join(" \u00b7 "),
      count: l.members.length,
      countLabel: "published" + (l.living.length > 0
        ? ` · ${l.living.length} living, named with town and country only` : "")
        + (l.groups.length > 1 ? ` · ${l.groups.length} separate groups` : ""),
      facts: l.places.length ? [["Born at", l.places.slice(0, 4).map((x) => x.name.split(",").slice(0, 2).join(",")).join(" · ")]] : [],
      people: shown.map((m) => ({
        name: m.name, href: `/people/${m.slug}`,
        life: isLiving(m) ? "" : (m.life || ""),
        place: isLiving(m) ? (m.place || null) : (m.bornPlace ? m.bornPlace.split(",")[0] : null) })),
      more: l.members.length > 8
        ? `and ${l.members.length - 8} more \u2014 <a href="/families/${l.slug}/">all ${l.members.length} published</a>` : null,
      href: `/families/${l.slug}/`,
      hrefLabel: "Everyone published under the name",
    };
  }),
},
/* THE FALCO FAMILIES (17 October 2026, David). The Falco side of the tree is the Falco archive's research, so
   each name is a LINK OUT to that archive's own page, not a page repeated here: no count, no people. */
{
  label: "The Falco families",
  note: "names that reach this tree through the Falco line; the research on them is the Falco Archive's, and these link to it",
  rows: falcoFamilies.rows.map(({ label, href, hrefLabel }) => ({ label, count: null, countLabel: "", gloss: "", facts: [], href, hrefLabel })),
}];
---
<Base
  title="The Families"
  eyebrow={`${fams.length + lines.length} surnames`}
  dek="A D'Arcy married a Sneyd, who was the granddaughter of a Wakefield of Bristol. Each of these names is a family in its own right, and several of them reached Queensland before the D'Arcys did.">

  <section class="blk">
    <p class="lede">The line the archive is named for is one thread of {fams.length}. Between them
    these families brought <strong>{total}</strong> published people out of Yorkshire, Hampshire,
    Somerset, Bristol, London, Limerick, Monaghan, Cork, Ayrshire, Lanarkshire and Germany, and set
    them down in New South Wales and Queensland. Below them are {lines.length} more names that the direct line
    carries, with the people this archive already names under each.</p>
  </section>

  <section class="blk">
    <Families groups={groups} u={(p) => (/^https?:/.test(p) ? p : u(p))} />
  </section>

  <Blk label="Not placed" title="People on no surname page">
    <div data-unplaced={JSON.stringify({ total: un.total, cluster: un.cluster, line: un.line, copies: un.copies,
      falco: un.falco.n, elsewhere: un.elsewhere.n, unnamed: un.unnamed.n, other: un.other.n, surnames: nOther })} hidden></div>
    <p class="dek">This archive publishes <strong>{nf(un.total)}</strong> people. <strong>{nf(placed)}</strong> are on
    a surname page above ({nf(un.cluster)} on the {fams.length} families, {nf(un.line)} on the {lines.length} more names)
    and {un.copies} are declared copies of people counted once already. The other
    <strong>{nf(un.falco.n + un.elsewhere.n + un.unnamed.n + un.other.n)}</strong> are on none, and this is all of them, counted
    from the data:</p>
    <ul class="small" style="margin:.6rem 0 0;padding-left:1.1rem">
      <li style="margin-top:.35rem"><strong>{nf(un.falco.n)}</strong> carry a name from the Falco side, whose research is the Falco Archive&rsquo;s
      (the Falco families, above){un.falco.direct > 0 && <>; {un.falco.direct} of them on the direct line</>}.</li>
      <li style="margin-top:.35rem"><strong>{nf(un.elsewhere.n)}</strong> are Saniger, written about on
      <a href={u("/sanigers/")}>The Sanigers, reconstituted</a> and <a href={u("/saniger-line/")}>Six generations at Berkeley</a>
      rather than on a surname page{un.elsewhere.direct > 0 && <>; {un.elsewhere.direct} of them on the direct line</>}.</li>
      <li style="margin-top:.35rem"><strong>{nf(un.unnamed.n)}</strong> are recorded with no surname at all, a forename or a title only{un.unnamed.direct > 0 && <>; {un.unnamed.direct} of them on the direct line</>}.</li>
      <li style="margin-top:.35rem"><strong>{nf(un.other.n)}</strong> carry one of <strong>{nf(nOther)}</strong> other surnames that have no page
      ({un.otherNames.slice(0, 6).map((x) => `${x.written} ${x.n}`).join(", ")}, and so on){un.other.direct > 0 && <>; {un.other.direct} of them on the direct line</>}.
      They are listed below, with how many carry each.</li>
    </ul>
    <p class="small" style="margin-top:.8rem">Of these, {un.falco.living + un.elsewhere.living + un.unnamed.living + un.other.living} are living, and are
    named elsewhere in this archive with their town and country only. Nobody on this list is on two pages, and
    none is a declared copy.</p>
    <details style="margin-top:.8rem">
      <summary class="small">The {nf(nOther)} other surnames, with how many people carry each</summary>
      <Scroll>
        <table>
          <thead><tr><th>Surname as the tree writes it</th><th>People</th><th>On the direct line</th></tr></thead>
          <tbody>
            {un.otherNames.map((x) => (
              <tr><td>{x.written}</td><td class="m">{x.n}</td><td class="m">{x.direct}</td></tr>
            ))}
          </tbody>
        </table>
      </Scroll>
    </details>
  </Blk>

  <Blk label="Method" title="How the names beyond the thirteen were chosen">
    <p class="small">{lineCfg.note}</p>
    <p class="small" style="margin-top:.7rem">{lineCfg.rule}</p>
    <p class="small" style="margin-top:.7rem">{lineCfg.match}</p>
    <h3 style="margin-top:1.2rem">Names that qualify and have no page</h3>
    <ul class="small" style="margin:.4rem 0 0;padding-left:1.1rem">
      <li style="margin-top:.3rem"><strong>The Falco side</strong> &mdash; {lineCfg.otherArchive.note}</li>
      {lineCfg.notCreated.map((x) => (
        <li style="margin-top:.3rem"><strong>{x.name}</strong> &mdash; {x.why}</li>
      ))}
    </ul>
  </Blk>

</Base>
