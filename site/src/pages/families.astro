---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Families from "@daviddef/archive-kit/components/Families.astro";
import { u } from "../lib/url.js";
import { publishable } from "../lib/people.js";
import families from "../data/families.json";
import { byId } from "../lib/people.js";

const fams = families.filter((f) => f.published > 0);
const total = fams.reduce((a, f) => a + f.published, 0);

/* 22 September 2026. The card is the kit's. What this archive puts behind
   the claim is not: it can NAME the people, which Blazevic cannot and Falco
   does not try to — Falco draws the marriages instead, because that is what
   its joins rest on. Three archives, one argument, three kinds of evidence,
   and the component requires none of them. */
const famSlug = (x) =>
  String(x).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const groups = [{
  rows: fams.map((f) => {
    const places = [...new Set(f.members.filter((m) => m.bornPlace)
      .map((m) => m.bornPlace.split(",").slice(-2).join(",").trim()))].slice(0, 4);
    const shown = publishable(f.members).slice(0, 12);
    return {
      label: f.surname,
      gloss: f.blurb,
      count: f.published,
      countLabel: "published" + (f.total > f.published
        ? ` · ${f.total - f.published} living, withheld` : ""),
      facts: places.length ? [["Recorded in", places.join(" · ")]] : [],
      people: shown.map((m) => {
        const o = byId.get(m.id);
        return { name: m.name, href: o ? `/people/${o.slug}` : null,
                 life: m.life, place: m.bornPlace ? m.bornPlace.split(",")[0] : null };
      }),
      /* Each family now has a page of its own listing every person of the
         name as a Descent row, so "and N more" points there rather than at
         the whole register. */
      more: f.published > 12
        /* A PLAIN PATH HERE, NOT u(). The Families component rewrites
           href="/… onto the archive's base itself, so calling u() as well
           produced /TheDArcy/TheDArcy/families/… — the double-basing this
           estate has met twice before. `href` below stays plain for the
           same reason: the component passes it through u(). */
        ? `and ${f.published - 12} more — <a href="/families/${famSlug(f.surname)}/">all ${f.published} of the name</a>` : null,
      href: `/families/${famSlug(f.surname)}/`,
      hrefLabel: "Everyone of the name",
    };
  }),
}];
---
<Base
  title="The Families"
  eyebrow={`${fams.length} surnames`}
  dek="A D'Arcy married a Sneyd, who was the granddaughter of a Wakefield of Bristol. Each of these names is a family in its own right, and several of them reached Queensland before the D'Arcys did.">

  <section class="blk">
    <p class="lede">The line the archive is named for is one thread of {fams.length}. Between them
    these families brought <strong>{total}</strong> published people out of Yorkshire, Hampshire,
    Somerset, Bristol, London, Limerick, Monaghan, Cork, Ayrshire, Lanarkshire and Germany, and set
    them down in New South Wales and Queensland.</p>
  </section>

  <section class="blk">
    <Families groups={groups} u={u} />
  </section>

</Base>
