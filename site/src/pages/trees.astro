---
/* Every line this archive follows, each stated in the form its own evidence
   supports. The component is shared across the seven archives; the rows are
   this archive's own, generated from its own data. */
import Base from "../layouts/Base.astro";
import Trees from "@daviddef/archive-kit/components/Trees.astro";
import { u } from "../lib/url.js";
import t from "../data/trees.json";

const rows = t.rows.map(r => ({ ...r, href: r.href ? u(r.href) : null }));
---
<Base title="The trees" eyebrow={`${t.rows.length} lines followed`} dek="Every family this archive follows, and the two grafts that carry almost all of its claimed depth.">
  <section class="blk">
    <Trees rows={rows} note={t.note} close={t.close} />
  </section>
</Base>
