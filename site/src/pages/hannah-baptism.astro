---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import { mdp } from "@daviddef/archive-kit/lib/md.js";
import d from "../data/hannah-baptism.json";
---
<Base
  title="One vowel"
  eyebrow={`Hannah's baptism · found ${d.found}`}
  dek="The document this archive twice declared missing was indexed the whole time under a spelling its own alias list did not carry.">

  <section class="blk">
    <Note style="border-left-width:3px">
      <strong style="font-size:1.15em">{d.record.who}, baptised {d.record.bapt},
      {d.record.place} — father {d.record.father}.</strong>
      <br /><br />
      <span class="small">{d.record.set}</span>
      <span class="chip doc">documented</span>
    </Note>
    <p class="lede" style="margin-top:1.3rem">{d.lede}</p>
    <p style="margin-top:1.1rem">{d.why}</p>
  </section>

  <Blk label={d.siblings.head} title="John Saniger's children at Berkeley">
    <p>{d.siblings.note}</p>
    <Scroll>
      <table>
        <tbody>
          {d.siblings.rows.map(([n, when, note]) => (
            <tr style={n === "HANNAH SANIGOR" ? "background:var(--tint)" : ""}>
              <td><strong>{n}</strong></td><td class="m">{when}</td>
              <td class="small">{note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </Scroll>
    <p class="dek" style="margin-top:1.2rem">{d.thomas}
      <a href={u("/thomas-sinegar")}>Thomas →</a></p>
  </Blk>

  <Blk label="The honest caveat" title={d.year.head}>
    <p class="lede">{d.year.body}</p>
    <p style="margin-top:1rem"><span class="chip inf">{d.year.chip}</span></p>
  </Blk>

  <Blk label="And a name that is not yet evidence" title={d.lydia.head}>
    <p class="lede">{d.lydia.body}</p>
    <Note>
      <strong>{d.lydia.but}</strong> <span class="chip lore">{d.lydia.chip}</span>
      <br /><br />
      {d.lydia.tree} <a href={u("/crossread")}>How that was missed →</a>
      <br /><br />
      <a href={u("/drivers-fields")}>Lyddya Sinegar, aged seventy →</a>
    </Note>
  </Blk>

  <Blk label="Gloucestershire probate, 1801–1858" title={d.probate.head}>
    <p class="lede">{d.probate.body}</p>
    <div class="scroll" style="margin-top:1.2rem">
      <table>
        <tbody>{d.probate.rows.map(([y, w]) => (
          <tr><td class="m">{y}</td><td>{w}</td></tr>))}</tbody>
      </table>
    </div>
    <Note style="margin-top:1.2rem">
      {d.probate.means} <span class="chip doc">{d.probate.chip}</span>
    </Note>
    <p class="small" style="margin-top:1rem">{d.probate.how}</p>
  </Blk>

  <Blk label={`Settled · ${d.jno1804.found}`} title={d.jno1804.head}>
    <p class="lede" set:html={mdp(d.jno1804.lede)}></p>
    <Scroll>
      <table style="margin-top:1.2rem">
        <thead><tr><th>Child</th><th>Baptised</th><th>Father</th><th>Mother</th><th></th></tr></thead>
        <tbody>{d.jno1804.rows.map((r) => (
          <tr><td><strong>{r[0]}</strong></td>
            <td class="m small" set:html={mdp(r[1])}></td>
            <td class="small" set:html={mdp(r[2])}></td>
            <td class="small" set:html={mdp(r[3])}></td>
            <td class="small">{r[4]}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="border-left-width:3px;margin-top:1.3rem">
      <span set:html={mdp(d.jno1804.means)} />
      {" "}<span class="chip doc">{d.jno1804.chip}</span></Note>
    <Note style="margin-top:1.2rem"><strong>{d.jno1804.howHead}.</strong>
      <span set:html={mdp(d.jno1804.how)} /></Note>
  </Blk>

  <Blk label={`The atlas · ${d.berkley.found}`} title={d.berkley.head}>
    <p class="lede" set:html={mdp(d.berkley.body)}></p>
    <p style="margin-top:.8rem"><span class="chip doc">{d.berkley.chip}</span>
      {" "}<a href={u("/atlas/")}>The map →</a></p>
  </Blk>

  <Blk label={`Three tests · ${d.lydiaHunt.found}`} title={d.lydiaHunt.head}>
    <p class="lede" set:html={mdp(d.lydiaHunt.lede)}></p>
    <div style="margin-top:1.4rem;display:flex;flex-direction:column;gap:1.3rem">
      {d.lydiaHunt.steps.map(([what, body]) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div><strong>{what}</strong> <span class="chip sup">not found</span></div>
          <p style="margin-top:.45rem" set:html={mdp(body)}></p>
        </div>
      ))}
    </div>
    <Note style="border-left-width:3px;margin-top:1.4rem"><strong>{d.lydiaHunt.ctlHead}.</strong>
      <span set:html={mdp(d.lydiaHunt.ctl)} />
      {" "}<span class="chip doc">{d.lydiaHunt.chipCtl}</span></Note>
    <Note style="margin-top:1.2rem"><strong>{d.lydiaHunt.meansHead}.</strong>
      <span set:html={mdp(d.lydiaHunt.means)} />
      {" "}<span class="chip lore">{d.lydiaHunt.chipMeans}</span></Note>
    <Note style="border-left-width:3px;margin-top:1.2rem"><strong>{d.lydiaHunt.wildHead}.</strong>
      <span set:html={mdp(d.lydiaHunt.wild)} />
      {" "}<span class="chip doc">{d.lydiaHunt.chipWild}</span></Note>
    <Note style="margin-top:1.2rem"><strong>{d.lydiaHunt.nextHead}.</strong>
      <span set:html={mdp(d.lydiaHunt.next)} /></Note>
  </Blk>

  <Blk label={`Two censuses · ${d.ham.found}`} title={d.ham.head}>
    <p class="lede" set:html={mdp(d.ham.lede)}></p>
    {[["h1", "r1", "c1"], ["h2", "r2", "c2"]].map(([h, r, c]) => (
      <div style="margin-top:1.5rem">
        <h3>{d.ham[h]}</h3>
        <Scroll>
          <table style="margin-top:.7rem">
            <thead><tr><th>Name</th><th class="m">Age</th><th>Relationship</th><th></th></tr></thead>
            <tbody>{d.ham[r].map(([nm, ag, rel, note]) => (
              <tr><td><strong>{nm}</strong></td><td class="m">{ag}</td>
                <td class="small">{rel}</td><td class="small">{note}</td></tr>))}</tbody>
          </table>
        </Scroll>
        <p class="small mono" style="margin-top:.6rem;color:var(--ink-3)">{d.ham[c]}</p>
      </div>
    ))}
    <Note style="border-left-width:3px;margin-top:1.5rem">
      <strong>{d.ham.twinsHead}.</strong> <span set:html={mdp(d.ham.twins)} />
      {" "}<span class="chip doc">{d.ham.chipTwins}</span>
    </Note>
    <Note style="margin-top:1.2rem">
      <strong>{d.ham.whoHead}.</strong> <span set:html={mdp(d.ham.who)} />
      {" "}<span class="chip inf">{d.ham.chipWho}</span>
    </Note>
    <Note style="margin-top:1.2rem">
      <strong>{d.ham.thenHead}.</strong> <span set:html={mdp(d.ham.then)} />
    </Note>
  </Blk>

  <Blk label={`Tested · ${d.lydiaTested.found}`} title={d.lydiaTested.head}>
    <p class="lede" set:html={mdp(d.lydiaTested.lede)}></p>
    <div style="margin-top:1.4rem;display:flex;flex-direction:column;gap:1.3rem">
      {d.lydiaTested.rows.map(([claim, verdict, chip, body]) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div class="small mono" style="color:var(--ink-3)">{claim}</div>
          <div style="margin-top:.3rem"><strong>{verdict}</strong>
            {" "}<span class={`chip ${chip === "documented" ? "doc" : chip === "disputed" ? "dis" : "lore"}`}>{chip}</span></div>
          <p style="margin-top:.45rem" set:html={mdp(body)}></p>
        </div>
      ))}
    </div>
    <Note style="border-left-width:3px;margin-top:1.4rem">
      <strong>{d.lydiaTested.whereHead}.</strong> <span set:html={mdp(d.lydiaTested.where)} />
      {" "}<span class="chip inf">{d.lydiaTested.chipWhere}</span>
    </Note>
    <Note style="margin-top:1.2rem">
      <strong>{d.lydiaTested.fitHead}.</strong> <span set:html={mdp(d.lydiaTested.fit)} />
      {" "}<span class="chip doc">{d.lydiaTested.chipFit}</span>
    </Note>
  </Blk>

  <Blk label={`FindMyPast · found ${d.fmp.found}`} title={d.fmp.head}>
    <p class="lede" set:html={mdp(d.fmp.lede)}></p>
    <Scroll>
      <table style="margin-top:1.1rem">
        <thead><tr><th>Child</th><th class="m">Baptised</th><th>Father</th><th>Parish</th><th></th></tr></thead>
        <tbody>{d.fmp.rows.map(([c, y, f, p2, note]) => (
          <tr style={note ? "background:var(--tint)" : ""}>
            <td><strong>{c}</strong></td><td class="m">{y}</td>
            <td><strong>{f}</strong></td><td class="small">{p2}</td>
            <td class="small">{note}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      <strong>{d.fmp.johnHead}.</strong>
      <span set:html={mdp(d.fmp.john)} />
      {" "}<span class="chip doc">{d.fmp.chip}</span>
    </Note>
    <Note style="margin-top:1.2rem"><strong>{d.fmp.fixHead}.</strong>
      <span set:html={mdp(d.fmp.fix)} /></Note>
    <Note style="margin-top:1.2rem"><strong>{d.fmp.hannahHead}.</strong>
      <span set:html={mdp(d.fmp.hannah)} /></Note>
    <Note style="margin-top:1.2rem"><strong>{d.fmp.gapHead}.</strong>
      <span set:html={mdp(d.fmp.gap)} /></Note>
    <Note style="margin-top:1.2rem"><strong>{d.fmp.awreHead}.</strong>
      <span set:html={mdp(d.fmp.awre)} /></Note>
  </Blk>

  <section class="blk" style="border-bottom:0">
    <h2>Two notes on method</h2>
    <ol class="dek">
      <li style="margin-bottom:.6rem"><strong>An alias list is a research instrument, and mine had a
      hole in it.</strong> Every "not found" this archive published for Hannah was really "not found
      under ten of the eleven spellings I happened to think of". The list now carries sixteen,
      including Sanigor, Sanigear, Sinigar and Swanhanger.
      <a href={u("/coverage")}>Where the other holes were →</a></li>
      <li><strong>And on Ancestry.</strong> {d.ancestry}</li>
    </ol>
    <p class="small" style="margin-top:1.4rem">
      <a href={u("/saniger-line")}>Six generations at Berkeley →</a> ·
      <a href={u("/saniger-1608")}>The surname in 1608 →</a> ·
      <a href={u("/berkeley-woman")}>Why I thought she was not from there →</a> ·
      <a href={u("/what-we-got-wrong")}>The errors →</a></p>
  </section>
</Base>
