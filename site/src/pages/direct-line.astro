---
import Base from "../layouts/Base.astro";
import Spine from "@daviddef/archive-kit/components/Spine.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import { publishable, nameIfPublishable, countLiving } from "../lib/people.js";
import famData from "../data/families.json";
import { people } from "../lib/people.js";

/* «and why no links for the wives?» — 22 September. Thirteen of the
   fifteen generations have one and every one of them was drawn as plain
   text beside a linked husband.

   Resolved BY GEDCOM ID, not by name. people.js is explicit that the tree
   is the authority on identity and that this archive will not merge or
   split people behind the reader's back — and it disambiguates slugs
   because «there are two George Pitt D'Arcys and three Conyers». Matching
   a wife by name in a file like that would be the merge those slugs exist
   to prevent. All thirteen resolve. */
const SLUG_BY_ID = new Map(people.map((q) => [q.id, q.slug]));

/* THE LAST TWO ROWS OF THIS SPINE ARE WHERE THE ESTATE JOINS UP, AND THEY
   WERE DEAD ENDS. Both are living, so people.js excludes them from the
   build and line.json lists no spouse — which left the surname rule with
   nothing to work on at exactly the two rows that reach two other
   archives. Named here because only this archive knows them:

     g2  Ian Kenneth D'Arcy   his wife is Giuseppina Falco, and his two
                              daughters married into Mazza and Defranceschi
     g1  Cristina Adele       married a Defranceski

   A relationship and nothing more — no date, no place, and nothing the
   sibling archives do not already publish on their own spines. The
   Falco archive's generation nine reads «Giuseppina Falco and Ian Kenneth
   D'Arcy»; Mazza's generation zero reads «Michael Rocco Mazza and
   Stefanie D'Arcy». */
const RING_URL = {
  falco: "https://daviddef.github.io/TheFalco/",
  mazza: "https://daviddef.github.io/TheMazza/",
  defranceski: "https://daviddef.github.io/TheDefranceski/",
};
const LIVING_DOORS = {
  2: [
    { label: "The Falco Archive", href: RING_URL.falco, external: true, through: "married" },
    { label: "The Mazza Archive", href: RING_URL.mazza, external: true, through: "Stefanie" },
    { label: "The Defranceschi Archive", href: RING_URL.defranceski, external: true, through: "Cristina" },
  ],
  1: [
    { label: "The Defranceschi Archive", href: RING_URL.defranceski, external: true, through: "married" },
  ],
};

const spouseHrefOf = (g) => {
  const sp = (g.spouses || [])[0];
  const slug = sp && sp.id && nameIfPublishable(sp) ? SLUG_BY_ID.get(sp.id) : null;
  return slug ? `/people/${slug}/` : null;
};

import Evidence from "@daviddef/archive-kit/components/Evidence.astro";
import line from "../data/line.json";

// The spine runs oldest-first on the page; the data is youngest-first.
const spine = [...line].reverse();
/* The living generations were filtered off this page entirely, which left the
   line stopping two generations short of the person most likely to be reading
   it. The estate rule is Falco's — name them, nothing more — so they are shown
   by name, with no date, no place and no marriage beside them. */
const shown = spine;
const living = countLiving(spine);

/* Where each generation stands — THIS ARCHIVE'S JUDGEMENT, not the tree's.
   Moved to src/data/confidence.json on 22 September so the homepage ladder
   reads the same map. A judgement about whether a generation is proved must
   not exist twice: two copies drift, and the day they disagree one page calls
   a man documented while the other calls him unproven. */
import CONF from "../data/confidence.json";
const CONFIDENCE = CONF.confidence;

/* Where the exported tree is demonstrably wrong, the archive shows its own
   finding and prints the tree's version underneath. Correcting it quietly would
   conceal the very thing this site exists to show. */
const CORRECTIONS = {
  "@I647@": {
    spouses: ["Miss Ludlam — m. September 1805", "Maria White — m. c. 1819, County Wicklow"],
    was: "two marriages, both at Chatham in 1810 — to “Maria (Catherine) Whiite” and to “Maria or Mary Le Meassier”",
    why: "the Salisbury and Winchester Journal of 23 September 1805 announces the marriage of “Captain George d'Arcy”, son of “Lieut Colonel d'Arcy”, to “Miss Ludlam”. Le Mesurier was that bride's mother's maiden name, which is how it entered the tree as her own. The second marriage was in Ireland, about 1819",
    link: "/australia",
  },
  "@I1059@": {
    born: "by 1758, and probably earlier",
    bornPlace: "unknown",
    was: "born in 1751, in North Yorkshire",
    why: "the 1751 is arithmetic from an age of 76 stated on a burial register, not a birth record, and nothing at all places him in North Yorkshire. His commission as second lieutenant on 17 January 1776 pulls the other way, since Academy cadets were commissioned at sixteen to twenty",
    link: "/hornby",
  },
};

// One obvious geocoding failure in the source tree, shown rather than hidden.
const PLACE_FIX = {
  "Darcy Meynill, Yorkshire, Cattaraugus County, New York, United States":
    "Darcy Meynill, Yorkshire — the tree's geocoder has appended a county in New York State",
};

const chip = (id) => CONFIDENCE[id]?.[0] || "unproven";
const why = (id) => CONFIDENCE[id]?.[1] || "";
/* The hand-kept vocabulary on this page predates the ladder the seven archives
   now share. "unproven" is folded to "inferred" by the Evidence component, so
   the words on the spine are the same words as everywhere else. */

const MON = { JAN: "Jan", FEB: "Feb", MAR: "Mar", APR: "Apr", MAY: "May", JUN: "Jun",
  JUL: "Jul", AUG: "Aug", SEP: "Sep", OCT: "Oct", NOV: "Nov", DEC: "Dec" };
const LONG = { January: "Jan", February: "Feb", March: "Mar", April: "Apr", May: "May",
  June: "Jun", July: "Jul", August: "Aug", September: "Sep", October: "Oct",
  November: "Nov", December: "Dec" };

/* GEDCOM dates arrive as "5 JUL 1565", "June 7 1863", "BET x AND y", "ABT 1659".
   Normalise them, so that one column does not carry four house styles. */
function fmtDate(d) {
  if (!d) return "—";
  let s = String(d).trim();
  const between = s.match(/^BET\s+(.+?)\s+AND\s+(.+)$/i);
  if (between) return `between ${fmtDate(between[1])} and ${fmtDate(between[2])}`;
  s = s.replace(/^ABT\s+/i, "c. ").replace(/^BEF\s+/i, "before ").replace(/^AFT\s+/i, "after ");
  s = s.replace(/^(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2})\s+(\d{4})$/,
    (_, mo, dd, yy) => `${dd} ${LONG[mo]} ${yy}`);
  s = s.replace(/\b([A-Z]{3})\b/g, (m) => MON[m] || m);
  return s;
}
const place = (p) => PLACE_FIX[p] || p || "—";
const corr = (id) => CORRECTIONS[id];
/* THE DEK SAID "EIGHT OF THEM ARE DOCUMENTED" AND THE DRAWING MARKED SIX.
   Counted from confidence.json now, so the sentence and the spine below it
   cannot drift apart again. */
const documented = shown.filter((g) => chip(g.id) === "documented").length;
/* And spelled, because the sentence it sits in is prose and the number it
   replaced was written "Eight". A derived count is no excuse for "6 of
   them this archive will defend" in the middle of a paragraph. */
const WORD = ["no", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight",
              "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen"];
const documentedWord = WORD[documented] || String(documented);



/* The thirteen surnames this archive keeps a section on, handed to the
   spine so a marriage is a door into the family it joined. One page with
   a section each, so the href carries the anchor the kit's Families
   component now emits. */
const familyDoors = famData.map((f) => ({
  label: f.surname,
  href: `/families/#${String(f.surname).toLowerCase().normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`,
}));

---
<Base
  title="The Spine"
  eyebrow="Generation by generation"
  dek={`Fifteen generations are asserted, from a Brisbane insurance manager to a Yorkshire castle. ${documentedWord} of them this archive will defend. The break is at one man, and it is marked here rather than smoothed over.`}>

  <Blk label="The spine changed in three places on 13 September 2026" title="What a fortnight of registers did to it">
    <Scroll>
      <table>
        <thead><tr><th>Where</th><th>What changed</th></tr></thead>
        <tbody>
          <tr><td><strong>Robert D'Arcy</strong><div class="small">generation 8</div></td>
              <td class="small">His marriage and eldest son are documented at last — Joseph, baptised
                Portsea 19 March 1780, father Robert, mother Jean. And his burial is found: Chatham,
                19 May 1827, <strong>aged 76</strong>. His parentage is still unknown.
                <a href={u("/chatham/")}>→</a></td></tr>
          <tr><td><strong>The Sneyd line</strong><div class="small">below the Keele graft</div></td>
              <td class="small">Three of four links now documented — the 1769 Madeley marriage of
                William the weaver, Samuel's baptism there in <strong>1781</strong> rather than the
                tree's 1769, and Samuel Charles's at Hanley in 1811.
                <a href={u("/sneyds/")}>→</a></td></tr>
          <tr><td><strong>The Saniger line</strong><div class="small">the archive's oldest claim</div></td>
              <td class="small">Contradicted in the middle and unfindable at the join. The maiden name
                is settled five times over from Queensland; the woman herself is in none of
                Gloucestershire's 81 Saniger households, and was born outside the county.
                <a href={u("/sanigers/")}>→</a></td></tr>
        </tbody>
      </table>
    </Scroll>
  </Blk>

  <section class="blk">
    <p class="lede">This is the male D'Arcy line exactly as the family tree carries it — and then,
    against each generation, what this archive is actually willing to defend. The colour of the chip
    is the claim; the sentence beneath it is the reason.</p>

    <Note>
      <strong>Read the page from the bottom up if you want the truth of it.</strong> Eight
      generations, from Kenneth D'Arcy back to <strong>Major-General Robert D'Arcy</strong>, are
      documented — several of them to the day, and Robert from his commission in 1776 to his burial
      in 1827. Then the line stops dead. Nothing connects Robert to the man printed above him, and
      the tree contradicts itself about what that connection was supposed to be.
      <a href={u("/hornby/")}>Why the Hornby descent is doubted →</a>
    </Note>

    <p class="small" style="margin-top:1rem">Where the exported tree is demonstrably wrong, the
    corrected value is shown here and <strong>the tree's own version is printed underneath it</strong>.
    Correcting quietly would conceal the one thing this archive is for.</p>

    {living > 0 && (
      <p class="small" style="margin-top:.7rem">The last {living === 1 ? "generation is" : living + " generations are"} living,
      and {living === 1 ? "is" : "are"} carried by name alone — no date, no place, nothing else. That is
      the rule everywhere on this site, and it is why the line can run all the way down.</p>
    )}
  </section>

  <section class="blk">
    <Scroll>
      <table>
        <thead>
          <tr>
            <th>Gen</th><th>Person</th><th class="m">Born</th><th>At</th>
            <th class="m">Died</th><th>Trade</th><th>Standing</th>
          </tr>
        </thead>
        <tbody>
          {shown.map((g) => {
            const c = corr(g.id) || {};
            const spouses = c.spouses
              ? c.spouses
              : publishable(g.spouses).filter((s) => s.name)
                  .map((s) => s.name + (s.married ? ` — m. ${fmtDate(s.married)}` : ""));
            return (
              <tr>
                <td class="m">{g.gen}</td>
                <td>
                  <strong>{g.name}</strong>
                  {spouses.map((t) => <div class="small">{t}</div>)}
                </td>
                <td class="m">{c.born || fmtDate(g.born)}</td>
                <td>{c.bornPlace || place(g.bornPlace)}</td>
                <td class="m">{fmtDate(g.died)}</td>
                <td>{g.occupation || "—"}</td>
                <td><Evidence level={chip(g.id)} /></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </Scroll>
    <p class="small" style="margin-top:.9rem">The upper rows reproduce the exported tree's own fields
    <em>verbatim</em>, including its truncations — "Earl of Holdernesse ( 3rd" and "St. James Palace,
    London, Middlesex, Englan" are what the file actually contains. They are left as they are rather
    than tidied, because tidying data the archive does not defend would suggest a confidence in it
    that does not exist.</p>
  </section>

  <section class="blk">
    <h2>Generation by generation</h2>
    <div class="spine" style="margin-top:1.4rem">
      <Spine u={u} label="g" archiveKey="darcy" families={familyDoors} rows={shown.map((g) => {
        const c = corr(g.id) || {};
        return {
          gen: g.gen ?? g.ahn,
          name: g.name,
          href: g.slug ? "/people/" + g.slug + "/" : "",
          /* THE ROW WAS DROPPING THE WIVES, THE DEATHPLACES, THE TRADES,
             THE BROTHERS AND SISTERS AND THE SOURCES — all of which
             line.json already holds for most of these fifteen. A line
             whose own archive keeps a page called "The women" was drawing
             fifteen men on its spine and naming none of them.

             `place()` returns an em dash for an empty value, which is
             right in a table cell and wrong in a row that omits what it
             does not have, so diedPlace is guarded. Siblings here are
             bare name strings with no identifier, so they draw as plain
             chips: this archive has no slug to link them by, and one
             guessed from a name would be a guess. */
          spouse: ((g.spouses || [])[0] || {}).name || (g.spouses || [])[0] || "",
          spouseHref: spouseHrefOf(g),
          offpage: LIVING_DOORS[g.gen ?? g.ahn] || [],
          born: c.born || g.born || "",
          bornPlace: c.bornPlace || place(g.bornPlace) || "",
          died: g.died || "",
          diedPlace: g.diedPlace ? place(g.diedPlace) : "",
          trade: g.occupation || "",
          household: (g.siblings || []).length
            ? { label: "Brothers and sisters",
                members: (g.siblings || []).map((x) =>
                  typeof x === "string" ? { name: x } : { name: x.name, dates: x.dates || "" }) }
            : null,
          sources: (g.sources || []).map((x) => ({ label: String(x).split(" \u2014 ")[0] })),
          confidence: chip(g.id),
          /* A solid node is a generation this archive will defend; a dashed one
             it is repeating from the family tree and has not proved. */
          weak: chip(g.id) !== "documented",
          weakNote: why(g.id) || "Repeated from the family tree and not proved.",
          note: c.was
            ? `<span class="chip dis">superseded</span> <strong>The tree says</strong> ${c.was}. ` +
              `<strong>It is wrong because</strong> ${c.why}. ` +
              (c.link ? `<a href="${u(c.link)}">Set out in full →</a>` : "")
            : "",
        };
      })} />
    </div>
    <p class="spine-key">A solid node is a generation this archive will defend. A dashed node is one
    it is repeating from the family tree and has not proved.</p>
  </section>

  <section class="blk">
    <div class="lab">13 September 2026</div>
    <h2 style="margin-top:.4rem">Where the documented line now ends</h2>

    <p class="lede">Two of the generations above have moved this week, and the movement is all in one
    direction: <strong>downward from the graft, upward from the records</strong>.</p>

    <div class="scroll" style="margin-top:1.2rem">
      <table>
        <thead><tr><th class="m">Gen</th><th>Who</th><th>What is now documented</th></tr></thead>
        <tbody>
          <tr>
            <td class="m">7</td><td><strong>George Pitt D'Arcy</strong></td>
            <td class="small">Married <strong>Miss Ludlam of Guernsey</strong>, announced 23 September
            1805, in a notice that calls him <strong>“son of Lieut. Colonel D'Arcy”</strong> — the first
            record here to make him anyone's son. In Ireland with the 39th in 1820 and 1822; in the
            Peninsula in 1808. <a href={u("/george-pitt")}>→</a></td>
          </tr>
          <tr>
            <td class="m">8</td><td><strong>Robert D'Arcy</strong></td>
            <td class="small">Commissioned <strong>Practitioner Engineer, 1778</strong>; married
            <strong>Jean Ward at Portsea, 21 June 1779</strong>; Major 1802,
            <strong>Lieutenant-Colonel 1 March 1805</strong>, Colonel 1813; died Chatham 13 May 1827
            and was buried there with military honours. Seventeen newspapers carried it and not one
            named his father. <a href={u("/the-corps")}>→</a> <a href={u("/obituary")}>→</a></td>
          </tr>
          <tr style="background:var(--tint)">
            <td class="m">9+</td><td><strong>Thomas (Francis) D'Arcy and above</strong></td>
            <td class="small">Unchanged, and still the graft. Everything from generation nine upward
            is the family tree's, running into Hornby Castle, and this archive does not defend it.
            <a href={u("/hornby")}>→</a></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="note" style="margin-top:1.3rem">
      <strong>The 1805 notice is the interesting one, because it cuts both ways.</strong> It is the
      first independent evidence that George Pitt D'Arcy had a father of exactly Robert's rank in
      exactly the right month — which strengthens generation seven to eight, the join the whole
      Australian descent hangs on. And it says nothing whatever about generation nine.
      <span class="chip doc">seven to eight, strengthened</span>
      <span class="chip sup">nine and above, untouched</span>
    </div>

    <p class="dek" style="margin-top:1.2rem"><strong>And the maternal lines have gone further than
    the paternal one.</strong> Through Hannah Saniger the archive now holds six generations at
    Berkeley on parish record, back to a William Saniger named as a father in 1679; through Jean Ward,
    five generations at South Leith back to William Gairden. Neither of those lines is on the spine
    above, because the spine follows the D'Arcy name.
    <a href={u("/saniger-line")}>The Sanigers →</a> · <a href={u("/jean-ward")}>South Leith →</a> ·
    <a href={u("/new-generations")}>The people the tree never had →</a></p>
  </section>

  <section class="blk" style="border-bottom:0">
    <h2>What would settle the break</h2>
    <div class="grid two" style="margin-top:1rem">
      <div class="card">
        <h3>Robert D'Arcy's parentage</h3>
        <p>The one question the archive cannot answer. His whole adult life is on paper and not a
        single record of it names a father. What is left needs an archive rather than a search: the
        <strong>Board of Ordnance</strong> minutes and registers, and the will of the
        <strong>4th Earl of Holderness</strong>. <a href={u("/hornby/")}>The case, in full →</a></p>
      </div>
      <div class="card">
        <h3>And what does not need settling</h3>
        <p>Everything below him. The Australian line is proved from a surgeon's journal, a christening
        register, six newspapers and a corps roll. <strong>It does not depend on the Yorkshire descent
        and never did.</strong> <a href={u("/australia/")}>Arrival, 1826 →</a></p>
      </div>
    </div>
  </section>
</Base>
