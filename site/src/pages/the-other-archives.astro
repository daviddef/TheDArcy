---
import Base from "../layouts/Base.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import living from "../data/living.json";

const SIBS = [
  ["The Defranceski Archive", "https://archive.defranceski.com/",
   "A family written down under eight sovereigns, in four languages, and spelled at least nine different ways.",
   "The line this one married into. Istria, Carnia, Fiume and Dalmatia."],
  ["The Falco Archive", "https://falco.defranceski.com/",
   "Campania to Australia.",
   "Married into THIS line: forty of the root person's own ancestors, out of Arienzo in Caserta."],
  ["The Lerena Archive", "https://lerena.defranceski.com/",
   "A horse-dealer out of Argentina, a stable under Table Mountain, and four family traditions tested.",
   "Argentina and the Cape."],
  ["The Blažević Archive", "https://blazevic.defranceski.com/",
   "An evidence-first archive for the family of Hedviga Blažević of Senj.",
   "Senj, on the Croatian littoral."],
  ["The Booyzen Archive", "https://booyzen.defranceski.com/",
   "A Cape Dutch family that kept marrying British women, and changed one letter of its name in a war.",
   "The Cape."],
];
---
<Base
  title="The Other Archives"
  eyebrow="Where this one joins the others"
  dek="This archive is one of six, kept to the same method and by the same hand. This page says how they connect — and why the join itself is not published.">

  <section class="blk">
    <p class="lede">A reader who arrives at <em>The D'Arcy Archive</em> could be forgiven for thinking
    it stands alone. It does not, and it does not exist by accident: it was begun because the
    Australian D'Arcys married into a family that already had an archive of its own.</p>

    <Note>
      <strong>This page was wrong for a day, and the brief it contradicted was right.</strong>
      On 9 September 2026 it claimed the founding brief — "the Australian D'Arcy family that married
      Falco" — had the shape of it wrong, and that the D'Arcys had married Defranceski while the
      Defranceskis had married Falco.
      <br /><br />
      <strong>That was my error, not the brief's.</strong> I read the root person's <em>spouse</em>
      where I should have read her <em>parents</em>. The tree is unambiguous:
      <strong>Ian Kenneth D'Arcy married Giuseppina Falco</strong>, and their daughter is the person
      this archive is built outward from. The D'Arcys married Falco exactly as the brief said. The
      Defranceski marriage is the <em>next</em> one, in the following generation.
      <a href={u("/corrections/")}>Recorded with the rest →</a>
    </Note>
  </section>

  <section class="blk">
    <h2>How they join</h2>
    <p class="dek">Three archives meet at one marriage and two children. All four of those people are
    <strong>living</strong>. This archive names a living person with their town and country and
    nothing more, the standard the Defranceschi archive keeps, so the join is described here by
    relationship and not drawn out with dates.</p>

    <Scroll>
      <table>
        <tbody>
          <tr><td><strong>This archive</strong></td>
              <td>runs from Yorkshire and Portsmouth through Parramatta to Brisbane, and stops at a
              living generation. <a href={u("/direct-line/")}>The spine →</a></td></tr>
          <tr><td><strong>The first join — D'Arcy and Falco</strong></td>
              <td>a marriage in the parents' generation. <strong>Two-fifths of this archive's
              deepest Australian line meets an Italian one out of Arienzo, Caserta.</strong>
              <span class="chip lore">living, named only</span></td></tr>
          <tr><td><strong>The Falco line</strong></td>
              <td>reaches back through <strong>Arienzo and Santa Maria a Vico in Campania</strong> to
              Agostino Falcone, born about 1740 — <strong>forty ancestors across nine generations,
              and this archive has never written a word about them</strong></td></tr>
          <tr><td><strong>The second join — D'Arcy and Defranceski</strong></td>
              <td>a marriage in the present generation, and the reason the Defranceski and Lerena
              archives exist alongside this one <span class="chip lore">living, named only</span></td></tr>
          <tr><td><strong>What comes after</strong></td>
              <td>two children in whom all three lines meet — <span class="chip lore">living, named only</span></td></tr>
        </tbody>
      </table>
    </Scroll>

    <Note>
      <strong>This is the rule doing its job, not a gap in the research.</strong> The archive knows
      exactly who these people are — it walked their ancestry to build every page on this site. It
      shows them as it shows every living person, <em>consistently</em>: a name, relationships, a
      town and a country, and no date or record, wherever they appear. The tree judges
      <strong>{living.counts.living.toLocaleString()}</strong> people living; the rule is the same
      for all of them. <a href={u("/method/#living")}>How the rule works →</a>
    </Note>
  </section>

  <section class="blk" style="border-bottom:0">
    <h2>The six</h2>
    <p class="dek">Each is built the same way and to the same standard: every claim carries its
    confidence, and null results are published as results.</p>
    <div class="grid two" style="margin-top:1.2rem">
      {SIBS.map(([name, href, dek, rel]) => (
        <a class="cardlink" href={href}>
          <div class="nm">{name} ↗</div>
          <p class="small" style="margin-top:.4rem">{dek}</p>
          <p class="small" style="margin-top:.4rem;color:var(--ink-3)"><em>{rel}</em></p>
        </a>
      ))}
    </div>
    <p class="small" style="margin-top:1.3rem">They are separate sites rather than one because they
    are separate bodies of evidence, and merging them would blur exactly the joins this method exists
    to test. Where one of them contradicts this one, that is worth knowing, and worth telling me.</p>
  </section>
</Base>
