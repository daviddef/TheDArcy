---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import { u } from "../lib/url.js";
import d from "../data/thomas-sinegar.json";
---
<Base
  title="Thomas Sinegar"
  eyebrow={`St Philip and Jacob, Bristol · ${d.found}`}
  dek="A labourer from Berkeley living a mile from Hannah Wakefield, with a daughter named Lydia — and Hannah's mother, on the tree, was Lydia.">

  <section class="blk">
    <p class="lede">{d.lede}</p>
    <Note><strong>{d.who}</strong></Note>
  </section>

  <Blk label="What is on record" title="Five entries, sixty-three years">
    <div style="margin-top:1.3rem;display:flex;flex-direction:column;gap:1.3rem">
      {d.records.map((r) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div><span class="mono small" style="color:var(--ink-3)">{r.when}</span></div>
          <p style="margin-top:.35rem">{r.what}</p>
          <p class="small" style="margin-top:.35rem;color:var(--ink-2)">{r.where}</p>
          <p class="small" style="margin-top:.3rem">{r.note}</p>
        </div>
      ))}
    </div>
  </Blk>

  <Blk label="The case for him" title="Four things that line up">
    <ol class="dek" style="margin-top:1rem">
      {d.case.map(([h, b]) => (<li style="margin-bottom:.7rem"><strong>{h}</strong> {b}</li>))}
    </ol>
  </Blk>

  <Blk label="And the case against calling it proved" title="What is missing">
    <ul class="dek" style="margin-top:1rem">
      {d.against.map((x) => (<li style="margin-bottom:.5rem">{x}</li>))}
    </ul>
    <Note>
      <strong>{d.spelling}</strong>
      <a href={u("/hannah-baptism")}>The other vowel →</a>
    </Note>

    <Note>
      <strong>{d.verdict}</strong>
      <span class="chip inf">a strong inference, not a document</span>
    </Note>
  </Blk>

  <section class="blk" style="border-bottom:0">
    <h2>And an apology to an earlier pass</h2>
    <p class="lede">This was written up once already, weeks ago, and called the best lead the archive
    had. It was then overtaken by my own conclusion that Hannah could not have been born in
    Gloucestershire — a conclusion built on one tick in the 1841 census, which turned out to be
    wrong. Three days of work went to a Somerset parish instead.</p>
    <Note>
      The lead was right the first time. <a href={u("/berkeley-woman")}>What was wrong with me →</a> ·
      <a href={u("/chew-magna")}>Where I went instead →</a> ·
      <a href={u("/saniger-line")}>Her six generations →</a>
    </Note>
  </section>
</Base>
