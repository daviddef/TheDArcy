---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import { u } from "../lib/url.js";

const ARRIVALS = [
  { who: "Samuel Charles Sneyd", year: "1832", how: "With a regiment",
    detail: "Arrived in New South Wales with the 4th (King's Own) Regiment of Foot, doing convict-guard duty — the same work that had brought Major George Pitt D'Arcy out six years earlier.",
    status: "documented", note: "He is correctly absent from the assisted-immigration index: a soldier's passage is not an emigrant's.",
    href: "/sergeant-sneyd" },
  { who: "Major George Pitt D'Arcy and family", year: "1826", how: "On a convict ship, in the cabin",
    detail: "The England sailed 8 April 1826 and reached Port Jackson on 18 September. The surgeon's journal records the detachment of the 39th Foot he commanded — 39 men, 6 women, 7 children — and Mrs D'Arcy and family as cabin passengers.",
    status: "documented", note: "Their daughter Charlotte was christened at Chatham eight days before they embarked.",
    href: "/australia" },
  { who: "The Wakefields — eight of them", year: "1854", how: "Assisted passage, steerage",
    detail: "The General Hewitt, Brisbane, 16 December 1854, 394 souls. James a mason of 48, Hannah 48, and six children — Hiram 16 a plumber, Aaron 14, Marion 14 a domestic, Jabez 11, Zillah 8, Ephraim 5.",
    status: "documented", note: "The only family in this archive that took a free passage — and three adult daughters stayed behind.",
    href: "/general-hewitt" },
  { who: "Paul Cole Atkinson and Jane Creech", year: "1862", how: "Paying passengers",
    detail: "An organist from Limerick who arrived with his wife and the children already born, and who two years later installed the first organ at All Saints' Wickham Terrace and played it.",
    status: "inferred", note: "Not in the assisted index at all — which is itself the finding. A professional man paid his own way.",
    href: "/atkinson" },
  { who: "Eliza Keeling", year: "by 1863", how: "Unknown",
    detail: "Married George Lindsay D'Arcy in Queensland in 1863, the year he arrived in the colony. How and when she reached it is not recorded anywhere this archive has read.",
    status: "open", note: "Not in the assisted index.", href: "/the-women" },
  { who: "The Murdochs of St Quivox", year: "unknown", how: "Unknown",
    detail: "Out of Ayrshire to Queensland at a date nobody has established. The DNA says this branch is a quarter of the family; the archive has half its ancestor slots empty and no arrival for any of them.",
    status: "open", note: "No Murdoch of the right age appears in the assisted index.", href: "/murdoch" },
  { who: "John Blum", year: "unknown", how: "Unknown",
    detail: "Born in Germany, and by the 1870s at Rockhampton. He accounts for the entire German component the DNA reports.",
    status: "open", note: "Not in the assisted index.", href: "/dna" },
];
const CHIP = { documented: ["doc","documented"], inferred: ["inf","inferred"], open: ["lore","not established"] };
---
<Base
  title="How they got here"
  eyebrow={`${ARRIVALS.length} arrivals · ${ARRIVALS.filter(a=>a.status==="documented").length} documented`}
  dek="Seven lines reached Australia seven different ways — a garrison posting, a convict ship, a free passage, a paid one, and three nobody has dated. The differences are not incidental; they are the class structure of the family.">

  <section class="blk">
    <p class="lede">Every family in this archive crossed the same ocean, and almost none of them
    crossed it the same way. Until this week only one of those crossings was documented. Now three
    are, and the pattern they make is worth looking at directly.</p>
  </section>

  {ARRIVALS.map((a) => (
    <Blk label={`${a.year} · ${a.how}`} title={a.who}>
      <p class="dek" style="margin-top:.8rem">{a.detail}</p>
      <p class="small" style="margin-top:.7rem">
        <span class={`chip ${CHIP[a.status][0]}`}>{CHIP[a.status][1]}</span>{" "}
        {a.note} <a href={u(a.href)}>→</a></p>
    </Blk>
  ))}

  <section class="blk" style="border-bottom:0">
    <h2>What the manner of arrival says</h2>
    <Note>
      <strong>The assisted-immigration index is a means test, seventy years after the fact.</strong>
      Queensland paid the passage of people it wanted and could not otherwise get: labourers, masons,
      domestic servants, ploughmen. Running the index across every family in this archive returns
      <strong>the Wakefields and nobody else</strong>.
      <br /><br />
      The organist paid. The soldier was carried by his regiment. The major travelled in the cabin of
      a convict transport with his wife and children while thirty-nine of his men and a hold full of
      prisoners went below. And the mason of Drivers Fields, with six children and three grown
      daughters he was leaving behind, took the free berth.
    </Note>
    <p class="small" style="margin-top:1.3rem">
      <a href={u("/general-hewitt/")}>The ship →</a> ·
      <a href={u("/australia/")}>The convict transport →</a> ·
      <a href={u("/searched/")}>What was searched →</a></p>
  </section>
</Base>
