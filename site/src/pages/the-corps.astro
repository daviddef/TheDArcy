---
import Base from "../layouts/Base.astro";
import Blk from "../components/Blk.astro";
import Note from "../components/Note.astro";
import Scroll from "../components/Scroll.astro";
import { u } from "../lib/url.js";
import { mdp } from "@daviddef/archive-kit/lib/md.js";
import d from "../data/the-corps.json";
---
<Base
  title="The Corps"
  eyebrow={`Robert D'Arcy, 1778–1827 · found ${d.found}`}
  dek="Forty-nine years of an engineer's career, every promotion cited to the London Gazette by issue and page — replacing a book printed in 1898.">

  <section class="blk"><p class="lede">{d.lede}</p></section>

  <Blk label={d.source} title={d.span}>

    <div style="margin-top:1.3rem;display:flex;flex-direction:column;gap:1.3rem">
      {d.career.map((c) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div><span class="mono small" style="color:var(--ink-3)">{c.year}</span>
            <strong style="margin-left:.6rem">{c.became === "—" ? c.unit : c.became}</strong></div>
          <p class="small" style="margin-top:.35rem;color:var(--ink-2)">
            {c.was !== "—" && <>from <strong>{c.was}</strong> · </>}{c.unit} · {c.src}
            {c.gaz && <> · <span class="mono">London Gazette {c.gaz}</span></>}</p>
          {c.note && <p class="small" style="margin-top:.35rem">{c.note}</p>}
        </div>
      ))}
    </div>
  </Blk>

  <Blk label="Chatham Lines" title={d.post.head}>
    <p class="lede">{d.post.body} <span class="chip doc">{d.post.chip}</span></p>
    <Note>
      <strong>It comes out of his son's death notice.</strong> Constantine D'Arcy, first lieutenant
      of the Royal Engineers, died at Chatham in May 1805 and the Kentish Gazette identified him by
      his father's post rather than his own name. <a href={u("/constantine/")}>Constantine →</a>
    </Note>
  </Blk>

  <Blk label="A name that is not him" title="The cornet of the 17th Light Dragoons">
    <p class="lede">{d.notHim}</p>
    <Note>
      <strong>This is why rank matters more than name in a military search.</strong> Two Robert
      D'Arcys were being gazetted in the same decade and only one of them is this family's.
      <span class="chip inf">excluded, and said so</span>
    </Note>
  </Blk>

  <Blk label="Whitworth Porter, 1889" title={d.porter.head}>
    <p class="lede">{d.porter.lede} <span class="chip doc">{d.porter.chip}</span></p>
    <p class="small mono" style="margin-top:1rem;color:var(--ink-3)">{d.porter.indexLine}</p>

    <div style="margin-top:1.3rem;display:flex;flex-direction:column;gap:1.2rem">
      {d.porter.rows.map(([when, what, detail]) => (
        <div style="border-left:2px solid var(--accent);padding:2px 0 2px 16px">
          <div><span class="mono small" style="color:var(--ink-3)">{when}</span>
            <strong style="margin-left:.6rem">{what}</strong></div>
          <p class="small" style="margin-top:.35rem">{detail}</p>
        </div>
      ))}
    </div>

    <Note style="border-left-width:3px;margin-top:1.4rem">
      <strong>{d.porter.gapHead}.</strong> {d.porter.gap}
      {" "}<span class="chip inf">{d.porter.chipGap}</span>
    </Note>
  </Blk>

  <Blk label="The Royal Military Calendar, 1820" title={d.rmc.head}>
    <p class="lede">{d.rmc.lede}</p>
    <Note style="border-left-width:3px;margin-top:1.1rem">
      <strong>{d.rmc.quote}</strong>
      <span class="chip doc">{d.rmc.chip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.rmc.means}</p>

    <h3 style="margin-top:1.7rem">{d.rmc.newHead}</h3>
    <p>{d.rmc.new}</p>

    <h3 style="margin-top:1.7rem">{d.rmc.clashHead}</h3>
    <p>{d.rmc.clash}</p>
    <Note style="margin-top:1.1rem">{d.rmc.clashMeans}
      {" "}<span class="chip inf">{d.rmc.chipClash}</span></Note>

    <h3 style="margin-top:1.7rem">{d.rmc.parentHead}</h3>
    <p>{d.rmc.parent} <span class="chip lore">{d.rmc.chipParent}</span></p>
    <p class="small" style="margin-top:1rem">
      <a href={u("/hornby/")}>The claim about his birth →</a></p>
    <p class="small" style="margin-top:.6rem;color:var(--ink-3)">{d.rmc.where}</p>
  </Blk>

  <Blk label="The Army List of 1778" title={d.armylist.head}>
    <p class="lede">{d.armylist.lede}</p>
    <Note style="border-left-width:3px;margin-top:1.1rem">
      {d.armylist.entry} <span class="chip doc">{d.armylist.chip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.armylist.means}</p>

    <h3 style="margin-top:1.7rem">{d.armylist.minorcaHead}</h3>
    <p>{d.armylist.minorca} <span class="chip doc">{d.armylist.chipMinorca}</span></p>

    <h3 style="margin-top:1.7rem">{d.armylist.dateHead}</h3>
    <Note style="border-left-width:3px;margin-top:.8rem">
      {d.armylist.date} <span class="chip doc">{d.armylist.dateChip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.armylist.dateMeans}</p>
    <Note style="margin-top:1.1rem">
      <strong>And what is not claimed.</strong> {d.armylist.dateCareful}
    </Note>

    <h3 style="margin-top:1.7rem">{d.armylist.trapHead}</h3>
    <p>{d.armylist.trap}</p>
    <Note style="margin-top:1.1rem">
      <strong>Recorded as an empty search, not a null.</strong> {d.armylist.resolve}
      {" "}<span class="chip lore">{d.armylist.chipTrap}</span>
      {" "}<a href={u("/errands/")}>The series →</a>
    </Note>
    <p class="small" style="margin-top:1rem;color:var(--ink-3)">{d.armylist.where}</p>
  </Blk>

  <Blk label="Flushing, 13 August 1809" title={d.porter.arrestHead}>
    <p class="lede">{d.porter.arrest.setup}</p>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      <strong style="font-size:1.05em">{d.porter.arrest.quote}</strong>
      <br /><br />
      <span class="small">{d.porter.arrest.src}</span>
      <span class="chip doc">{d.porter.arrest.chip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.porter.arrest.end}</p>
    <Note style="margin-top:1.2rem">{d.porter.arrest.means}</Note>

    <h3 style="margin-top:1.7rem">{d.porter.ageHead}</h3>
    <p>{d.porter.age} <span class="chip inf">{d.porter.chipAge}</span></p>

    <Note style="margin-top:1.3rem">
      <strong>And what Porter is.</strong> {d.porter.careful}
    </Note>
    <p class="small" style="margin-top:1rem;color:var(--ink-3)">{d.porter.where}</p>
  </Blk>

  <Blk label="The Army Lists, 1783–1821" title={d.run.head}>
    <p class="lede">{d.run.lede}</p>
    <Note style="border-left-width:3px;margin-top:1.2rem">
      <strong>{d.run.spellHead}.</strong> <span set:html={mdp(d.run.spell)} />
      {" "}<span class="chip lore">{d.run.spellChip}</span>
    </Note>
    <Scroll>
      <table style="margin-top:1.4rem">
        <thead><tr><th class="m">Year</th><th>Rank</th><th>What the list says</th><th>Edition</th></tr></thead>
        <tbody>{d.run.rows.map(([y, rank, what, ed]) => (
          <tr><td class="m" style="white-space:nowrap"><strong>{y}</strong></td>
              <td><strong>{rank}</strong></td>
              <td class="small">{what}</td>
              <td class="small" style="color:var(--ink-3)">{ed}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="margin-top:1.3rem"><span set:html={mdp(d.run.means)} />
      {" "}<span class="chip doc">{d.run.chip}</span></Note>
  </Blk>

  <Blk label="The London Gazette" title={d.gazette.head}>
    <p class="lede">{d.gazette.lede}</p>
    <h3 style="margin-top:1.6rem">{d.gazette.controlHead}</h3>
    <Scroll>
      <table>
        <tbody>{d.gazette.control.map(([k, v]) => (
          <tr><td style="white-space:nowrap;vertical-align:top"><strong class="small">{k}</strong></td>
              <td class="small">{v}</td></tr>))}</tbody>
      </table>
    </Scroll>
    <Note style="border-left-width:3px;margin-top:1.3rem">
      {d.gazette.means} <span class="chip doc">{d.gazette.chip}</span>
    </Note>
    <h3 style="margin-top:1.8rem">{d.gazette.bonusHead}</h3>
    <Note style="margin-top:.8rem">
      <strong style="font-size:1.05em">{d.gazette.bonus}</strong>
      <span class="chip doc">{d.gazette.bonusChip}</span>
    </Note>
    <p style="margin-top:1.1rem">{d.gazette.bonusMeans}</p>
  </Blk>

  <section class="blk" style="border-bottom:0">
    <h2>{d.joseph.head}</h2>
    <p class="lede">{d.joseph.body}</p>
    <Note>
      {d.joseph.means} <span class="chip inf">{d.joseph.chip}</span>
    </Note>
    <p class="small" style="margin-top:1.4rem">
      <a href={u("/obituary/")}>How it ended →</a> ·
      <a href={u("/chatham/")}>Where he is buried →</a> ·
      <a href={u("/behind-the-paywall/")}>His marriage at Portsea →</a> ·
      <a href={u("/hornby/")}>The claim about his birth →</a></p>
  </section>
</Base>
