---
import Base from "../../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import Note from "../../components/Note.astro";
import { u } from "../../lib/url.js";
import EveryName from "@daviddef/archive-kit/components/EveryName.astro";
import d from "../../data/dossiers.json";

const people = Object.values(d.people).sort((a, b) => a.name.localeCompare(b.name));
/* One entry per NAME, keyed by a name-slug: 169 entries for 169 distinct
   names. n counts the RECORDS a name appears in, not the people who bore it,
   so the shared table is told that and does not offer a reader "held by more
   than one person" over a number that cannot support it. */
const esc = (t) => String(t ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;");
const rows = people.map((p) => ({
  slug: p.slug, name: p.name, n: p.n,
  detail: esc(p.rows[0].says.slice(0, 92) + (p.rows[0].says.length > 92 ? "\u2026" : "")),
}));
---
<Base
  title="Every Name"
  eyebrow={`${d.counts.named} named in records · ${d.counts.ownPage} of them not in this family`}
  dek="The people this archive met in documents and never had anywhere to put: witnesses, constables, surgeons, convicts, clerks and comrades. They are in the record, and leaving them out would be editing it.">

<NameLists here="who" u={u} />



  <section class="blk">
    <p class="lede">Two pages on this site already list people. <a href={u("/people/")}>The People</a>
    is the <em>family tree</em> — {`473`} of them. <a href={u("/register/")}>The register</a> is the
    raw catch, one row per source line. Neither gives a page to the man who found a body in Victoria
    Park in 1902, or to the six soldiers who gave six different answers about one death at Pozières.</p>

    <p class="dek" style="margin-top:1rem">There are <strong>{d.counts.named}</strong> people named in
    records this archive has read. <strong>{d.counts.withTreePage}</strong> of them are relatives and
    already have a dossier under <a href={u("/people/")}>The People</a>. The other
    <strong>{d.counts.ownPage}</strong> are not in this family at all — and they get a page here.</p>

    <Note>
      <strong>Why bother with people who are not relatives?</strong> Because they are the evidence.
      Sergeant Morton of the 10th Battalion is the only human being who ever said where Arthur Sneyd
      was buried. Constable Moroney is the reason we know what was in a dead man's pockets. A convict
      called John Wells is the reason we know a major of the 39th shipped his dinner service to New
      South Wales. Cut them out and you are left with assertions.
      <a href={u("/register/")}>The register →</a>
    </Note>
  </section>

  <section class="blk" style="border-bottom:0">
    <EveryName names={rows} u={u} counts="records" noun="names"
      detailLabel="What the first record says" />
    <p class="small" style="margin-top:1rem">Looking for a relative instead?
      <a href={u("/search/")}>Search the whole archive &rarr;</a></p>
  </section>


</Base>
