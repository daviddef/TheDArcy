---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import { people } from "../lib/people.js";
import ancestors from "../data/ancestors.json";
import families from "../data/families.json";
import places from "../data/places.json";

const published = people.length;
const redacted = ancestors.filter((a) => a.living).length;
const surnames = families.filter((f) => f.published > 0).length;

const more = [
  ["/hornby", "The Hornby claim", "The tree runs this line to a Yorkshire earldom. The tree also admits, in its own note, that the join is only 'thought to be' — and then contradicts itself about which earl. Set out in full."],
  ["/australia", "Arrival, 1826", "A major of the 39th Foot, his children born at Chatham in 1825 and Parramatta in 1827, and a regimental history that confirms both without ever having heard of him."],
  ["/brisbane", "Brisbane", "Four generations in one city: a boy born at Parramatta who went to the California diggings, a railway clerk found dead in his kitchen, a father dead at forty-three, and the widow who took in boarders."],
  ["/papers", "What the papers said", "An obituary from 1936 confirms five details of a eulogy delivered in 2010. Two other headlines look damning and say the opposite — the man in them is the witness, not the accused."],
  ["/how-far-back", "How far back does it really go?", "The tree reaches the kings of Denmark. This archive reaches a Gloucestershire yeoman in 1654. The difference is two grafts and about a hundred people \u2014 one unevidenced, one now disproved."],
  ["/great-war", "The Great War", "A sergeant of the Army Service Corps who married nine weeks before he sailed and came home after three and a half years \u2014 and his wife's younger brother, killed at Pozi\u00e8res at twenty-two, with no grave."],
  ["/atkinson", "The Atkinsons", "An organist christened in Limerick Cathedral who emigrated in 1862 and, two years later, installed the first organ in All Saints' Wickham Terrace \u2014 and then played it."],
  ["/families", "The families they married", "Sneyd, Atkinson, Murdoch, Atwell, Blum, Keeling, Creech, Matson, Wakefield, Wright — out of Limerick, Monaghan, Cork, Ayrshire, Somerset, Bristol and Germany."],
  ["/name", "The name", "D'Arcy was coined twice: once in Normandy as a place, once in Ireland as a colour. The apostrophe is a hint and not a proof."],
  ["/people", "The people", `Every person the archive can name and publish — ${published} of them, most of whom never continued the line.`],
  ["/places", "Places", `${places.length} places, from Hornby Castle to Boulia. Read the Australian list in order and you can watch a family spread along the Queensland railway.`],
  ["/method", "Method", "What 'documented' means here, what 'family lore' means, and the rule that keeps living people out of the build entirely."],
];
---
<Base title="The D'Arcy Archive" bare={true}>

  <section class="blk" style="padding-top:3.2rem">
    <div class="lab">A family history, kept honestly</div>
    <h1 style="font-size:clamp(36px,5.6vw,62px);line-height:1.04;margin:.6rem 0 0">
      Twelve generations, and two claims too far.</h1>
    <p class="sub dek" style="font-size:clamp(1.05rem,2vw,1.28rem);margin-top:1.1rem;max-width:64ch">
      Berkeley · Madeley · Hanley · Chatham · Parramatta · Kempsey · Boulia · Townsville · Brisbane —
      soldiers, a grocer and a church organist, and the two aristocratic descents this archive had to
      take off them.
    </p>
  </section>

  <section class="blk">
    <p class="lede">This is an archive of <strong>the D'Arcys of Brisbane</strong> — and of the
    {surnames} families they married, who reached Queensland out of Limerick, Monaghan, Cork,
    Ayrshire, Lanarkshire, Somerset, Bristol, London and Germany. It is not a pedigree. Of the
    {published} people named here, most are somebody's brother or sister and continued nothing.</p>

    <blockquote>
      <em>D'Arcy</em> was coined twice over, and the two have nothing to do with each other: in
      Normandy as <em>d'Arcy</em>, "of Arcy", the name of a place; and in Ireland as
      <em>Ó Dorchaidhe</em>, from <em>dorcha</em>, "dark", the name of a complexion.
      <strong>There is no single founding D'Arcy family.</strong> The work here is to establish which
      D'Arcys are actually connected, and to say plainly where the evidence stops.
    </blockquote>
  </section>

  <section class="blk">
    <div class="lab">The document at the centre of it</div>
    <h2 style="margin-top:.4rem">A detachment of thirty men, and a wife in the cabin</h2>
    <p class="dek" style="margin:.7rem 0 1.2rem">For as long as this family has had a pedigree, the
    interesting end of it was supposed to be the top — a castle in the North Riding, an earldom, a
    line back to the 1560s. The interesting end is actually the bottom, and it is provable.</p>

    <div class="grid two">
      <div class="card">
        <h3>What the surgeon's journal says</h3>
        <p>"On 8th April a detachment of <strong>30 men of the 39th regiment commanded by Major
        George Pitt D'Arcy</strong> embarked … Cabin passengers included <strong>Mrs. D'Arcy and
        family</strong>." The convict ship <em>England</em> reached Port Jackson on
        <strong>18 September 1826</strong>.</p>
      </div>
      <div class="card">
        <h3>What the children's births say</h3>
        <p><strong>Charlotte Maria, Chatham, 1825</strong> — the baby in the cabin.
        <strong>Catherine Maria, Parramatta, 1827. George Lindsay, Parramatta, 1829.</strong> Two
        years and half a world between the first and the second.</p>
      </div>
    </div>
    <p style="margin-top:1.2rem"><a href={u("/australia")}>How the family arrived →</a></p>
  </section>

  <section class="blk">
    <h2>Four things this archive has established</h2>
    <div class="grid two" style="margin-top:1rem">
      <div class="card">
        <h3>A defensible head to the line</h3>
        <p><strong>Major-General Robert D'Arcy, C.B.</strong> — second lieutenant of the Royal
        Engineers on <strong>17 January 1776</strong>, major-general in 1819, dead at Chatham in 1827,
        and documented at every step by the register of his own Corps. The archive will defend him and
        everyone below him. <strong>Above him it will defend nothing.</strong>
        <a href={u("/direct-line")}>The spine →</a></p>
      </div>
      <div class="card">
        <h3>Two grafts, not one</h3>
        <p>Of 243 ancestors, <strong>71</strong> hang on an unevidenced link in the D'Arcy line and
        <strong>27</strong> on a link in the Sneyd line that is now <strong>disproved from the
        parish register</strong>. Remove both and 145 remain, reaching 1654 in Gloucestershire.
        <a href={u("/how-far-back")}>How far back it really goes →</a></p>
      </div>
      <div class="card">
        <h3>A pedigree that contradicts itself</h3>
        <p>The tree says Robert was "<em>thought to be the illegitimate</em>" son of the
        <strong>4th</strong> Earl of Holderness — and then descends him from the <strong>3rd</strong>,
        through a man with two birth years sixty-nine years apart.
        <a href={u("/hornby")}>The Hornby claim →</a></p>
      </div>
      <div class="card">
        <h3>A gold medal, four years late</h3>
        <p><strong>Major George Pitt D'Arcy</strong> commanded the 39th at <strong>Orthes</strong> in
        1814 because his colonel was shot early in the action — and the medal he was given for it was
        posted to the colonel by mistake and took four years to find him.
        <a href={u("/australia")}>His war, and his ship →</a></p>
      </div>
      <div class="card">
        <h3>A surveyor who helped map Melbourne</h3>
        <p><strong>Frederick Robert D'Arcy</strong>, half-brother of the direct ancestor, was one of
        three surveyors sent to Port Phillip in 1836 to chart the bay and the Yarra. He died at Spring
        Hill and lies at Toowong. <a href={u("/australia")}>His story →</a></p>
      </div>
      <div class="card">
        <h3>A eulogy, checked against a newspaper</h3>
        <p>Clayfield, the Union Trustee Company, a sudden death — five details of the 2010 eulogy
        confirmed by an obituary printed in 1936 that nobody in the family had seen, which also
        restores a fact they had lost: he served <strong>in France</strong>.
        <a href={u("/papers")}>The papers →</a></p>
      </div>
      <div class="card">
        <h3>A voice, not just a date</h3>
        <p><strong>Ken D'Arcy's eulogy</strong>, delivered in three parts by his three children in
        March 2010, runs to four thousand words and carries the African Grey parrot, the mango tree,
        the cigarettes at nine, and Cyclone Althea. <a href={u("/brisbane")}>Brisbane →</a></p>
      </div>
    </div>
  </section>

  <section class="blk">
    <h2>Elsewhere in the archive</h2>
    <div class="grid two" style="margin-top:1rem">
      {more.map(([href, t, d]) => (
        <a class="cardlink" href={u(href)}>
          <div class="nm">{t}</div>
          <p class="small" style="margin-top:.4rem">{d}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="blk" style="border-bottom:0">
    <h2>What is still missing</h2>
    <p class="dek"><strong>Who Robert D'Arcy's parents were.</strong> Not disputed — unknown. His own
    life is now on paper from his commission to his grave, and not one of those documents names a
    father: officer rolls do not record parentage, no baptism is indexed anywhere in England, and the
    <em>Gentleman's Magazine</em> did not notice his death. Every avenue reachable from a desk has been
    tried, and the remaining ones need an archive: the Board of Ordnance records, and the will of the
    4th Earl of Holderness.</p>
    <p class="dek" style="margin-top:.9rem">Below that: whether the <strong>Atkinsons of Limerick</strong>
    and the <strong>Murdochs of St Quivox</strong> can be pushed past the emigrant generation at all,
    and what killed <strong>Lindesay Atkinson D'Arcy</strong> at forty-four.
    <a href={u("/open-questions")}>The queue, in priority order, and the nine letters drafted →</a></p>
    <p class="small" style="margin-top:1.2rem">Of the direct ancestors, <strong>{redacted}</strong> are
    living and excluded from this build entirely — not hidden, not gated, not present in the output.
    Across the whole tree the rule withholds 2,034 people. <a href={u("/method")}>The rule →</a></p>
  </section>
</Base>
