---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
/* every public asset gets a fingerprint, so a fix is never served stale */
const v = versioner();
import { u } from "../lib/url.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import ring from "@daviddef/archive-kit/data/archives.json";
const { title, description = "", dek, eyebrow, bare, noindex } = Astro.props;
const SITE = "The D'Arcy Archive";
const nav = [
  ["Start", [["/", "Home"], ["/about/", "About"], ["/trees/", "The trees"], ["/tree/", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline/", "The Timeline"], ["/dna/", "The DNA"], ["/how-far-back/", "How Far Back"], ["/the-other-archives/", "The Other Archives"]]],
  ["Our line", [["/direct-line/", "The Spine"], ["/saniger-line/", "Six Generations at Berkeley"], ["/jean-ward/", "South Leith"], ["/new-generations/", "Not in the Tree"], ["/hornby/", "The Hornby Claim"], ["/name/", "The Name"]]],
  ["The families", [["/families/", "The Families"], ["/the-women/", "The Women"], ["/sneyd/", "Sneyd"], ["/sergeant-sneyd/", "Sergeant Sneyd"], ["/murdoch/", "Murdoch"], ["/atkinson/", "Atkinson"]]],
  ["The D'Arcys", [["/robert-family/", "Robert and Jean's Family"], ["/the-corps/", "The Corps — Robert's Career"], ["/obituary/", "The Obituary, 1827"], ["/joseph-darcy/", "Joseph D'Arcy, R.A."], ["/margaret-jones/", "Daughter of the Major-General"], ["/constantine/", "Constantine, Nineteen"], ["/sussex-sisters/", "The Sussex Sisters"], ["/george-pitt/", "Miss Ludlam of Guernsey"], ["/chatham/", "Chatham — the Corps' Parish"], ["/portsea/", "Two Years of Portsea"]]],
  ["The Sanigers", [["/hannah-baptism/", "One Vowel — Hannah's Baptism"], ["/berkeley-woman/", "Hannah Was a Berkeley Woman"], ["/thomas-sinegar/", "Thomas Sinegar — Her Brother"], ["/berkeley/", "Berkeley, Gloucestershire"], ["/sanigers/", "The Sanigers of the Vale"], ["/saniger-place/", "Saniger Is a Place"], ["/swonhungre/", "The Name in Its Own Century"], ["/saniger-1608/", "The Muster of 1608"], ["/chew-magna/", "Chew Magna — a Dead Lead"]]],
  ["Bristol and the Potteries", [["/wakefields/", "The Wakefields"], ["/drivers-fields/", "Drivers Fields, 1841"], ["/bristol-chapels/", "The Bristol Chapels"], ["/sneyds/", "The Sneyds of the Potteries"]]],
  ["Australia", [["/emigrations/", "How They Got Here"], ["/general-hewitt/", "The General Hewitt, 1854"], ["/australia/", "Arrival, 1826"], ["/brisbane/", "Brisbane"], ["/great-war/", "The Great War"]]],
  ["People & places", [["/people/", "The People"], ["/bloodline/", "Blood relatives, drawn"], ["/who/", "Every Name"], ["/register/", "The Register"], ["/households/", "Households"], ["/marriages/", "The Marriages"], ["/graves/", "Graves"], ["/places/", "Places"]]],
  ["Evidence", [["/documents/", "Documents"], ["/gallery/", "Gallery"], ["/papers/", "The Papers"], ["/inquest-1902/", "The Inquest, 1902"], ["/finding-arthur/", "The Search for Arthur"], ["/coverage/", "What the Indexes Hold"], ["/behind-the-paywall/", "Behind the Paywall"], ["/errands/", "Errands"], ["/crossread/", "Reading the Archive Against Itself"], ["/sources/", "Sources"], ["/searched/", "What Has Been Read"], ["/worklist/", "The Work List"], ["/open-questions/", "Open Questions"], ["/corrections/", "Corrections"], ["/changes/", "What changed"], ["/method/", "Method"]]],
];

const here = Astro.url.pathname.replace(/\/$/, "");
const on = (h) => here === u(h).replace(/\/$/, "");
/* which of the seven this is, worked out the same way the ring does */
const thisArchive = ring.archives.find(
  (a) => a.base === (import.meta.env.BASE_URL || "/").replace(/\/$/, "")
);
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek || description} />
<SocialHead title={title} description={dek || description} site={SITE} />
<JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />
    {noindex && <meta name="robots" content="noindex" />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The D'Arcy <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")} aria-label="Search the archive">Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first archive of the D'Arcy family of Brisbane — and of Parramatta,
    Portsmouth and, if the pedigree holds, Hornby in the North Riding of Yorkshire. Every claim
    carries its confidence, or is marked as unproven. Living people are excluded from this build.</p>
    <p class="foot">One of six archives kept to this method — the others are
      <a href={u("/the-other-archives/")}>Defranceski, Falco, Lerena, Blažević and Booyzen</a>.
      This one joins them through a marriage in the present generation, which is not published
      because the people in it are alive.</p>
    <p class="foot dim">Built {new Date().getFullYear()} ·
      <a href={u("/sources/")}>Sources</a> ·
      <a href={u("/method/")}>Method</a> ·
      <a href={u("/open-questions/")}>Open questions</a> ·
      Corrections are the most valuable thing you can send</p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
<script is:inline src={u("/wholink.js") + v("wholink.js")} defer></script>
</body>
</html>
